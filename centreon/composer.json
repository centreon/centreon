{
  "name": "centreon/centreon",
  "description": "Centreon - IT and Application monitoring software",
  "version": "24.10",
  "type": "project",
  "license": "GPL-2.0-only",
  "require": {
    "php": "8.2.*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-gettext": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-ldap": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-phar": "*",
    "ext-posix": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*",
    "beberlei/assert": "3.3.*",
    "curl/curl": "2.5.*",
    "doctrine/annotations": "1.14.*",
    "doctrine/dbal": "4.2.*",
    "dragonmantank/cron-expression": "3.1.*",
    "enshrined/svg-sanitize": "0.15.*",
    "firebase/php-jwt": "6.11.*",
    "friendsofsymfony/rest-bundle": "3.7.*",
    "jms/serializer-bundle": "5.4.*",
    "justinrainbow/json-schema": "5.3.*",
    "monolog/monolog": "3.7.*",
    "nelmio/cors-bundle": "2.5.*",
    "onelogin/php-saml": "~4.3.1",
    "openpsa/quickform": "3.3.*",
    "pear/pear-core-minimal": "1.10.*",
    "phpdocumentor/reflection-docblock": "5.4.*",
    "pimple/pimple": "3.5.*",
    "psr/container": "1.1.*",
    "sensio/framework-extra-bundle": "6.2.*",
    "smarty-gettext/smarty-gettext": "1.7.*",
    "smarty/smarty": "4.5.*",
    "symfony/config": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dependency-injection": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/error-handler": "6.4.*",
    "symfony/event-dispatcher": "6.4.*",
    "symfony/event-dispatcher-contracts": "3.4.*",
    "symfony/expression-language": "6.4.*",
    "symfony/filesystem": "6.4.*",
    "symfony/finder": "6.4.*",
    "symfony/flex": "2.4.*",
    "symfony/framework-bundle": "6.4.*",
    "symfony/http-client": "6.4.*",
    "symfony/http-foundation": "6.4.*",
    "symfony/http-kernel": "6.4.*",
    "symfony/lock": "6.4.*",
    "symfony/maker-bundle": "1.61.*",
    "symfony/mime": "6.4.*",
    "symfony/monolog-bundle": "3.10.*",
    "symfony/options-resolver": "6.4.*",
    "symfony/process": "6.4.*",
    "symfony/property-access": "6.4.*",
    "symfony/property-info": "6.4.*",
    "symfony/routing": "6.4.*",
    "symfony/security-bundle": "6.4.*",
    "symfony/security-core": "6.4.*",
    "symfony/serializer": "6.4.*",
    "symfony/string": "6.4.*",
    "symfony/translation": "6.4.*",
    "symfony/uid": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/yaml": "6.4.*"
  },
  "require-dev": {
    "behat/mink-selenium2-driver": "1.6.*",
    "centreon/centreon-test-lib": "24.10.x-dev",
    "friends-of-behat/mink": "1.11.*",
    "friends-of-behat/mink-extension": "2.7.*",
    "mockery/mockery": "1.6.*",
    "pestphp/pest": "1.23.*",
    "php-vfs/php-vfs": "1.4.*",
    "robertfausk/mink-panther-driver": "1.1.*",
    "symfony/phpunit-bridge": "6.4.*",
    "symfony/stopwatch": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/var-dumper": "6.4.*",
    "symfony/web-profiler-bundle": "6.4.*",
    "twig/twig": "3.14.*",
    "webmozart/assert": "1.11.*",
    "zircote/swagger-php": "4.10.*"
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "autoload": {
    "psr-4": {
      "": "src/",
      "ConfigGenerateRemote\\": "www/class/config-generate-remote/"
    },
    "classmap": [
      "www/class/",
      "lib/Centreon"
    ],
    "files": [
      "GPL_LIB/smarty-plugins/compiler.displaysvg.php",
      "GPL_LIB/smarty-plugins/compiler.pagination.php",
      "GPL_LIB/smarty-plugins/function.eval.php",
      "GPL_LIB/smarty-plugins/SmartyBC.php",
      "www/api/exceptions.php",
      "www/api/class/webService.class.php",
      "www/lib/HTML/QuickForm/HTML_QuickFormCustom.php",
      "www/lib/HTML/QuickForm/HTML_QuickForm_checkbox_Custom.php",
      "www/lib/HTML/QuickForm/HTML_QuickForm_radio_Custom.php",
      "www/lib/HTML/QuickForm/select2.php",
      "www/lib/HTML/QuickForm/advmultiselect.php",
      "www/lib/HTML/QuickForm/tags.php",
      "www/lib/HTML/QuickForm/customcheckbox.php",
      "www/lib/HTML/QuickForm/selectoptgroup.php",
      "www/class/centreon-clapi/centreonACL.class.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Centreon\\Test\\Mock\\": "tests/php/mock/",
      "Tests\\": "tests/php/"
    }
  },
  "config": {
    "secure-http": false,
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "preferred-install": {
      "*": "dist"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": false,
      "symfony/flex": false
    }
  },
  "scripts": {
    "require:check": "../php-tools/vendor/bin/composer-require-checker check composer.json",
    "rector:diff": "php rector.diff.php --dry-run ${PHP_DIFF_FILES:-$(git diff --name-only -- '*.php')}",
    "rector:diff:fix": "php rector.diff.php ${PHP_DIFF_FILES:-$(git diff --name-only -- '*.php')}",
    "rector:legacy": "../php-tools/vendor/bin/rector process --config=rector.legacy.php --dry-run",
    "rector:legacy:fix": "../php-tools/vendor/bin/rector process --config=rector.legacy.php",
    "rector:core": "../php-tools/vendor/bin/rector process --config=rector.core.php --dry-run",
    "rector:core:fix": "../php-tools/vendor/bin/rector process --config=rector.core.php",
    "rector:new": "../php-tools/vendor/bin/rector process --config=rector.new.php --dry-run",
    "rector:new:fix": "../php-tools/vendor/bin/rector process --config=rector.new.php",
    "cs:diff": "php .php-cs-fixer.diff.php --dry-run ${PHP_DIFF_FILES:-$(git diff --name-only -- '*.php')}",
    "cs:diff:fix": "php .php-cs-fixer.diff.php ${PHP_DIFF_FILES:-$(git diff --name-only -- '*.php')}",
    "cs:legacy": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.legacy.php --verbose --dry-run --diff",
    "cs:legacy:fix": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.legacy.php --verbose --diff",
    "cs:core": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.core.php --verbose --dry-run --diff",
    "cs:core:fix": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.core.php --verbose --diff",
    "cs:new": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.new.php --verbose --dry-run --diff",
    "cs:new:fix": "../php-tools/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.new.php --verbose --diff",
    "stan:legacy:www": "../php-tools/vendor/bin/phpstan analyse -c phpstan.legacy.www.neon --memory-limit=1G",
    "stan:legacy:www:baseline": "../php-tools/vendor/bin/phpstan analyse --generate-baseline -c phpstan.legacy.www.neon --memory-limit=1G",
    "stan:legacy:src": "../php-tools/vendor/bin/phpstan analyse -c phpstan.legacy.src.neon --memory-limit=1G",
    "stan:legacy:src:baseline": "../php-tools/vendor/bin/phpstan analyse --generate-baseline -c phpstan.legacy.src.neon --memory-limit=1G",
    "stan:legacy:test": "../php-tools/vendor/bin/phpstan analyse -c phpstan.legacy.test.neon --memory-limit=1G",
    "stan:legacy": [
      "@stan:legacy:www",
      "@stan:legacy:src",
      "@stan:legacy:test"
    ],
    "stan:core:src": "../php-tools/vendor/bin/phpstan analyse -c phpstan.core.neon --memory-limit=1G",
    "stan:core:baseline": "../php-tools/vendor/bin/phpstan analyse --generate-baseline -c phpstan.core.neon --memory-limit=1G",
    "stan:core:test": "../php-tools/vendor/bin/phpstan analyse -c phpstan.core.test.neon --memory-limit=1G",
    "stan:core:test:baseline": "../php-tools/vendor/bin/phpstan analyse --generate-baseline -c phpstan.core.test.neon --memory-limit=1G",
    "stan:core": [
      "@stan:core:src",
      "@stan:core:test"
    ],
    "stan:new:src": "../php-tools/vendor/bin/phpstan analyse -c phpstan.new.neon --memory-limit=1G",
    "stan:new:test": "../php-tools/vendor/bin/phpstan analyse -c phpstan.new.test.neon --memory-limit=1G",
    "stan:new": [
      "@stan:new:src",
      "@stan:new:test"
    ],
    "dep:new": [
      "../php-tools/vendor/bin/deptrac analyze --config-file deptrac_bc.yaml --cache-file .deptrac_bc.cache --fail-on-uncovered --report-uncovered",
      "../php-tools/vendor/bin/deptrac analyze --config-file deptrac_hexa.yaml --cache-file .deptrac_hexa.cache --fail-on-uncovered --report-uncovered"
    ],
    "test": "pest --do-not-cache-result",
    "test:ci": "@test --log-junit ./build/phpunit.xml --coverage-clover ./build/coverage-be.xml",
    "rector": [
      "@rector:legacy",
      "@rector:core",
      "@rector:new"
    ],
    "rector:fix": [
      "@rector:legacy:fix",
      "@rector:core:fix",
      "@rector:new:fix"
    ],
    "cs": [
      "@cs:legacy",
      "@cs:core",
      "@cs:new"
    ],
    "cs:fix": [
      "@cs:legacy:fix",
      "@cs:core:fix",
      "@cs:new:fix"
    ],
    "stan": [
      "@stan:legacy",
      "@stan:core",
      "@stan:new"
    ],
    "legacy:check": [
      "@rector:legacy",
      "@cs:legacy",
      "@stan:legacy"
    ],
    "core:check": [
      "@rector:core",
      "@cs:core",
      "@stan:core"
    ],
    "new:check": [
      "@rector:new",
      "@cs:new",
      "@stan:new"
    ],
    "ci": [
      "@symfony:check",
      "@legacy:check",
      "@core:check",
      "@new:check",
      "@test:new",
      "@test"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "6.4.*"
    }
  }
}
