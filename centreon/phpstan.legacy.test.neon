includes:
    - ../php-tools/phpstan/config/common.neon

parameters:

    level: 2

    bootstrapFiles:
        - config/centreon.config.php.template

    scanFiles:
        - config/centreon.config.php.template
        - www/install/functions.php
        - tests/phpstan_stubs/bootstrap.stub
        - tests/phpstan_stubs/legacy.stub
        - tests/php/bootstrap.php
        - tests/php/polyfill.php
        # www/include is outside the Composer classmap, so the class under test in
        # tests/php/www/include has to be declared to the analyser explicitly.
        - www/include/common/listing/AjaxListingHelper.php

    paths:
        - tests/php/Centreon
        - tests/php/CentreonLegacy
        - tests/php/CentreonRemote
        - tests/php/mock
        - tests/php/Security
        - tests/php/Utility
        - tests/php/www

    ignoreErrors:

        - # To ignore errors in the tests/php directory because of Pest
            reportUnmatched: false
            path: tests/php
            messages:
                - '#^Undefined variable: \$this$#'
                - '#^Call to an undefined method Pest#'
                - '#^Access to an undefined property PHPUnit#'
                - '#^Call to protected method .+\(\) of class PHPUnit\\Framework\\TestCase\.$#'
                - '#^Access to private property PHPUnit\\Framework\\TestCase::\$\w+\.$#'
                - '#^Call to an undefined method PHPUnit\\Framework\\TestCase::\w+\(\)\.$#'
                - '#^Method PHPUnit\\Framework\\TestCase::\w+\(\) invoked with \d+ parameters?, \d+ required\.$#'

