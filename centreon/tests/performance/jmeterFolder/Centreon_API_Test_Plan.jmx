            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput

// Vérifie que CURRENT_ID existe
def idStr = vars.get(&quot;CURRENT_ID&quot;)
if (idStr == null || idStr.isEmpty()) {
    log.error(&quot;CURRENT_ID est null ou vide !&quot;)
    return
}

// Récupère le nom correspondant via l’index du ForEach
def index = vars.get(&quot;user_id_index&quot;)?.toInteger() ?: 1
def name = vars.get(&quot;user_name_${index}&quot;) ?: &quot;UNKNOWN_USER&quot;
vars.put(&quot;CURRENT_NAME&quot;, name)

// Prépare le body DELETE pour cet utilisateur
def body = [[ &quot;id&quot;: idStr.toInteger() ]]
vars.put(&quot;DELETE_BODY&quot;, JsonOutput.toJson(body))

log.info(&quot;Utilisateur à supprimer: ${name} - Body: ${vars.get(&quot;DELETE_BODY&quot;)}&quot;)</stringProp>
            </JSR223PreProcessor>
