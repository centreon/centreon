          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Adding BA ids into an array">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

// Nombre d&apos;IDs trouvés
def countStr = vars.get(&quot;user_id_matchNr&quot;)  // &lt;- ici, user_id_matchNr
if (countStr == null || countStr == &quot;0&quot;) {
    log.warn(&quot;Aucun ID trouvé, rien à supprimer&quot;)
    return
}

def count = countStr.toInteger()

// Crée un tableau [{&quot;id&quot;:43},{&quot;id&quot;:42}] de façon sûre
def bodyArray = []

for (int i = 1; i &lt;= count; i++) {
    def idStr = vars.get(&quot;user_id_${i}&quot;)  // &lt;- user_id_1, user_id_2...
    if (idStr != null &amp;&amp; !idStr.isEmpty()) {
        try {
            bodyArray &lt;&lt; [ &quot;id&quot;: idStr.toInteger() ]
        } catch (Exception e) {
            log.error(&quot;Impossible de convertir user_id_${i}=&apos;$idStr&apos; en entier&quot;, e)
        }
    } else {
        log.warn(&quot;user_id_${i} est null ou vide&quot;)
    }
}

// Transforme en JSON
def jsonBody = JsonOutput.toJson(bodyArray)

// Stocke dans une variable JMeter
vars.put(&quot;DELETE_BODY&quot;, jsonBody)

log.info(&quot;Body pour DELETE: ${jsonBody}&quot;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
