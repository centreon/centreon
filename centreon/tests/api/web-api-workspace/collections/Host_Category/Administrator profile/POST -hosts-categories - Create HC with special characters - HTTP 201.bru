meta {
  name: POST /hosts/categories - Create HC with special characters - HTTP 201
  type: http
  seq: 12
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostCategory3Name}}",
    "alias": "{{HostCategory3Alias}}",
    "comment": "   "
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host category has been successfully created, with name '{{HostCategory3Name}}' and alias '{{HostCategory3Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostCategory3Id", body.id);
    expect(body).to.eql({
      "id": body.id,
      "name": bru.getEnvVar("HostCategory3Name"),
      "alias": bru.getEnvVar("HostCategory3Alias"),
      "is_activated": true,
      "comment": ""
    });
  });

  test("The Location parameter is in the header.", function () {
    expect(res.getHeaders()).to.have.property("location");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
