meta {
  name: GET /hosts/categories - Get 1 host category - HTTP 200
  type: http
  seq: 5
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The host categories are listed with all of their parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const hc1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostCategory1Id")));
    expect(hc1).to.eql({
      "id": parseInt(bru.getEnvVar("HostCategory1Id")),
      "name": bru.getEnvVar("HostCategory1Name"),
      "alias": bru.getEnvVar("HostCategory1Alias"),
      "is_activated": false,
      "comment": "Created by Admin"
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
