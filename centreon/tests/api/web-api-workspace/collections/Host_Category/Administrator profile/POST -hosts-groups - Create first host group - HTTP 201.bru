meta {
  name: POST /hosts/groups - Create first host group - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup1Name}}",
    "alias": "{{HostGroup1Alias}}",
    "hosts": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host group has been successfully created, with name '{{HostGroup1Name}}' and alias '{{HostGroup1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostGroup1Id", body.id);
    expect(body).to.have.property("id").that.is.a("number");
    expect(body).to.have.property("name").that.equals(bru.getEnvVar("HostGroup1Name"));
    expect(body).to.have.property("alias").that.equals(bru.getEnvVar("HostGroup1Alias"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
