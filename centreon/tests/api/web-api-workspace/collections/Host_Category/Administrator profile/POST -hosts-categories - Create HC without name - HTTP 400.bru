meta {
  name: POST /hosts/categories - Create HC without name - HTTP 400
  type: http
  seq: 8
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: json
  auth: inherit
}

body:json {
  {
    "alias": "Oh I'm your third category!",
    "comment": "Hello, I should not work!"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The host category has not been created, because the name is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[name] The property name is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
