meta {
  name: POST /hosts/categories - Create HC with wrong type value - HTTP 400
  type: http
  seq: 11
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": true,
    "alias": null,
    "is_activated": "true",
    "comment": 3
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The host category has not been created, because there are values of the wrong type.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[name] Boolean value found, but a string is required\n[alias] NULL value found, but a string is required\n[is_activated] String value found, but a boolean is required\n[comment] Integer value found, but a string or a null is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
