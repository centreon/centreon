meta {
  name: DELETE /hosts/categories - Delete HC forbidden - HTTP 403
  type: http
  seq: 3
}

delete {
  url: {{baseUrlWeb}}/configuration/hosts/categories/{{HostCategory4Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to delete host categories.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
