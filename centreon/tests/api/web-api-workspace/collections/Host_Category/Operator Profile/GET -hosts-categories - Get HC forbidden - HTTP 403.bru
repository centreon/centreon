meta {
  name: GET /hosts/categories - Get HC forbidden - HTTP 403
  type: http
  seq: 6
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to list host categories.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
