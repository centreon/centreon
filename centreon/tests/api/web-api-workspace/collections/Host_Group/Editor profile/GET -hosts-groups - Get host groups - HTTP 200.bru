meta {
  name: GET /hosts/groups - Get host groups - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The host groups are listed and HG5 created by editor is present.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const hg5 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup5Id")));
    expect(hg5).to.eql({
      "id": parseInt(bru.getEnvVar("HostGroup5Id")),
      "name": bru.getEnvVar("HostGroup5Name"),
      "alias": bru.getEnvVar("HostGroup5Alias"),
      "icon": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true,
      "enabled_hosts_count": 0,
      "disabled_hosts_count": 0
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
