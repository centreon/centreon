meta {
  name: GET /hosts/groups - Get HGs filtered by HC1 - HTTP 200
  type: http
  seq: 19
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups?search={"hostcategory.id":{{HostCategory1Id}}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Host groups filtered by HC1 are retrieved with all their parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const hg1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup1Id")));
    expect(hg1).to.deep.include({
      "id": parseInt(bru.getEnvVar("HostGroup1Id")),
      "name": bru.getEnvVar("HostGroup1Name"),
      "alias": bru.getEnvVar("HostGroup1Alias"),
      "icon_id": null,
      "geo_coords": null,
      "comment": "Hello world! 1",
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
