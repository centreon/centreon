meta {
  name: POST /hosts/groups - Create HG with mandatory properties - HTTP 201
  type: http
  seq: 7
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup2Name}}",
    "hosts": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host group has been successfully created with mandatory properties only, with name '{{HostGroup2Name}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostGroup2Id", body.id);
    expect(body).to.eql({
      "id": body.id,
      "name": bru.getEnvVar("HostGroup2Name"),
      "alias": null,
      "icon_id": null,
      "geo_coords": null,
      "comment": null,
      "hosts": []
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
