meta {
  name: POST /hosts/groups - Create HG with special chars - HTTP 201
  type: http
  seq: 12
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup4Name}}",
    "alias": "{{HostGroup4Alias}}",
    "hosts": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host group has been successfully created with special characters, with name '{{HostGroup4Name}}' and alias '{{HostGroup4Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostGroup4Id", body.id);
    expect(body).to.eql({
      "id": body.id,
      "name": bru.getEnvVar("HostGroup4Name"),
      "alias": bru.getEnvVar("HostGroup4Alias"),
      "icon_id": null,
      "geo_coords": null,
      "comment": null,
      "hosts": []
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
