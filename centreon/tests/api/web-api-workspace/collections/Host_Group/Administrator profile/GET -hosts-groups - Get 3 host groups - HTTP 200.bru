meta {
  name: GET /hosts/groups - Get 3 host groups - HTTP 200
  type: http
  seq: 23
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The host groups are listed with all of their parameters, HG1 is absent.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const hg1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup1Id")));
    const hg2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup2Id")));
    const hg3 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup3Id")));
    const hg4 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup4Id")));

    expect(hg1).to.be.undefined;
    expect(hg2).to.deep.include({
      "id": parseInt(bru.getEnvVar("HostGroup2Id")),
      "name": bru.getEnvVar("HostGroup2Name"),
      "alias": null,
      "icon_id": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true
    });
    expect(hg3).to.deep.include({
      "id": parseInt(bru.getEnvVar("HostGroup3Id")),
      "name": bru.getEnvVar("HostGroup3Name"),
      "alias": bru.getEnvVar("HostGroup3Alias"),
      "icon_id": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true
    });
    expect(hg4).to.deep.include({
      "id": parseInt(bru.getEnvVar("HostGroup4Id")),
      "name": bru.getEnvVar("HostGroup4Name"),
      "alias": bru.getEnvVar("HostGroup4Alias"),
      "icon_id": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
