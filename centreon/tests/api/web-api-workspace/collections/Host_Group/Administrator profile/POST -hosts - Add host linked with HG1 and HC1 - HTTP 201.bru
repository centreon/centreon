meta {
  name: POST /hosts - Add host linked with HG1 and HC1 - HTTP 201
  type: http
  seq: 16
}

post {
  url: {{baseUrlWeb}}/configuration/hosts
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Host1Name}}",
    "alias": "{{Host1Alias}}",
    "address": "127.0.0.1",
    "monitoring_server_id": 1,
    "categories": [ {{HostCategory1Id}}
    ],
    "groups": [ {{HostGroup1Id}}
    ]
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host has been successfully created, with name '{{Host1Name}}' and alias '{{Host1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("Host1Id", body.id);
    expect(body).to.be.an("object");
    expect(body).to.have.property("id").that.is.a("number");
    expect(body).to.have.property("name").that.equals(bru.getEnvVar("Host1Name"));
    expect(body).to.have.property("alias").that.equals(bru.getEnvVar("Host1Alias"));
    expect(body).to.have.property("address").that.equals("127.0.0.1");
    expect(body).to.have.property("monitoring_server_id").that.equals(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
