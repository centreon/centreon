meta {
  name: GET /hosts/groups - Get 2 host groups - HTTP 200
  type: http
  seq: 8
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The host groups are listed with all of their parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result.length).to.be.at.least(2);

    const hg1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup1Id")));
    const hg2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("HostGroup2Id")));

    expect(hg1).to.eql({
      "id": parseInt(bru.getEnvVar("HostGroup1Id")),
      "name": bru.getEnvVar("HostGroup1Name"),
      "alias": bru.getEnvVar("HostGroup1Alias"),
      "icon": null,
      "geo_coords": null,
      "comment": "Hello world! 1",
      "is_activated": true,
      "enabled_hosts_count": 0,
      "disabled_hosts_count": 0
    });
    expect(hg2).to.eql({
      "id": parseInt(bru.getEnvVar("HostGroup2Id")),
      "name": bru.getEnvVar("HostGroup2Name"),
      "alias": null,
      "icon": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true,
      "enabled_hosts_count": 0,
      "disabled_hosts_count": 0
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
