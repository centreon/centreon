meta {
  name: GET /hosts/groups - Get one host group by id - HTTP 200
  type: http
  seq: 15
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup3Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The host group retrieved is listed with all of its parameters.", function () {
    const body = res.getBody();
    expect(body).to.eql({
      "id": parseInt(bru.getEnvVar("HostGroup3Id")),
      "name": bru.getEnvVar("HostGroup3Name"),
      "alias": null,
      "icon": null,
      "geo_coords": null,
      "comment": null,
      "is_activated": true,
      "hosts": []
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
