meta {
  name: POST /hosts/categories - Create 1st host category - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostCategory1Name}}",
    "alias": "{{HostCategory1Alias}}",
    "is_activated": true
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host category has been successfully created, with name '{{HostCategory1Name}}' and alias '{{HostCategory1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostCategory1Id", body.id);
    expect(body).to.be.an("object");
    expect(body).to.have.property("id").that.is.a("number");
    expect(body).to.have.property("name").that.equals(bru.getEnvVar("HostCategory1Name"));
    expect(body).to.have.property("alias").that.equals(bru.getEnvVar("HostCategory1Alias"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
