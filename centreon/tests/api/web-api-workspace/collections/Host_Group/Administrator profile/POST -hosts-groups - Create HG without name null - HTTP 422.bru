meta {
  name: POST /hosts/groups - Create HG without name null - HTTP 422
  type: http
  seq: 9
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "alias": "No name here!",
    "hosts": []
  }
}

assert {
  res.status: eq 422
}

tests {
  test("The host group has not been created, because the name is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.contains("This value should not be null");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
