meta {
  name: DELETE /hosts/groups - Delete host group - HTTP 204
  type: http
  seq: 21
}

delete {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup1Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
  test("The host group '{{HostGroup1Name}}' has been successfully deleted.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
