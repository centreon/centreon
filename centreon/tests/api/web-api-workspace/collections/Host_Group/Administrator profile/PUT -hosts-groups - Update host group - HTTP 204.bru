meta {
  name: PUT /hosts/groups - Update host group - HTTP 204
  type: http
  seq: 22
}

put {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup3Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup3Name}}",
    "alias": "{{HostGroup3Alias}}",
    "hosts": []
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The host group has been successfully updated, with name '{{HostGroup3Name}}' and alias '{{HostGroup3Alias}}'.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
