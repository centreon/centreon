meta {
  name: GET /hosts/groups - Get one host group forbidden - HTTP 403
  type: http
  seq: 5
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup2Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to access host group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
