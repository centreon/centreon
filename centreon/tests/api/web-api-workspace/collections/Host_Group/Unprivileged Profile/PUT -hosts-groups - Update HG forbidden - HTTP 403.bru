meta {
  name: PUT /hosts/groups - Update HG forbidden - HTTP 403
  type: http
  seq: 5
}

put {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup2Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "forbidden_update",
    "hosts": []
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to update host group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
