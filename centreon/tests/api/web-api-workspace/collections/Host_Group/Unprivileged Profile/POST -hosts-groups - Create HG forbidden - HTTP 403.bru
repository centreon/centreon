meta {
  name: POST /hosts/groups - Create HG forbidden - HTTP 403
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "forbidden_hg",
    "hosts": []
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to create host group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
