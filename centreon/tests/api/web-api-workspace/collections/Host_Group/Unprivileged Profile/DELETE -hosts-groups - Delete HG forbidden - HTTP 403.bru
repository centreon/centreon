meta {
  name: DELETE /hosts/groups - Delete HG forbidden - HTTP 403
  type: http
  seq: 6
}

delete {
  url: {{baseUrlWeb}}/configuration/hosts/groups/{{HostGroup2Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to delete host group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
