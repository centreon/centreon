meta {
  name: PATCH /hosts/templates - Update host template - HTTP 204
  type: http
  seq: 7
}

patch {
  url: {{baseUrlWeb}}/configuration/hosts/templates/{{HostTemplate1Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "timezone_id": 3,
    "categories": [ {{HostCategory2Id}} ]
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The host template '{{HostTemplate1Name}}' has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
