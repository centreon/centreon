meta {
  name: DELETE /hosts/templates - Delete HT forbidden - HTTP 403
  type: http
  seq: 3
}

delete {
  url: {{baseUrlWeb}}/configuration/hosts/templates/{{HostTemplate1Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to delete host template.", function () {
    expect(res.getBody().message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
