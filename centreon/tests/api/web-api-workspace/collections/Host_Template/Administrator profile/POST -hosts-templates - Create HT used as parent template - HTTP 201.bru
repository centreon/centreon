meta {
  name: POST /hosts/templates - Create HT used as parent template - HTTP 201
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostTemplate0Name}}",
    "alias": "{{HostTemplate0Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host template has been successfully created, with name '{{HostTemplate0Name}}' and alias '{{HostTemplate0Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostTemplate0Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("HostTemplate0Name"),
      "alias": bru.getEnvVar("HostTemplate0Alias"),
      "snmp_version": null,
      "timezone_id": null,
      "severity_id": null,
      "check_timeperiod_id": null,
      "note_url": null,
      "note": null,
      "action_url": null,
      "max_check_attempts": null,
      "normal_check_interval": null,
      "retry_check_interval": null,
      "icon_id": null,
      "is_locked": false
    });
    expect(body.categories).to.be.an("array").that.is.empty;
    expect(body.templates).to.be.an("array").that.is.empty;
    expect(body.macros).to.be.an("array").that.is.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
