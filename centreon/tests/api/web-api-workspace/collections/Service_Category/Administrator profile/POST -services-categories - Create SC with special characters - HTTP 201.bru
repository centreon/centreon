meta {
  name: POST /services/categories - Create SC with special characters - HTTP 201
  type: http
  seq: 6
}

post {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory3Name}}",
    "alias": "{{ServiceCategory3Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service category has been successfully created, with name '{{ServiceCategory3Name}}' and alias '{{ServiceCategory3Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceCategory3Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceCategory3Name"),
      "alias": bru.getEnvVar("ServiceCategory3Alias"),
      "is_activated": true
    });
  });

  test("The Location parameter is in the header.", function () {
    expect(res.getHeaders()).to.have.property("location");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
