meta {
  name: POST /services/categories - Create SC with mandatory properties - HTTP 201
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory2Name}}",
    "alias": "{{ServiceCategory2Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service category has been successfully created, with name '{{ServiceCategory2Name}}' and alias '{{ServiceCategory2Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceCategory2Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceCategory2Name"),
      "alias": bru.getEnvVar("ServiceCategory2Alias"),
      "is_activated": true
    });
  });

  test("The Location parameter is in the header.", function () {
    expect(res.getHeaders()).to.have.property("location");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
