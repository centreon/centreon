meta {
  name: PUT /services/categories - Update service category - HTTP 204
  type: http
  seq: 13
}

put {
  url: {{baseUrlWeb}}/configuration/services/categories/{{ServiceCategory3Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory3Name}}",
    "alias": "{{ServiceCategory3Alias}}",
    "is_activated": false
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The service category has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
