meta {
  name: DELETE /services/categories - Delete service category - HTTP 204
  type: http
  seq: 14
}

delete {
  url: {{baseUrlWeb}}/configuration/services/categories/{{ServiceCategory1Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
  test("The service category '{{ServiceCategory1Name}}' has been successfully deleted.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
