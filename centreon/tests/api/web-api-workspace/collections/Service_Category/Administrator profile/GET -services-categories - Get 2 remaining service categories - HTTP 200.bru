meta {
  name: GET /services/categories - Get 2 remaining service categories - HTTP 200
  type: http
  seq: 15
}

get {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Two service categories remain after deletion.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const deletedId = parseInt(bru.getEnvVar("ServiceCategory1Id"));
    expect(body.result.some(r => r.id === deletedId)).to.be.false;

    const sc2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceCategory2Id")));
    const sc3 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceCategory3Id")));
    expect(sc2).to.not.be.undefined;
    expect(sc3).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
