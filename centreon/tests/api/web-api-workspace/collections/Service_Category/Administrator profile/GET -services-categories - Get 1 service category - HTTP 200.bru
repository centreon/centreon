meta {
  name: GET /services/categories - Get 1 service category - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The service categories are listed with all of their parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const sc1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceCategory1Id")));
    expect(sc1).to.include({
      "id": parseInt(bru.getEnvVar("ServiceCategory1Id")),
      "name": bru.getEnvVar("ServiceCategory1Name"),
      "alias": bru.getEnvVar("ServiceCategory1Alias"),
      "is_activated": false
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
