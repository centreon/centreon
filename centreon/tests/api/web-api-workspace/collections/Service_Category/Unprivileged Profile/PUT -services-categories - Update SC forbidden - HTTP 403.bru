meta {
  name: PUT /services/categories - Update SC forbidden - HTTP 403
  type: http
  seq: 4
}

put {
  url: {{baseUrlWeb}}/configuration/services/categories/{{ServiceCategory2Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory2Name}}",
    "alias": "{{ServiceCategory2Alias}}"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to update a service category.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
