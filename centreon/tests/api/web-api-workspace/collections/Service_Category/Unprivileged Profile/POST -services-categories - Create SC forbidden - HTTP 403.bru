meta {
  name: POST /services/categories - Create SC forbidden - HTTP 403
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "sc-forbidden",
    "alias": "I should not be created"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to create a service category.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
