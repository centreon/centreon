meta {
  name: GET /services/categories - Get SC forbidden - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to list service categories.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
