meta {
  name: GET /web-sso - Get WebSSO configuration - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/administration/authentication/providers/web-sso
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Response schema is valid", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("is_active");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
