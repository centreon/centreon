meta {
  name: GET /web-sso - Get WebSSO configuration forbidden - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/administration/authentication/providers/web-sso
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Editor cannot read the WebSSO provider configuration.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
