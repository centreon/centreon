meta {
  name: GET /agent-configurations - List AC forbidden - HTTP 403
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: none
  auth: inherit
}

tests {
  test("GET /agent-configurations - List AC forbidden - HTTP 403 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([403, 404]);
  });

  if (res.status === 403) {
    test("Operator cannot list agent configurations.", function () {
      expect(res.status).to.equal(403);
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
