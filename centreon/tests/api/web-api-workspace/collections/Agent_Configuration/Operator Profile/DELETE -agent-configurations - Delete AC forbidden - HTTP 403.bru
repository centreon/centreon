tests {
  test("DELETE /agent-configurations - Delete AC forbidden - HTTP 403 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([403, 404]);
  });

  if (res.status === 403) {
    test("Operator cannot delete an agent configuration.", function () {
      expect(res.status).to.equal(403);
    });

  }
}

