meta {
  name: POST /agent-configurations - Create AC forbidden - HTTP 403
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "agent-configuration-operator",
    "type": "telegraf",
    "connection_mode": "secure",
    "poller_ids": [1],
    "configuration": {
      "otel_public_certificate": "my-otel-certificate-name.crt",
      "otel_ca_certificate": null,
      "otel_private_key": "my-otel-private-key-name.key",
      "conf_server_port": 1443,
      "conf_certificate": "my-certificate-name.crt",
      "conf_private_key": "my-private-key-name.key"
    }
  }
}

tests {
  test("POST /agent-configurations - Create AC forbidden - HTTP 403 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([403, 404]);
  });

  if (res.status === 403) {
    test("Operator cannot create an agent configuration.", function () {
      expect(res.status).to.equal(403);
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
