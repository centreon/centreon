meta {
  name: PUT /agent-configurations - Add Poller3 to AC1 - HTTP 204
  type: http
  seq: 14
}

put {
  url: {{baseUrlWeb}}/configuration/agent-configurations/{{AC1Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{AC1Name}}",
    "connection_mode": "secure",
    "poller_ids": [{{Poller1Id}}, {{Poller3Id}}],
    "configuration": {
      "otel_public_certificate": "my-otel-certificate-name.crt",
      "otel_ca_certificate": null,
      "otel_private_key": "my-otel-private-key-name.key",
      "conf_server_port": 1443,
      "conf_certificate": "my-certificate-name.crt",
      "conf_private_key": "my-private-key-name.key"
    }
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Poller-3 added to AC1 successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
