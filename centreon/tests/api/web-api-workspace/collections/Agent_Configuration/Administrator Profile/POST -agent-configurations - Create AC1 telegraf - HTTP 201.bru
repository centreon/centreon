meta {
  name: POST /agent-configurations - Create AC1 telegraf - HTTP 201
  type: http
  seq: 11
}

post {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{AC1Name}}",
    "type": "telegraf",
    "connection_mode": "secure",
    "poller_ids": [{{Poller1Id}}],
    "configuration": {
      "otel_public_certificate": "my-otel-certificate-name.crt",
      "otel_ca_certificate": null,
      "otel_private_key": "my-otel-private-key-name.key",
      "conf_server_port": 1443,
      "conf_certificate": "my-certificate-name.crt",
      "conf_private_key": "my-private-key-name.key"
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("AC1 telegraf created. ID stored.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
    bru.setVar("AC1Id", body.id);

    expect(body.name).to.equal(bru.getEnvVar("AC1Name"));
    expect(body.type).to.equal("telegraf");
    expect(body.connection_mode).to.equal("secure");
    expect(body.pollers).to.be.an("array").with.lengthOf(1);
    expect(body.pollers[0].name).to.equal("Poller-1");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
