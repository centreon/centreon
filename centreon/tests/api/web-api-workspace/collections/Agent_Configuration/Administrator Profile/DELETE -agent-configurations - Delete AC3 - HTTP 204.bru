meta {
  name: DELETE /agent-configurations - Delete AC3 - HTTP 204
  type: http
  seq: 30
}

delete {
  url: {{baseUrlWeb}}/configuration/agent-configurations/{{AC3Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
  test("AC3 (centreon-agent with special characters) deleted successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
