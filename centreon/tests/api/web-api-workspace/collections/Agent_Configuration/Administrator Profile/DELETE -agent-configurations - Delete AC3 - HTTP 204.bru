meta {
  name: DELETE /agent-configurations - Delete AC3 - HTTP 204
  type: http
  seq: 30
  tags: [
    ignore
  ]
}

delete {
  url: {{baseUrlWeb}}/configuration/agent-configurations/{{AC3Id}}
  body: none
  auth: inherit
}

tests {
  test("DELETE /agent-configurations - Delete AC3 - HTTP 204 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([204, 404]);
  });

  if (res.status === 204) {
    test("AC3 (centreon-agent with special characters) deleted successfully.", function () {
      const body = res.getBody();
      expect(body).to.be.an("object");
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
