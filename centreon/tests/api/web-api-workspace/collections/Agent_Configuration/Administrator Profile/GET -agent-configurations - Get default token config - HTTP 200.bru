meta {
  name: GET /agent-configurations - Get default token config - HTTP 200
  type: http
  seq: 28
  tags: [
    ignore
  ]
}

get {
  url: {{baseUrlWeb}}/configuration/agent-configurations/1
  body: none
  auth: inherit
}

tests {
  test("GET /agent-configurations - Get default token config - HTTP 200 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  if (res.status === 200) {
    test("Default agent configuration (ID=1) exists and has a token. Token name stored.", function () {
      const body = res.getBody();
      expect(body).to.be.an("object");
      expect(body).to.have.property("configuration");
      expect(body.configuration).to.have.property("tokens").that.is.an("array");
      expect(body.configuration.tokens.length).to.be.greaterThan(0);

      const tokenName = body.configuration.tokens[0].name.trim();
      expect(tokenName.length).to.be.greaterThan(0);
      bru.setVar("DefaultTokenName", tokenName);
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
