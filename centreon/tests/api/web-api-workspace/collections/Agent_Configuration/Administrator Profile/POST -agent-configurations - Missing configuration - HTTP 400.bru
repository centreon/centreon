meta {
  name: POST /agent-configurations - Missing configuration - HTTP 400
  type: http
  seq: 26
}

post {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "agent-configuration-missing-property",
    "connection_mode": "secure",
    "type": "telegraf",
    "poller_ids": [{{Poller2Id}}]
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Missing required field 'configuration' is rejected.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
