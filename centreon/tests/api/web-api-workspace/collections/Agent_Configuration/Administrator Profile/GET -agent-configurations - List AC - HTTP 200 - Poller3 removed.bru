meta {
  name: GET /agent-configurations - List AC - HTTP 200 - Poller3 removed
  type: http
  seq: 21
  tags: [
    ignore
  ]
}

get {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: none
  auth: inherit
}

tests {
  test("GET /agent-configurations - List AC - HTTP 200 - Poller3 removed (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  if (res.status === 200) {
    test("AC1 no longer contains Poller-3.", function () {
      const body = res.getBody();
      expect(body).to.have.property("result").that.is.an("array");

      const ac1 = body.result.find(function (ac) { return ac.id === bru.getVar("AC1Id"); });
      expect(ac1, "AC1 should still exist").to.exist;

      const pollerNames = ac1.pollers.map(function (p) { return p.name; });
      expect(pollerNames).to.not.include("Poller-3");
      expect(pollerNames).to.include("Poller-1");
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
