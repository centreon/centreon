meta {
  name: PUT /agent-configurations - Wrong config for agent type - HTTP 400
  type: http
  seq: 19
  tags: [
    ignore
  ]
}

put {
  url: {{baseUrlWeb}}/configuration/agent-configurations/{{AC2Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{AC2Name}}",
    "connection_mode": "secure",
    "poller_ids": [{{Poller4Id}}],
    "configuration": {
      "create_host_auto": false,
      "port": 4317,
      "hosts": [],
      "agent_initiated": true,
      "otel_private_key": null,
      "poller_initiated": false,
      "otel_ca_certificate": null,
      "otel_public_certificate": null,
      "tokens": [
        {
          "name": "test-update-telegraph-to-agent",
          "creator_id": 1
        }
      ]
    }
  }
}

tests {
  test("PUT /agent-configurations - Wrong config for agent type - HTTP 400 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([400, 404]);
  });

  if (res.status === 400) {
    test("Sending centreon-agent configuration fields for a telegraf AC is rejected.", function () {
      const body = res.getBody();
      expect(body).to.have.property("code").that.equals(400);
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
