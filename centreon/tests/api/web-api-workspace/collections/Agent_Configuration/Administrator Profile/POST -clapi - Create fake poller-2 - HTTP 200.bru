meta {
  name: POST /clapi - Create fake poller-2 - HTTP 200
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/api/index.php?action=action&object=centreon_clapi
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "add",
    "object": "INSTANCE",
    "values": "Poller-2;10.30.2.66;22;ZMQ;5556"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Fake poller Poller-2 created successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
