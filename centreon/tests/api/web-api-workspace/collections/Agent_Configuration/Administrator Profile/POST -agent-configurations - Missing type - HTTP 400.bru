meta {
  name: POST /agent-configurations - Missing type - HTTP 400
  type: http
  seq: 24
  tags: [
    ignore
  ]
}

post {
  url: {{baseUrlWeb}}/configuration/agent-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "agent-configuration-missing-property",
    "connection_mode": "secure",
    "poller_ids": [{{Poller2Id}}],
    "configuration": {
      "otel_public_certificate": "my-otel-certificate-name.crt",
      "otel_ca_certificate": null,
      "otel_private_key": "my-otel-private-key-name.key",
      "conf_server_port": 1443,
      "conf_certificate": "my-certificate-name.crt",
      "conf_private_key": "my-private-key-name.key"
    }
  }
}

tests {
  test("POST /agent-configurations - Missing type - HTTP 400 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([400, 404]);
  });

  if (res.status === 400) {
    test("Missing required field 'type' is rejected.", function () {
      const body = res.getBody();
      expect(body).to.have.property("code").that.equals(400);
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
