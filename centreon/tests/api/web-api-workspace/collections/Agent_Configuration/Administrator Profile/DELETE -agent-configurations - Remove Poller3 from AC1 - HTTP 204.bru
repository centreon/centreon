meta {
  name: DELETE /agent-configurations - Remove Poller3 from AC1 - HTTP 204
  type: http
  seq: 20
  tags: [
    ignore
  ]
}

delete {
  url: {{baseUrlWeb}}/configuration/agent-configurations/{{AC1Id}}/pollers/{{Poller3Id}}
  body: none
  auth: inherit
}

tests {
  test("DELETE /agent-configurations - Remove Poller3 from AC1 - HTTP 204 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([204, 404]);
  });

  if (res.status === 204) {
    test("Poller-3 removed from AC1 without deleting the configuration.", function () {
      const body = res.getBody();
      expect(body).to.be.an("object");
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
