meta {
  name: POST /clapi - Create engine conf for poller-4 - HTTP 200
  type: http
  seq: 9
  tags: [
    ignore
  ]
}

post {
  url: {{baseUrlWeb}}/api/index.php?action=action&object=centreon_clapi
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "add",
    "object": "ENGINECFG",
    "values": "Centreon Engine cfg for poller-4;Poller-4;Just a small comment"
  }
}

tests {
  test("POST /clapi - Create engine conf for poller-4 - HTTP 200 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  if (res.status === 200) {
    test("Engine configuration for Poller-4 created successfully.", function () {
      const body = res.getBody();
      expect(body).to.be.an("object");
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
