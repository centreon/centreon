meta {
  name: POST /hosts/categories - Create host category - HTTP 201
  type: http
  seq: 6
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostCategory1Name}}",
    "alias": "{{HostCategory1Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host category has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostCategory1Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("HostCategory1Name"),
      "alias": bru.getEnvVar("HostCategory1Alias")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
