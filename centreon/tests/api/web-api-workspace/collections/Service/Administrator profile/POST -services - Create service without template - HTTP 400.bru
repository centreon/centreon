meta {
  name: POST /services - Create service without template - HTTP 400
  type: http
  seq: 18
}

post {
  url: {{baseUrlWeb}}/configuration/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "service 333",
    "host_id": {{Host1Id}}
  }
}

assert {
  res.status: eq 500
}

tests {
  test("The service has not been created because the template is missing.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/check command cannot be null/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
