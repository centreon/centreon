meta {
  name: POST /hosts/groups - Create host group - HTTP 201
  type: http
  seq: 7
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup1Name}}",
    "alias": "{{HostGroup1Alias}}",
    "icon_id": null,
    "geo_coords": "",
    "is_activated": false,
    "hosts": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host group has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostGroup1Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("HostGroup1Name"),
      "alias": bru.getEnvVar("HostGroup1Alias"),
      "icon_id": null,
      "geo_coords": null
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
