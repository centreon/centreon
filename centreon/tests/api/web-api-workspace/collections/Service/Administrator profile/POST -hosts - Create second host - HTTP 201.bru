meta {
  name: POST /hosts - Create second host - HTTP 201
  type: http
  seq: 10
}

post {
  url: {{baseUrlWeb}}/configuration/hosts
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Host2Name}}",
    "alias": "{{Host2Alias}}",
    "address": "127.0.0.1",
    "monitoring_server_id": 1,
    "snmp_version": "2c",
    "templates": [ {{HostTemplate1Id}} ],
    "groups": [ {{HostGroup1Id}} ],
    "categories": [ {{HostCategory1Id}} ],
    "macros": [
      {
        "name": "try",
        "value": "essaye",
        "is_password": true,
        "description": "some text"
      },
      {
        "name": "again",
        "value": "encore",
        "is_password": false,
        "description": null
      }
    ]
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The second host has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("Host2Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("Host2Name"),
      "alias": bru.getEnvVar("Host2Alias"),
      "address": "127.0.0.1",
      "monitoring_server_id": 1,
      "snmp_version": "2c",
      "geo_coords": null,
      "note_url": null,
      "note": null,
      "action_url": null,
      "timezone_id": null,
      "severity_id": null,
      "check_timeperiod_id": null,
      "icon_id": null,
      "max_check_attempts": null,
      "normal_check_interval": null,
      "retry_check_interval": null
    });
    expect(body.groups).to.be.an("array").that.is.not.empty;
    expect(body.templates[0]).to.include({
      "id": parseInt(bru.getEnvVar("HostTemplate1Id")),
      "name": bru.getEnvVar("HostTemplate1Name")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
