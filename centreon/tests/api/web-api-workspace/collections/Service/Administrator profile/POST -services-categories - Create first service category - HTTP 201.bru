meta {
  name: POST /services/categories - Create first service category - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory1Name}}",
    "alias": "{{ServiceCategory1Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The first service category has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceCategory1Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("ServiceCategory1Name"),
      "alias": bru.getEnvVar("ServiceCategory1Alias")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
