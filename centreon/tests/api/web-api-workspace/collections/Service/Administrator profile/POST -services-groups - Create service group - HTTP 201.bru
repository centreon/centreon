meta {
  name: POST /services/groups - Create service group - HTTP 201
  type: http
  seq: 5
}

post {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceGroup1Name}}",
    "alias": "{{ServiceGroup1Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service group has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceGroup1Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("ServiceGroup1Name"),
      "alias": bru.getEnvVar("ServiceGroup1Alias")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
