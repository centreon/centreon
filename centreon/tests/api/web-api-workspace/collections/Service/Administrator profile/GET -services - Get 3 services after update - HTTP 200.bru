meta {
  name: GET /services - Get 3 services after update - HTTP 200
  type: http
  seq: 24
}

get {
  url: {{baseUrlWeb}}/configuration/services/{{Service2Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Service 2 is returned with its updated properties.", function () {
    const body = res.getBody();
    expect(body).to.include({
      "name": bru.getEnvVar("Service2Name"),
      "host_id": parseInt(bru.getEnvVar("Host2Id")),
      "service_template_id": parseInt(bru.getEnvVar("ServiceTemplate1Id")),
      "check_timeperiod_id": 1,
      "normal_check_interval": 2,
      "retry_check_interval": 1,
      "severity_id": parseInt(bru.getEnvVar("ServiceSeverity1Id"))
    });
    expect(body.categories).to.eql([
      {
        "id": parseInt(bru.getEnvVar("ServiceCategory2Id")),
        "name": bru.getEnvVar("ServiceCategory2Name")
      }
    ]);
    expect(body.groups).to.eql([
      {
        "id": parseInt(bru.getEnvVar("ServiceGroup1Id")),
        "name": bru.getEnvVar("ServiceGroup1Name")
      }
    ]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
