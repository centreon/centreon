meta {
  name: GET /services - Get 3 services after update - HTTP 200
  type: http
  seq: 24
}

get {
  url: {{baseUrlWeb}}/configuration/services?sort_by={"id":"DESC"}&limit=100
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Service 2 is returned with its updated properties.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const s2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("Service2Id")));
    expect(s2).to.exist;
    expect(s2).to.include({
      "name": bru.getEnvVar("Service2Name"),
      "normal_check_interval": 2,
      "retry_check_interval": 1
    });
    expect(s2.service_template).to.include({
      "id": parseInt(bru.getEnvVar("ServiceTemplate1Id"))
    });
    expect(s2.check_timeperiod).to.include({ "id": 1, "name": "24x7" });
    expect(s2.severity).to.include({
      "id": parseInt(bru.getEnvVar("ServiceSeverity1Id")),
      "name": bru.getEnvVar("ServiceSeverity1Name")
    });
    expect(s2.categories).to.have.lengthOf(1);
    expect(s2.categories[0]).to.include({
      "id": parseInt(bru.getEnvVar("ServiceCategory2Id")),
      "name": bru.getEnvVar("ServiceCategory2Name")
    });
    expect(s2.groups).to.have.lengthOf(1);
    expect(s2.groups[0]).to.include({
      "id": parseInt(bru.getEnvVar("ServiceGroup1Id")),
      "name": bru.getEnvVar("ServiceGroup1Name")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
