meta {
  name: GET /services - Get 1 service - HTTP 200
  type: http
  seq: 13
}

get {
  url: {{baseUrlWeb}}/configuration/services?sort_by={"id":"DESC"}&limit=100
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Service 1 is returned with all its properties.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const s1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("Service1Id")));
    expect(s1).to.exist;
    expect(s1).to.include({
      "name": bru.getEnvVar("Service1Name"),
      "normal_check_interval": 2,
      "retry_check_interval": 1
    });
    expect(s1.service_template).to.include({
      "id": parseInt(bru.getEnvVar("ServiceTemplate1Id"))
    });
    expect(s1.check_timeperiod).to.include({ "id": 1, "name": "24x7" });
    expect(s1.severity).to.include({
      "id": parseInt(bru.getEnvVar("ServiceSeverity1Id")),
      "name": bru.getEnvVar("ServiceSeverity1Name")
    });
    expect(s1.categories).to.have.lengthOf(1);
    expect(s1.categories[0]).to.include({
      "id": parseInt(bru.getEnvVar("ServiceCategory1Id")),
      "name": bru.getEnvVar("ServiceCategory1Name")
    });
    expect(s1.groups).to.have.lengthOf(1);
    expect(s1.groups[0]).to.include({
      "id": parseInt(bru.getEnvVar("ServiceGroup1Id")),
      "name": bru.getEnvVar("ServiceGroup1Name")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
