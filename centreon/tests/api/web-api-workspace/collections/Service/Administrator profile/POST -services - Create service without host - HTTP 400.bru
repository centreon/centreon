meta {
  name: POST /services - Create service without host - HTTP 400
  type: http
  seq: 17
}

post {
  url: {{baseUrlWeb}}/configuration/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "service 333",
    "service_template_id": {{ServiceTemplate1Id}}
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service has not been created because the host is missing.", function () {
    const body = res.getBody();
    expect(body.message).to.equal("[host_id] The property host_id is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
