meta {
  name: GET /services - Get services forbidden - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/services
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The services list is not accessible because the user does not have the correct rights.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("code").that.equals(403);
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
