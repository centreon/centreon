meta {
  name: POST /services - Create service forbidden - HTTP 403
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "service 005",
    "host_id": {{Host1Id}},
    "service_template_id": {{ServiceTemplate1Id}}
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The service has not been created because the user does not have the correct rights.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("code").that.equals(403);
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
