meta {
  name: POST /services/groups - Create SG forbidden - HTTP 403
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "sg-forbidden",
    "alias": "I should not be created"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to create a service group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
