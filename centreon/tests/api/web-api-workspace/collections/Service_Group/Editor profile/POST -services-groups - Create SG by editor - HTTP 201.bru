meta {
  name: POST /services/groups - Create SG by editor - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceGroup4Name}}",
    "alias": "{{ServiceGroup4Alias}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service group has been successfully created by editor, with name '{{ServiceGroup4Name}}' and alias '{{ServiceGroup4Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceGroup4Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceGroup4Name"),
      "alias": bru.getEnvVar("ServiceGroup4Alias"),
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
