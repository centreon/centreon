meta {
  name: POST /services/groups - Create SG with empty name - HTTP 400
  type: http
  seq: 9
}

post {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "alias": "Hello, I'm your ghost group!"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service group has not been created, because the name is empty.", function () {
    const body = res.getBody();
    expect(body.message).to.be.a("string").and.include("[NewServiceGroup::name]");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
