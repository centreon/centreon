meta {
  name: PUT /services/groups - Update service group - HTTP 204
  type: http
  seq: 13
}

put {
  url: {{baseUrlWeb}}/configuration/services/groups/{{ServiceGroup3Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceGroup3Name}}",
    "alias": "{{ServiceGroup3Alias}}",
    "is_activated": false,
    "comment": "Updated by Admin"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The service group has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
