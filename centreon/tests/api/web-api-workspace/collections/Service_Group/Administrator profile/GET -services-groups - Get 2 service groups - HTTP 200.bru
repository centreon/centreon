meta {
  name: GET /services/groups - Get 2 service groups - HTTP 200
  type: http
  seq: 5
}

get {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The service groups are listed with all of their parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const sg2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceGroup2Id")));
    expect(sg2).to.include({
      "id": parseInt(bru.getEnvVar("ServiceGroup2Id")),
      "name": bru.getEnvVar("ServiceGroup2Name"),
      "alias": bru.getEnvVar("ServiceGroup2Alias"),
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
