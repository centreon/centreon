meta {
  name: POST /services/groups - Create SG without name - HTTP 400
  type: http
  seq: 8
}

post {
  url: {{baseUrlWeb}}/configuration/services/groups
  body: json
  auth: inherit
}

body:json {
  {
    "alias": "Oh I'm your ghost group!"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service group has not been created, because the name is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[name] The property name is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
