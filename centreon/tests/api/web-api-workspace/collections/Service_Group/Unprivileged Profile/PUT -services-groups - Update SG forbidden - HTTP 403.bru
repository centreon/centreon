meta {
  name: PUT /services/groups - Update SG forbidden - HTTP 403
  type: http
  seq: 4
}

put {
  url: {{baseUrlWeb}}/configuration/services/groups/{{ServiceGroup2Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceGroup2Name}}",
    "alias": "{{ServiceGroup2Alias}}"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to update a service group.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
