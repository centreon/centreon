meta {
  name: GET /local - Get policy forbidden - HTTP 403
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/administration/authentication/providers/local
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Editor cannot read the local authentication provider.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
