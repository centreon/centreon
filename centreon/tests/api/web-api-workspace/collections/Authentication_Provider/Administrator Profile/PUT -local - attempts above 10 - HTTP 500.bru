meta {
  name: PUT /local - attempts above 10 - HTTP 500
  type: http
  seq: 8
}

put {
  url: {{baseUrlWeb}}/administration/authentication/providers/local
  body: json
  auth: inherit
}

body:json {
  {
    "password_security_policy": {
      "password_min_length": 12,
      "has_uppercase": false,
      "has_lowercase": false,
      "has_number": true,
      "has_special_character": false,
      "attempts": 11,
      "blocking_duration": 600,
      "password_expiration": {
        "expiration_delay": 15553000,
        "excluded_users": ["admin"]
      },
      "can_reuse_passwords": true,
      "delay_before_new_password": 7200
    }
  }
}

assert {
  res.status: eq 500
}

tests {
  test("attempts > 10 is rejected with expected message.", function () {
    const body = res.getBody();
    expect(body).to.have.property("message").that.includes("attempts");
    expect(body).to.have.property("message").that.includes("maximum value of 10");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
