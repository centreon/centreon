meta {
  name: PUT /local - Update policy - HTTP 204
  type: http
  seq: 3
}

put {
  url: {{baseUrlWeb}}/administration/authentication/providers/local
  body: json
  auth: inherit
}

body:json {
  {
    "password_security_policy": {
      "password_min_length": 8,
      "has_uppercase": false,
      "has_lowercase": false,
      "has_number": true,
      "has_special_character": false,
      "attempts": 8,
      "blocking_duration": 600,
      "password_expiration": {
        "expiration_delay": 15553000,
        "excluded_users": ["admin"]
      },
      "can_reuse_passwords": true,
      "delay_before_new_password": 7200
    }
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Password security policy updated successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
