meta {
  name: POST clapi delete timeperiod - HTTP 200
  type: http
  seq: 11
}

post {
  url: {{baseUriCentreonCLAPI}}
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "del",
    "object": "TP",
    "values": "BrunoClapiTimeperiod"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("CLAPI delete timeperiod succeeds (cleanup)", function () {
    expect(res.getBody()).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
