meta {
  name: POST centreon_clapi - Add host severity - HTTP 200
  type: http
  seq: 12
}

post {
  url: {{baseUriCentreonCLAPI}}
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "add",
    "object": "HC",
    "values": "{{CriticalityHostSeverityName}};{{CriticalityHostSeverityName}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("CLAPI adds the host category used as severity", function () {
    expect(res.getBody()).to.have.property("result");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
