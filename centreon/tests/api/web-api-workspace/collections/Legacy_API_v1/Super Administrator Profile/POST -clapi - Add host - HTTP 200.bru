meta {
  name: POST centreon_clapi - Add host - HTTP 200
  type: http
  seq: 14
}

post {
  url: {{baseUriCentreonCLAPI}}
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "add",
    "object": "HOST",
    "values": "{{CriticalityHostName}};{{CriticalityHostAlias}};127.0.0.1;{{HostTemplateName}};{{PollerName}};"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("CLAPI adds the host monitored by the central poller", function () {
    expect(res.getBody()).to.have.property("result");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
