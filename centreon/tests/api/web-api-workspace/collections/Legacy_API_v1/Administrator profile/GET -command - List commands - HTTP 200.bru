meta {
  name: GET centreon_command list - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUriCentreonApiWeb}}/index.php?object=centreon_command&action=list
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Legacy API v1 healthcheck: response has result and status properties", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result");
    expect(body).to.have.property("status");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
