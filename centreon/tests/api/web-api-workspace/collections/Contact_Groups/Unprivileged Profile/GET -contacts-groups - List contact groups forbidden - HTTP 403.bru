meta {
  name: GET /contacts/groups - List contact groups forbidden - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/contacts/groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot list contact groups.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
