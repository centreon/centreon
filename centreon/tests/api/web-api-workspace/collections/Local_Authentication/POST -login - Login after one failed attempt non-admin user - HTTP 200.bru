meta {
  name: POST /login - Login after one failed attempt non-admin user - HTTP 200
  type: http
  seq: 7
}

post {
  url: {{baseUrlWeb}}/login
  body: json
  auth: none
}

body:json {
  {
    "security": {
      "credentials": {
        "login": "{{user_unprivileged_login}}",
        "password": "{{user_unprivileged_password}}"
      }
    }
  }
}

assert {
  res.status: eq 200
}


tests {
  test("Login successful after one failed attempt. The non-admin account is not blocked.", function () {
    bru.setGlobalEnvVar("authToken", res.getBody().security.token);
    const body = res.getBody();
    expect(res.status).to.equal(200);
    expect(body.contact.alias).to.equal(bru.getGlobalEnvVar("user_unprivileged_login"));
    expect(body.contact.is_admin).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
