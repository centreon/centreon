meta {
  name: GET /monitoring/resources/hosts - List resources - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/monitoring/resources/hosts?types=["host"]
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Unprivileged user gets resources list (no ACL access, may be empty).", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
