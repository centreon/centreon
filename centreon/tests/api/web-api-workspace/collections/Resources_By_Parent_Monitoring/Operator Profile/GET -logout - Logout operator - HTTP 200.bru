meta {
  name: GET /logout - Logout operator - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/logout
  body: none
  auth: inherit
}

tests {
  test("Logout successful (known issue: session may be invalidated by ACL reload CLAPI call, returns 401).", function () {
    expect(res.status).to.be.oneOf([200, 401]);
    bru.deleteVar("currentUserName");
    bru.deleteVar("currentUserID");
    bru.deleteEnvVar("authToken");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
