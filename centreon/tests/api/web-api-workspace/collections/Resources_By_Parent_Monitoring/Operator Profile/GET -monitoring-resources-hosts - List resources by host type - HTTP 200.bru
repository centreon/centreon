meta {
  name: GET /monitoring/resources/hosts - List resources by host type - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/monitoring/resources/hosts?types=["host"]
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Operator Profile can list monitoring resources by parent (host type).", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
