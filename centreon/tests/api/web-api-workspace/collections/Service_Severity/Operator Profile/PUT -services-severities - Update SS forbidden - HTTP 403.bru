meta {
  name: PUT /services/severities - Update SS forbidden - HTTP 403
  type: http
  seq: 5
}

put {
  url: {{baseUrlWeb}}/configuration/services/severities/{{ServiceSeverity2Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceSeverity2Name}}",
    "alias": "{{ServiceSeverity2Alias}}",
    "level": 5,
    "icon_id": 2
  }
}

assert {
  res.status: eq 403
}

tests {
  test("The user does not have the correct rights to update a service severity.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
