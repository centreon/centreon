meta {
  name: GET /services/severities - Get 3 service severities - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Three service severities are visible to the editor.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const ss4 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceSeverity4Id")));
    expect(ss4).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
