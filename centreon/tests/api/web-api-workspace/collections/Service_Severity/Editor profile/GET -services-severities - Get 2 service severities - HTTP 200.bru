meta {
  name: GET /services/severities - Get 2 service severities - HTTP 200
  type: http
  seq: 7
}

get {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Two service severities remain after editor deletion.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const deletedId = parseInt(bru.getEnvVar("ServiceSeverity4Id"));
    expect(body.result.some(r => r.id === deletedId)).to.be.false;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
