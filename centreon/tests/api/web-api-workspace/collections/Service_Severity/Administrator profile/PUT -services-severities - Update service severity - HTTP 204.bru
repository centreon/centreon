meta {
  name: PUT /services/severities - Update service severity - HTTP 204
  type: http
  seq: 14
}

put {
  url: {{baseUrlWeb}}/configuration/services/severities/{{ServiceSeverity3Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceSeverity3Name}}",
    "alias": "{{ServiceSeverity3Alias}}",
    "level": 1,
    "icon_id": 1,
    "is_activated": false
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The service severity has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
