meta {
  name: POST /services/severities - Create SS without level - HTTP 400
  type: http
  seq: 11
}

post {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Test_Ghost_SS",
    "alias": "I should not work!",
    "icon_id": 1
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service severity has not been created, because the level is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[level] The property level is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
