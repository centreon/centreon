meta {
  name: POST /services/severities - Create SS with mandatory properties - HTTP 201
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceSeverity2Name}}",
    "alias": "{{ServiceSeverity2Alias}}",
    "level": 5,
    "icon_id": 2
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service severity has been successfully created, with name '{{ServiceSeverity2Name}}' and alias '{{ServiceSeverity2Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceSeverity2Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceSeverity2Name"),
      "alias": bru.getEnvVar("ServiceSeverity2Alias"),
      "level": 5,
      "icon_id": 2,
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
