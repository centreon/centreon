meta {
  name: GET /services/severities - Get 2 remaining service severities - HTTP 200
  type: http
  seq: 16
}

get {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Two service severities remain after deletion.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const deletedId = parseInt(bru.getEnvVar("ServiceSeverity1Id"));
    expect(body.result.some(r => r.id === deletedId)).to.be.false;

    const ss2 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceSeverity2Id")));
    const ss3 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ServiceSeverity3Id")));
    expect(ss2).to.not.be.undefined;
    expect(ss3).to.not.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
