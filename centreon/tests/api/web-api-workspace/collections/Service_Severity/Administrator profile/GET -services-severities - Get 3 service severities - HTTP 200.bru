meta {
  name: GET /services/severities - Get 3 service severities - HTTP 200
  type: http
  seq: 7
}

get {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Three service severities are listed.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");

    const ids = [
      parseInt(bru.getEnvVar("ServiceSeverity1Id")),
      parseInt(bru.getEnvVar("ServiceSeverity2Id")),
      parseInt(bru.getEnvVar("ServiceSeverity3Id"))
    ];
    ids.forEach(id => {
      expect(body.result.some(r => r.id === id)).to.be.true;
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
