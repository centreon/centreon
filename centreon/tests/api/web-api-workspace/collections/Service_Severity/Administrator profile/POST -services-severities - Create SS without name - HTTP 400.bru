meta {
  name: POST /services/severities - Create SS without name - HTTP 400
  type: http
  seq: 8
}

post {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: json
  auth: inherit
}

body:json {
  {
    "alias": "Oh I'm your ghost severity!",
    "level": 1,
    "icon_id": 1
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service severity has not been created, because the name is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[name] The property name is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
