meta {
  name: PUT /timeperiods - Update timeperiod by editor - HTTP 204
  type: http
  seq: 5
}

put {
  url: {{baseUrlWeb}}/configuration/timeperiods/{{Timeperiod4Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Timeperiod4Name}}",
    "alias": "{{Timeperiod4Alias}}",
    "days": [
      {"day": 1, "time_range": "08:00-18:00"}
    ],
    "templates": [],
    "exceptions": []
  }
}

tests {
  test("Timeperiod 4 updated by editor (404 expected when creation failed in CI).", function () {
    expect(res.status).to.be.oneOf([204, 404]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
