meta {
  name: PUT /timeperiods - Update timeperiod by editor - HTTP 204
  type: http
  seq: 5
}

put {
  url: {{baseUrlWeb}}/configuration/timeperiods/{{Timeperiod4Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Timeperiod4Name}}",
    "alias": "{{Timeperiod4Alias}}",
    "days": [
      {"day": 1, "time_range": "08:00-18:00"}
    ],
    "templates": [],
    "exceptions": []
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Timeperiod 4 has been successfully updated by the editor.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
