meta {
  name: POST /timeperiods - Create timeperiod by editor - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/timeperiods
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Timeperiod4Name}}",
    "alias": "{{Timeperiod4Alias}}",
    "days": [
      {"day": 1, "time_range": "00:00-24:00"},
      {"day": 2, "time_range": "00:00-24:00"},
      {"day": 3, "time_range": "00:00-24:00"},
      {"day": 4, "time_range": "00:00-24:00"},
      {"day": 5, "time_range": "00:00-24:00"}
    ],
    "templates": [],
    "exceptions": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Timeperiod 4 has been successfully created by the editor.", function () {
    const body = res.getBody();
    bru.setEnvVar("Timeperiod4Id", body.id);
    expect(body).to.include({
      "name": bru.getEnvVar("Timeperiod4Name"),
      "alias": bru.getEnvVar("Timeperiod4Alias")
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
