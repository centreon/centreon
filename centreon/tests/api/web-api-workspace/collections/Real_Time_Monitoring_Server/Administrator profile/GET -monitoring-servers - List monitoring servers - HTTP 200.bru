meta {
  name: GET /monitoring/servers - List monitoring servers - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/monitoring/servers
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Monitoring servers listed successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });

  test("Realtime poller matched on nagios_server.uid is returned.", function () {
    const body = res.getBody();
    const seededPoller = body.result.find((server) => server.name === "QA-realtime-poller");
    expect(seededPoller, "seeded realtime poller must be listed").to.not.be.undefined;
  });

  test("Legacy poller matched on nagios_server.id fallback is returned exactly once as running.", function () {
    const body = res.getBody();
    const legacyPollers = body.result.filter((server) => server.name === "QA-legacy-poller");
    expect(legacyPollers.length, "legacy poller must appear exactly once (no duplicate row)").to.eql(1);

    const legacyPoller = legacyPollers[0];
    expect(legacyPoller.is_running, "legacy poller must be reported as running").to.eql(true);

    // Legacy id is the small config id, below the up-to-date poller's uid-based id.
    const upToDatePoller = body.result.find((server) => server.name === "QA-realtime-poller");
    expect(upToDatePoller, "up-to-date poller must also be listed").to.not.be.undefined;
    expect(legacyPoller.id, "legacy poller id must be the config id, not a Snowflake uid").to.be.below(upToDatePoller.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
