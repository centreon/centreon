meta {
  name: GET /administration/vaults/configurations - Get vault configuration forbidden - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/administration/vaults/configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot read vault configuration.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
