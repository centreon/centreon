meta {
  name: GET /logout - Logout administrator - HTTP 200
  type: http
  seq: 7
}

get {
  url: {{baseUrlWeb}}/logout
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Logout successful. The displayed message is the one that is expected ('Successful logout')", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");

    bru.deleteVar("currentUserName");
    bru.deleteVar("currentUserID");
    bru.deleteEnvVar("authToken");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
