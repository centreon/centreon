meta {
  name: PUT /administration/vaults/configurations - Update vault configuration - HTTP 204
  type: http
  seq: 2
}

put {
  url: {{baseUrlWeb}}/administration/vaults/configurations
  body: json
  auth: inherit
}

body:json {
  {
    "address": "vault.test.local",
    "port": 8200,
    "root_path": "centreon",
    "role_id": "test-role-id-bruno",
    "secret_id": "test-secret-id-bruno"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The vault configuration has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
