meta {
  name: PUT /administration/vaults/configurations - Update vault configuration - HTTP 204
  type: http
  seq: 4
}

put {
  url: {{baseUrlWeb}}/administration/vaults/configurations
  body: json
  auth: inherit
}

body:json {
  {
    "address": "vault.editor.local",
    "port": 8200,
    "root_path": "centreon",
    "role_id": "editor-role-id",
    "secret_id": "editor-secret-id"
  }
}

tests {
  test("PUT /administration/vaults/configurations - Update vault configuration - HTTP 204 (returns 404 if feature unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([204, 404]);
  });

  if (res.status === 204) {
    test("The vault configuration has been successfully updated by the editor.", function () {
      expect(res.getBody()).to.be.empty;
    });

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
