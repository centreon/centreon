meta {
  name: GET /monitoring/hosts/{id}/services/{id}/timeline - Get service timeline - HTTP 200
  type: http
  seq: 10
}

get {
  url: {{baseUrlWeb}}/monitoring/hosts/{{Host1Id}}/services/{{Service1Id}}/timeline
  body: none
  auth: inherit
}

tests {
  test("Service timeline retrieved (known infra issue: centengine may not run in CI, returns 404).", function () {
    expect(res.status).to.be.oneOf([200, 404]);
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("result").that.is.an("array");
      expect(body).to.have.property("meta").that.is.an("object");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
