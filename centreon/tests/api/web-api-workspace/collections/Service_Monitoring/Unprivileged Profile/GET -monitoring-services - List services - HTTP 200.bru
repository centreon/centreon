meta {
  name: GET /monitoring/services - List services - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/monitoring/services
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Unprivileged user gets empty services list (no ACL access).", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
