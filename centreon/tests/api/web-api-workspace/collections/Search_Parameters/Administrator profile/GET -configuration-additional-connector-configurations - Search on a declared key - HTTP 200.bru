meta {
  name: GET /configuration/additional-connector-configurations - Search on a declared key - HTTP 200
  type: http
  seq: 22
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations?search={"name":{"$lk":"%"}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("A search on the declared key 'name' is accepted", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
