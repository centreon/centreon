meta {
  name: GET /configuration/media/folders - Search on an undeclared key is rejected
  type: http
  seq: 45
}

get {
  url: {{baseUrlWeb}}/configuration/media/folders?search={"unknown_key":"foo"}
  body: none
  auth: inherit
}

tests {
  // The rejection is read from the body only: this listing answers its errors with HTTP 200.
  test("A search on an undeclared key is rejected instead of being silently ignored", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.not.have.property("result");
    expect(body).to.have.property("message").that.contains("unknown_key");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
