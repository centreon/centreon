meta {
  name: GET /monitoring/downtimes - Search on a declared key - HTTP 200
  type: http
  seq: 36
}

get {
  url: {{baseUrlWeb}}/monitoring/downtimes?search={"host.name":{"$lk":"%"}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("A search on the declared key 'host.name' is accepted", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
