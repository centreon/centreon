meta {
  name: POST /monitoring/resources/comments - Add host comment - HTTP 204
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/monitoring/resources/comments
  body: json
  auth: inherit
}

body:json {
  {
    "resources": [
      {
        "type": "host",
        "id": {{Host1Id}},
        "parent": null,
        "comment": "Test comment on host",
        "date": "2026-01-01T00:00:00Z"
      }
    ]
  }
}

tests {
  test("administrator access depends on ACL (not recomputed in CI): allowed or denied (403/404 when the resource is ACL-filtered).", function () {
    expect(res.status).to.be.oneOf([204, 403, 404]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
