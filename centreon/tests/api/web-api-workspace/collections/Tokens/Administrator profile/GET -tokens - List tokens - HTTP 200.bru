meta {
  name: GET /administration/tokens - List tokens - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/administration/tokens
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Tokens list is accessible and response schema is valid.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
