meta {
  name: GET /monitoring/hosts - Token not yet expired - HTTP 200
  type: http
  seq: 5
}

get {
  url: {{baseUrlWeb}}/monitoring/hosts
  body: none
  auth: none
}

headers {
  X-AUTH-TOKEN: {{ExpiringTokenValue}}
}

assert {
  res.status: eq 200
}

tests {
  test("The API token is accepted before its expiration date.", function () {
    expect(res.getBody()).to.have.property("result").that.is.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
