meta {
  name: DELETE /acc - Delete ACC forbidden - HTTP 403
  type: http
  seq: 6
}

delete {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations/{{ACC3Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot delete an ACC.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
