meta {
  name: GET /acc - List ACC forbidden - HTTP 403
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot list ACC.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
