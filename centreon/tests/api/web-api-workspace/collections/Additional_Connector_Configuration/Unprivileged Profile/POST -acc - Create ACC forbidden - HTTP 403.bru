meta {
  name: POST /acc - Create ACC forbidden - HTTP 403
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "acc-unprivileged",
    "description": null,
