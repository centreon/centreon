meta {
  name: GET /acc - Get ACC3 by ID - HTTP 200
  type: http
  seq: 6
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations/{{ACC3Id}}
  body: none
  auth: inherit
}

tests {
  test("Editor can retrieve ACC3 by ID after update (known issue: ACC3 may not exist if admin creation failed).", function () {
    expect(res.status).to.be.oneOf([200, 403, 404]);
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.include({
        "id": parseInt(bru.getEnvVar("ACC3Id")),
        "name": "acc-003-updated"
      });
      expect(body.parameters.port).to.equal(6000);
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
