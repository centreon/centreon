meta {
  name: GET /acc - List ACC - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Editor can list ACC entries.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
    expect(body.result.length).to.equal(3);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
