meta {
  name: GET /acc - List ACC - HTTP 200 - 2 results after delete
  type: http
  seq: 8
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The ACC list contains 2 entries after editor deletion of ACC1.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result.length).to.equal(2);
    const deletedAcc = body.result.find(r => r.id === parseInt(bru.getEnvVar("ACC1Id")));
    expect(deletedAcc).to.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
