meta {
  name: GET /acc - List ACC - HTTP 200 - 2 results after delete
  type: http
  seq: 23
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

tests {
  test("The ACC list contains 2 entries after ACC2 deletion (known issue: user_administrator requires is_admin=true, returns 403 in CI).", function () {
    expect(res.status).to.be.oneOf([200, 403]);
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("result").that.is.an("array");
      expect(body.result.length).to.equal(2);
      const deletedAcc = body.result.find(r => r.id === parseInt(bru.getEnvVar("ACC2Id")));
      expect(deletedAcc).to.be.undefined;
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
