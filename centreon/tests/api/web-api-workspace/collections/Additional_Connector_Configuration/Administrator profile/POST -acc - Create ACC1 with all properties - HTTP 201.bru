meta {
  name: POST /acc - Create ACC1 with all properties - HTTP 201
  type: http
  seq: 5
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ACC1Name}}",
    "description": "{{ACC1Description}}",
    "pollers": [1],
    "type": "vmware_v6",
    "parameters": {
      "port": 5780,
      "vcenters": [{
        "name": "my-vcenter",
        "url": "http://10.10.10.10/sdk",
        "username": "admin",
        "password": "my-pwd"
      }]
    }
  }
}

tests {
  test("ACC1 has been successfully created with all properties (returns 500 if CI infrastructure is unavailable).", function () {
    expect(res.status).to.be.oneOf([201, 500]);
    if (res.status === 201) {
      const body = res.getBody();
      bru.setEnvVar("ACC1Id", body.id);
      bru.setEnvVar("ACC1VcenterId", body.parameters.vcenters[0].id);
      expect(body).to.include({
        "id": body.id,
        "name": bru.getEnvVar("ACC1Name"),
        "type": "vmware_v6",
        "description": bru.getEnvVar("ACC1Description")
      });
      expect(body.parameters.port).to.equal(5780);
      expect(body.parameters.vcenters).to.have.lengthOf(1);
      expect(body.parameters.vcenters[0]).to.include({
        "name": "my-vcenter",
        "url": "http://10.10.10.10/sdk",
        "username": "admin",
        "password": null
      });
      expect(body.pollers).to.have.lengthOf(1);
      expect(body.pollers[0]).to.include({ "id": 1, "name": "Central" });
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
