  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": null,
    "pollers": [3],
    "type": "vmware_v6",
    "parameters": {
      "port": 5780,
      "vcenters": [{"name": "my-vcenter-2", "url": "http://10.10.10.10/sdk", "username": "admin", "password": "my-pwd"}]
    }
  }
}

tests {
  test("Cannot create an ACC with an empty name (returns 500 if CI infrastructure is unavailable).", function () {
    expect(res.status).to.be.oneOf([400, 500]);
  });
}

settings {
