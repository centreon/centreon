meta {
  name: POST /acc - Create ACC with empty name - HTTP 400
  type: http
  seq: 10
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": null,
    "pollers": [3],
    "type": "vmware_v6",
    "parameters": {
      "port": 5780,
      "vcenters": [{"name": "my-vcenter-2", "url": "http://10.10.10.10/sdk", "username": "admin", "password": "my-pwd"}]
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Cannot create an ACC with an empty name.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
