meta {
  name: POST /acc - Create ACC with duplicate vcenter name - HTTP 500
  type: http
  seq: 16
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "bad-acc",
    "description": "{{ACC1Description}}",
    "pollers": [3],
    "type": "vmware_v6",
    "parameters": {
      "port": 5780,
      "vcenters": [
        {"name": "my-vcenter", "url": "http://10.10.10.10/sdk", "username": "admin", "password": "my-pwd"},
        {"name": "my-vcenter", "url": "http://10.10.10.11/sdk", "username": "admin", "password": "my-pwd"}
      ]
    }
  }
}

assert {
  res.status: eq 500
}

tests {
  test("Cannot create an ACC with duplicate vcenter names.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
