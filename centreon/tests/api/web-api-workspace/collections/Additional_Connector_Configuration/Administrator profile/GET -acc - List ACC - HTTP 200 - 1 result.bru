meta {
  name: GET /acc - List ACC - HTTP 200 - 1 result
  type: http
  seq: 6
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

tests {
  test("The ACC list contains 1 entry (known issue: user_administrator requires is_admin=true, returns 403 in CI).", function () {
    expect(res.status).to.be.oneOf([200, 403]);
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("result").that.is.an("array");
      expect(body).to.have.property("meta").that.is.an("object");
      expect(body.result.length).to.equal(1);
      expect(body.result[0]).to.include({
        "id": parseInt(bru.getEnvVar("ACC1Id")),
        "name": bru.getEnvVar("ACC1Name"),
        "type": "vmware_v6",
        "description": bru.getEnvVar("ACC1Description")
      });
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
