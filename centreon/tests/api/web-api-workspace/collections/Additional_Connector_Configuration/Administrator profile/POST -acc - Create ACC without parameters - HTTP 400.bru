meta {
  name: POST /acc - Create ACC without parameters - HTTP 400
  type: http
  seq: 13
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "bad-acc",
    "description": null,
    "pollers": [1],
    "type": "vmware_v6"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Cannot create an ACC without parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
