meta {
  name: POST /acc - Create ACC with wrong parameters - HTTP 400
  type: http
  seq: 14
}

post {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "bad-acc",
    "description": null,
    "pollers": [1],
    "type": "vmware_v6",
    "parameters": {
      "port": 5780
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Cannot create an ACC with parameters missing vcenters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
