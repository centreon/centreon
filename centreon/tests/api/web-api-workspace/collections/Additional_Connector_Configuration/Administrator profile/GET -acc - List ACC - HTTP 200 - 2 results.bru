meta {
  name: GET /acc - List ACC - HTTP 200 - 2 results
  type: http
  seq: 8
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The ACC list contains 2 entries.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result.length).to.equal(2);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
