meta {
  name: GET /acc - List ACC - HTTP 200 - 3 results after update
  type: http
  seq: 21
}

get {
  url: {{baseUrlWeb}}/configuration/additional-connector-configurations
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The ACC list contains 3 entries and ACC1 name is updated.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result.length).to.equal(3);
    const acc1 = body.result.find(r => r.id === parseInt(bru.getEnvVar("ACC1Id")));
    expect(acc1).to.not.be.undefined;
    expect(acc1.name).to.equal("acc-001-updated");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
