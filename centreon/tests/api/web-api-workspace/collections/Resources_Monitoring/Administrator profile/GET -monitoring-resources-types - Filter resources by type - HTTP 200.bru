meta {
  name: GET /monitoring/resources - Filter resources by type - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/monitoring/resources?types=["host"]
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Administrator profile can filter monitoring resources by type.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
