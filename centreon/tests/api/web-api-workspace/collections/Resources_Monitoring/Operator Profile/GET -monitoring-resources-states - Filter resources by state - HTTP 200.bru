meta {
  name: GET /monitoring/resources - Filter resources by state - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/monitoring/resources?states=["acknowledged"]
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Operator Profile can filter monitoring resources by state.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
