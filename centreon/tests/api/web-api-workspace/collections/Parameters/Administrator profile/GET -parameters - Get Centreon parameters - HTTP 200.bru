meta {
  name: GET /parameters - Get Centreon parameters - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/administration/parameters
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Administrator can read Centreon parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
