meta {
  name: GET /parameters - Get Centreon parameters - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/administration/parameters
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Unprivileged user can read Centreon parameters.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });

  test("Default limit per page is exposed as an integer.", function () {
    const limitPerPage = res.getBody().default_limit_per_page;
    expect(limitPerPage).to.be.a("number");
    expect(Number.isInteger(limitPerPage)).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
