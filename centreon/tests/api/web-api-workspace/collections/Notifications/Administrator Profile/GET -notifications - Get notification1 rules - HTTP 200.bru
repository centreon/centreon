meta {
  name: GET /notifications - Get notification1 rules - HTTP 200
  type: http
  seq: 7
}

get {
  url: {{baseUrlWeb}}/configuration/notifications/{{Notification1Id}}/rules
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Notification1 rules endpoint returns a list.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
