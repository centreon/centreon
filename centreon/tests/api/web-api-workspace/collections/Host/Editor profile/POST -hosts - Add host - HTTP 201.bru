meta {
  name: POST /hosts - Add host - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/hosts
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Host2Name}}",
    "alias": "{{Host2Alias}}",
    "address": "127.0.0.1",
    "monitoring_server_id": 1,
    "snmp_version": "2c",
    "timezone_id": 1,
    "severity_id": {{HostSeverity1Id}},
    "check_timeperiod_id": 1,
    "note_url": "noteUrl-value",
    "note": "note-value",
    "action_url": "actionUrl-value",
    "max_check_attempts": 3,
    "normal_check_interval": 5,
    "retry_check_interval": 2,
    "icon_id": 1,
    "categories": [ {{HostCategory1Id}}
    ],
    "templates": [ {{HostTemplate1Id}}
    ],
    "geo_coords": "48.51,2.20",
    "groups": [ {{HostGroup1Id}}
    ],
    "macros": [
      {
        "name": "nameC",
        "value": "valueC",
        "is_password": false,
        "description": "some text"
      },
      {
        "name": "nameD",
        "value": "valueD",
        "is_password": true,
        "description": null
      }
    ],
    "is_activated": true
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Response schema is valid", function () {
    const body = res.getBody();
  
    expect(body).to.be.an("object");
    expect(body).to.have.property("id").that.is.a("number");
    expect(body).to.have.property("monitoring_server_id").that.is.an("number");
    expect(body).to.have.property("name").that.is.a("string");
    expect(body).to.have.property("address").that.is.a("string");
    expect(body).to.have.property("snmp_version").that.is.a("string");
    expect(body).to.have.property("geo_coords").that.is.a("string");
    expect(body).to.have.property("icon_id").that.is.a("number");
    expect(body).to.have.property("alias").that.is.a("string");
    expect(body).to.have.property("max_check_attempts").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("normal_check_interval").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("retry_check_interval").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("note_url").that.satisfy(v => v === null || typeof v === "string");
    expect(body).to.have.property("note").that.satisfy(v => v === null || typeof v === "string");
    expect(body).to.have.property("action_url").that.satisfy(v => v === null || typeof v === "string");
    expect(body).to.have.property("timezone_id").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("severity_id").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("check_timeperiod_id").that.satisfy(v => v === null || typeof v === "number");
    expect(body).to.have.property("templates").that.is.an("array");
    expect(body).to.have.property("categories").that.is.an("array");
    expect(body).to.have.property("groups").that.is.an("array");
    
    bru.setEnvVar("Host2Id", body.id);
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
