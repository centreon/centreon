meta {
  name: GET /monitoring/services/categories - List service categories - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/monitoring/services/categories
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Unprivileged user gets empty service categories list (no ACL access).", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result).to.have.lengthOf(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
