meta {
  name: POST /outputs - Add IPv4 output - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-1",
    "type": 3,
    "parameters": {
      "port": 5670,
      "host": "localhost",
      "protocol": "bbdo",
      "tls": "no",
      "private_key": null,
      "tls_hostname": null,
      "public_cert": null,
      "ca_certificate": null,
      "negotiation": "no",
      "one_peer_retention_mode": "yes",
      "filters_category": ["neb"]
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("IPv4 output created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
