meta {
  name: POST /outputs - Add BBDO Server output - HTTP 201
  type: http
  seq: 14
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-13",
    "type": 35,
    "parameters": {
      "host": null,
      "port": "5670",
      "transport_protocol": "gRPC",
      "authorization": null,
      "encryption": "no",
      "private_key": null,
      "certificate": null,
      "compression": "no",
      "retention": "no",
      "filters_category": ["dumper", "storage"]
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("BBDO Server output created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
