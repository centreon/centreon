meta {
  name: POST /outputs - Add Database configuration writer output - HTTP 201
  type: http
  seq: 9
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-8",
    "type": 29,
    "parameters": {
      "db_type": "tds",
      "db_host": "127.0.0.1",
      "db_port": 3456,
      "db_user": "user-test",
      "db_password": "super_password",
      "db_name": "storage"
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Database configuration writer output created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
