meta {
  name: POST /outputs - Add RRD file generator output - HTTP 201
  type: http
  seq: 5
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-4",
    "type": 13,
    "parameters": {
      "metrics_path": "/some/random/path/",
      "status_path": "bbdo",
      "rrd_cached_option": "unix",
      "rrd_cached": "8090",
      "store_in_data_bin": "no",
      "write_metrics": "no",
      "insert_in_index_data": "2",
      "write_status": "no",
      "filters_category": ["dumper"]
    }
  }
}

tests {
  test("RRD file generator output created successfully (returns 500 if broker infrastructure is unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([201, 500]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
