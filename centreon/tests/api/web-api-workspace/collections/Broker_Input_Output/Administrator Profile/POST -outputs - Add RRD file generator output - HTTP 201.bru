meta {
  name: POST /outputs - Add RRD file generator output - HTTP 201
  type: http
  seq: 5
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-4",
    "type": 13,
    "parameters": {
      "metrics_path": "/some/random/path/",
      "status_path": "bbdo",
      "rrd_cached_option": "unix",
      "rrd_cached": "8090",
      "store_in_data_bin": "no",
      "write_metrics": "no",
      "insert_in_index_data": "2",
      "write_status": "no",
      "filters_category": ["dumper"]
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("RRD file generator output created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
