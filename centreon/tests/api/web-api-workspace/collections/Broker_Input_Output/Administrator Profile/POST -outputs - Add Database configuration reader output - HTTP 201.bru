meta {
  name: POST /outputs - Add Database configuration reader output - HTTP 201
  type: http
  seq: 8
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-7",
    "type": 28,
    "parameters": {
      "db_type": "sqlite",
      "db_host": "127.0.0.1",
      "db_port": 3456,
      "db_user": "user-test",
      "db_password": "super_password",
      "db_name": "storage"
    }
  }
}

tests {
  test("Database configuration reader output created successfully (returns 500 if broker infrastructure is unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([201, 500]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
