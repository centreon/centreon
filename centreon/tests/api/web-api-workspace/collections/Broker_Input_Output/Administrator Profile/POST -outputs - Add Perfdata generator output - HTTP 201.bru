meta {
  name: POST /outputs - Add Perfdata generator output - HTTP 201
  type: http
  seq: 6
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-5",
    "type": 14,
    "parameters": {
      "interval": 120,
      "length": 155520000,
      "db_type": "mysql",
      "db_host": "127.0.0.1",
      "db_port": 3456,
      "db_user": "user-test",
      "connections_count": 2,
      "db_password": "super_password",
      "db_name": "storage",
      "queries_per_transaction": 500,
      "read_timeout": 3600,
      "rebuild_check_interval": 60,
      "store_in_data_bin": "no",
      "insert_in_index_data": "2",
      "filters_category": ["storage", "neb", "dumper"]
    }
  }
}

tests {
  test("Perfdata generator output created successfully (returns 500 if broker infrastructure is unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([201, 500]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
