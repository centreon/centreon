meta {
  name: POST /outputs - Add BBDO Client output - HTTP 201
  type: http
  seq: 15
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-test-14",
    "type": 36,
    "parameters": {
      "host": "127.0.0.1",
      "port": 80,
      "retry_interval": null,
      "transport_protocol": "gRPC",
      "authorization": null,
      "encryption": "no",
      "ca_certificate": null,
      "ca_name": null,
      "compression": "no",
      "filters_category": ["dumper", "neb"]
    }
  }
}

tests {
  test("BBDO Client output created successfully (returns 500 if broker infrastructure is unavailable in CI).", function () {
    expect(res.status).to.be.oneOf([201, 500]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
