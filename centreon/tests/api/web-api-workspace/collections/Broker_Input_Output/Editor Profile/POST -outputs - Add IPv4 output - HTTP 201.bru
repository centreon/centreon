meta {
  name: POST /outputs - Add IPv4 output - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-editor-1",
    "type": 3,
    "parameters": {
      "port": 5671,
      "host": "localhost",
      "protocol": "bbdo",
      "tls": "no",
      "private_key": null,
      "tls_hostname": null,
      "public_cert": null,
      "ca_certificate": null,
      "negotiation": "no",
      "one_peer_retention_mode": "yes",
      "filters_category": ["neb"]
    }
  }
}

tests {
  test("Editor can create an IPv4 output. (known issue: no is_admin access, returns 403 in CI).", function () {
    expect(res.status).to.be.oneOf([201, 403]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
