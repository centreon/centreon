meta {
  name: POST /outputs - Add Storage Graphite output - HTTP 201
  type: http
  seq: 11
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-editor-9",
    "type": 30,
    "parameters": {
      "db_host": "127.0.0.1",
      "db_port": 3456,
      "db_user": "user-test",
      "db_password": "super_password",
      "queries_per_transaction": 10000,
      "metric_naming": "erroorrrrr",
      "status_naming": "try again"
    }
  }
}

tests {
  test("Editor can create a Storage Graphite output. (known issue: no is_admin access, returns 403 in CI).", function () {
    expect(res.status).to.be.oneOf([201, 403]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
