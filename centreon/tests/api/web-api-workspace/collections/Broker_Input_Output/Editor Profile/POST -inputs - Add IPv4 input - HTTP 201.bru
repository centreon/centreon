meta {
  name: POST /inputs - Add IPv4 input - HTTP 201
  type: http
  seq: 17
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/inputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "input-editor-1",
    "type": 3,
    "parameters": {
      "port": 5671,
      "host": "localhost",
      "protocol": "bbdo",
      "tls": "no",
      "private_key": null,
      "tls_hostname": null,
      "public_cert": null,
      "ca_certificate": null,
      "negotiation": "no",
      "one_peer_retention_mode": "yes",
      "filters_category": ["neb"]
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Editor can create an IPv4 input.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
