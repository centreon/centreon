meta {
  name: POST /outputs - Add Database configuration writer output - HTTP 201
  type: http
  seq: 10
}

post {
  url: {{baseUrlWeb}}/configuration/broker/1/outputs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "output-editor-8",
    "type": 29,
    "parameters": {
      "db_type": "tds",
      "db_host": "127.0.0.1",
      "db_port": 3456,
      "db_user": "user-test",
      "db_password": "super_password",
      "db_name": "storage"
    }
  }
}

tests {
  test("Editor can create a Database configuration writer output. (known issue: no is_admin access, returns 403 in CI).", function () {
    expect(res.status).to.be.oneOf([201, 403]);
    if (res.status === 201) {
      const body = res.getBody();
      expect(body).to.have.property("id").that.is.a("number");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
