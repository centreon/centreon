meta {
  name: GET /monitoring/acknowledgements - List acknowledged resources - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/monitoring/acknowledgements
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The acknowledged resources are listed for editor.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
    expect(body.result.length).to.be.greaterThan(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
