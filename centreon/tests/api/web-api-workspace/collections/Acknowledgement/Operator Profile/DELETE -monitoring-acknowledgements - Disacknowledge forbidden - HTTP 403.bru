meta {
  name: DELETE /monitoring/acknowledgements - Disacknowledge forbidden - HTTP 403
  type: http
  seq: 5
}

delete {
  url: {{baseUrlWeb}}/monitoring/resources/acknowledgements
  body: json
  auth: inherit
}

body:json {
  {
    "disacknowledgement": {
      "with_services": true
    },
    "resources": [
      {
        "type": "host",
        "id": {{Host1Id}},
        "parent": null
      }
    ]
  }
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot remove acknowledgements.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("code").that.equals(403);
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
