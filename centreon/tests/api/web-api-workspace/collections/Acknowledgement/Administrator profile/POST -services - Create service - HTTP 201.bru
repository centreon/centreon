meta {
  name: POST /services - Create service - HTTP 201
  type: http
  seq: 6
}

post {
  url: {{baseUrlWeb}}/configuration/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Service1Name}}",
    "host_id": {{Host1Id}},
    "service_template_id": {{ServiceTemplate1Id}},
    "max_check_attempts": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("Service1Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("Service1Name"),
      "host_id": parseInt(bru.getEnvVar("Host1Id")),
      "service_template_id": parseInt(bru.getEnvVar("ServiceTemplate1Id"))
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
