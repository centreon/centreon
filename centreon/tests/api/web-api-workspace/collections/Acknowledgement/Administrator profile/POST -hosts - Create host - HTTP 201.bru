meta {
  name: POST /hosts - Create host - HTTP 201
  type: http
  seq: 5
}

post {
  url: {{baseUrlWeb}}/configuration/hosts
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{Host1Name}}",
    "alias": "{{Host1Alias}}",
    "address": "127.0.0.1",
    "monitoring_server_id": 1,
    "templates": [{{HostTemplate1Id}}],
    "max_check_attempts": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("Host1Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("Host1Name"),
      "alias": bru.getEnvVar("Host1Alias"),
      "address": "127.0.0.1",
      "monitoring_server_id": 1
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
