meta {
  name: POST /commands - Create command - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/commands
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{CommandName}}",
    "type": "Check",
    "command_line": "{{CommandLine}}",
    "is_shell_enabled": false
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The command has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("CommandId", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("CommandName"),
      "type": "Check",
      "command_line": bru.getEnvVar("CommandLine"),
      "is_shell_enabled": false,
      "is_activated": true
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
