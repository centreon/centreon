meta {
  name: POST /monitoring/acknowledgements - Acknowledge host - HTTP 403
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/monitoring/hosts/{{Host1Id}}/acknowledgements
  body: json
  auth: inherit
}

body:json {
  {
    "comment": "Acknowledged by administrator",
    "is_notify_contacts": false,
    "with_services": true,
    "is_persistent_comment": false,
    "is_sticky": false
  }
}

tests {
  test("administrator access depends on ACL (not recomputed in CI): acknowledge is allowed (204) or denied (403).", function () {
    expect(res.status).to.be.oneOf([204, 403]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
