meta {
  name: POST /monitoring/services - Submit CRITICAL result - HTTP 204
  type: http
  seq: 10
}

post {
  url: {{baseUrlWeb}}/monitoring/hosts/{{Host1Id}}/services/{{Service1Id}}/submit
  body: json
  auth: inherit
}

body:json {
  {
    "status": 2,
    "output": "CRITICAL"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The CRITICAL result has been successfully submitted for the service.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
