meta {
  name: POST /services/templates - Create service template - HTTP 201
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/services/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceTemplate1Name}}",
    "alias": "{{ServiceTemplate1Alias}}",
    "check_command_id": {{CommandId}}
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service template has been successfully created.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceTemplate1Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceTemplate1Name"),
      "alias": bru.getEnvVar("ServiceTemplate1Alias"),
      "check_command_id": parseInt(bru.getEnvVar("CommandId"))
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
