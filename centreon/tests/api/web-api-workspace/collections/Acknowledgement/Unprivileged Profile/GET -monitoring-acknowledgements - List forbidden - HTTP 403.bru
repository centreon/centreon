meta {
  name: GET /monitoring/acknowledgements - List forbidden - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/monitoring/acknowledgements
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot list acknowledgements.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("code").that.equals(403);
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
