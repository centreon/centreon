meta {
  name: GET /monitoring/hosts - List hosts after reload - HTTP 200
  type: http
  seq: 9
}

get {
  url: {{baseUrlWeb}}/monitoring/hosts
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Hosts are listed after configuration reload.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
