meta {
  name: GET /platform/features - Get platform features - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/platform/features
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Operator can read platform features.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
