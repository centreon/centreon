meta {
  name: GET /configuration/medias - List medias - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/medias
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Administrator can list medias.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
