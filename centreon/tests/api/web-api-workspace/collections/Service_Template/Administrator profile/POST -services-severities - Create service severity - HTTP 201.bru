meta {
  name: POST /services/severities - Create service severity - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/services/severities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceSeverity1Name}}",
    "alias": "{{ServiceSeverity1Alias}}",
    "level": 2,
    "icon_id": 1,
    "is_activated": false
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service severity has been successfully created, with name '{{ServiceSeverity1Name}}' and alias '{{ServiceSeverity1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceSeverity1Id", body.id);
    expect(body).to.eql({
      "id": body.id,
      "name": bru.getEnvVar("ServiceSeverity1Name"),
      "alias": bru.getEnvVar("ServiceSeverity1Alias"),
      "level": 2,
      "icon_id": 1,
      "is_activated": false
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
