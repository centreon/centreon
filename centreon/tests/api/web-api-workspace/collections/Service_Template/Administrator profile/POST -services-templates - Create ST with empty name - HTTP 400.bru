meta {
  name: POST /services/templates - Create ST with empty name - HTTP 400
  type: http
  seq: 15
}

post {
  url: {{baseUrlWeb}}/configuration/services/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "alias": "{{ServiceTemplate1Alias}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The service template has not been created, because the name is empty.", function () {
    expect(res.getBody().message).to.eql("[NewServiceTemplate::name] The string is empty, but non empty string was expected");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
