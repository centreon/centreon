meta {
  name: POST /services/categories - Create service category - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/services/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{ServiceCategory1Name}}",
    "alias": "{{ServiceCategory1Alias}}",
    "is_activated": false
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The service category has been successfully created, with name '{{ServiceCategory1Name}}' and alias '{{ServiceCategory1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("ServiceCategory1Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("ServiceCategory1Name"),
      "alias": bru.getEnvVar("ServiceCategory1Alias"),
      "is_activated": false
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
