meta {
  name: DELETE /services/templates - Delete ST3 - HTTP 204
  type: http
  seq: 5
}

delete {
  url: {{baseUrlWeb}}/configuration/services/templates/{{ServiceTemplate3Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
  test("The service template ST3 has been successfully deleted.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
