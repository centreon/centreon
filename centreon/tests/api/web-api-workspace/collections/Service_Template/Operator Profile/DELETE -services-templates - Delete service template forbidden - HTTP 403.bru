meta {
  name: DELETE /services/templates - Delete service template forbidden - HTTP 403
  type: http
  seq: 6
}

delete {
  url: {{baseUrlWeb}}/configuration/services/templates/{{ServiceTemplate2Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("The service template has not been deleted, because the user does not have the correct rights.", function () {
    expect(res.getBody().message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
