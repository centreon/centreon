meta {
  name: PUT /authentication/users/{alias}/password - Update editor password - HTTP 204
  type: http
  seq: 2
}

put {
  url: {{baseUrlWeb}}/authentication/users/{{user_editor_login}}/password
  body: json
  auth: inherit
}

body:json {
  {
    "old_password": "{{user_editor_password}}",
    "new_password": "{{editorNewPassword}}"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Editor can update its own password.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
