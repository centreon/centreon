meta {
  name: PUT /authentication/users/{alias}/password - Update with new valid password - HTTP 204
  type: http
  seq: 2
}

put {
  url: {{baseUrlWeb}}/authentication/users/{{user_administrator_login}}/password
  body: json
  auth: inherit
}

body:json {
  {
    "old_password": "{{user_administrator_password}}",
    "new_password": "{{adminNewPassword}}"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Administrator password updated successfully.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
