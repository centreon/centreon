meta {
  name: PUT /authentication/users/{alias}/password - Revert to old password forbidden - HTTP 400
  type: http
  seq: 4
}

put {
  url: {{baseUrlWeb}}/authentication/users/{{user_administrator_login}}/password
  body: json
  auth: inherit
}

body:json {
  {
    "old_password": "{{adminNewPassword}}",
    "new_password": "{{user_administrator_password}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Reusing a recent old password is rejected (history check).", function () {
    const body = res.getBody();
    expect(body).to.have.property("message").that.equals("Old password usage is disable");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
