meta {
  name: PUT /authentication/users/{alias}/password - Update with invalid format - HTTP 400
  type: http
  seq: 3
}

put {
  url: {{baseUrlWeb}}/authentication/users/{{user_administrator_login}}/password
  body: json
  auth: inherit
}

body:json {
  {
    "old_password": "{{adminNewPassword}}",
    "new_password": "{{adminShortPassword}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Password not matching security policy is rejected with the expected message.", function () {
    const body = res.getBody();
    expect(body).to.have.property("message").that.equals("Your password doesn't match the security policy");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
