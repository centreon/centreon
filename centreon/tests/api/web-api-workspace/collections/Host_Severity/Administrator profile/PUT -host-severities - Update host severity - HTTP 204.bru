meta {
  name: PUT /host-severities - Update host severity - HTTP 204
  type: http
  seq: 11
}

put {
  url: {{baseUrlWeb}}/configuration/hosts/severities/{{HostSeverity3Id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostSeverity3Name}}",
    "alias": "{{HostSeverity3Alias}}",
    "level": 1,
    "icon_id": 1,
    "is_activated": false
  }
}

assert {
  res.status: eq 204
}

tests {
  test("The host severity has been successfully updated.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
