meta {
  name: POST /host-severities - Add host severity without level - HTTP 400
  type: http
  seq: 7
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/severities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Missing level name",
    "alias": "Missing level alias",
    "icon_id": 1
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The host severity has not been created, because the level is mandatory.", function () {
    const body = res.getBody();
    expect(body.message).to.eql("[level] The property level is required\n");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
