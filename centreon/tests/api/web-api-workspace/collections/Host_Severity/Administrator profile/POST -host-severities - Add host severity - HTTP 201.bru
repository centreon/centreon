meta {
  name: POST /host-severities - Add host severity - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/severities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostSeverity1Name}}",
    "alias": "{{HostSeverity1Alias}}",
    "level": 10,
    "icon_id": 1,
    "is_activated": false
  }
}

assert {
  res.status: eq 201
}

tests {
  test("The host severity has been successfully created, with name '{{HostSeverity1Name}}' and alias '{{HostSeverity1Alias}}'.", function () {
    const body = res.getBody();
    bru.setEnvVar("HostSeverity1Id", body.id);
    expect(body).to.include({
      "id": body.id,
      "name": bru.getEnvVar("HostSeverity1Name"),
      "alias": bru.getEnvVar("HostSeverity1Alias"),
      "level": 10,
      "icon_id": 1,
      "is_activated": false
    });
  });

  test("The Location parameter is in the header.", function () {
    expect(res.getHeaders()).to.have.property("location");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
