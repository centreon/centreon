meta {
  name: DELETE /host-severities - Delete host severity - HTTP 204
  type: http
  seq: 12
}

delete {
  url: {{baseUrlWeb}}/configuration/hosts/severities/{{HostSeverity1Id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
  test("The host severity '{{HostSeverity1Name}}' has been successfully deleted.", function () {
    expect(res.getBody()).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
