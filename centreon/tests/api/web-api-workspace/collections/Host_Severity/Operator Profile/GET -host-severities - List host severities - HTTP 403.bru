meta {
  name: GET /host-severities - List host severities - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/hosts/severities
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot list host severities.", function () {
    const body = res.getBody();
    expect(body.message).to.match(/not allowed/i);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
