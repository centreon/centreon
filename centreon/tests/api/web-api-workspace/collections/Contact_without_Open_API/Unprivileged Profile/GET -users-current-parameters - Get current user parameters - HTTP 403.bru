meta {
  name: GET /users/current/parameters - Get current user parameters - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/users/current/parameters
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot retrieve current user parameters.", function () {
    expect(res.status).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
