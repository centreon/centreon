meta {
  name: GET /configuration/hosts - Assert the skip-case copy falls back to _2 - HTTP 200
  type: http
  seq: 19
}

get {
  url: {{baseUrlWeb}}/configuration/hosts?search={"name":"{{HostSkipName}}_2"}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The copy lands on _2, the _1 candidate being taken by a host template of the same name", function () {
    const body = res.getBody();
    expect(body.result).to.have.lengthOf(1);
    expect(body.result[0].name).to.eql(`${bru.getEnvVar("HostSkipName")}_2`);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
