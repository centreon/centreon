meta {
  name: POST /configuration/hosts/groups - Create host group - HTTP 201
  type: http
  seq: 4
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostGroup1Name}}",
    "alias": "{{HostGroup1Alias}}",
    "icon_id": null,
    "geo_coords": "",
    "hosts": []
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Host group created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
    bru.setEnvVar("HostGroup1Id", body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
