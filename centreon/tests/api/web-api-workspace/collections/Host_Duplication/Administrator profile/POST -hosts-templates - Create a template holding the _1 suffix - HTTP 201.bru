meta {
  name: POST /configuration/hosts/templates - Create a template holding the _1 suffix - HTTP 201
  type: http
  seq: 16
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostSkipName}}_1",
    "alias": "Holds the _1 suffix so the duplication must skip it",
    "check_command_id": {{CommandId}},
    "max_check_attempts": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("A host template named like the first candidate suffix is created.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
    expect(body.name).to.eql(`${bru.getEnvVar("HostSkipName")}_1`);
    bru.setEnvVar("HostSkipTemplateId", body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
