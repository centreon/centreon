meta {
  name: GET /configuration/hosts - Assert the second duplication uses the _2 suffix - HTTP 200
  type: http
  seq: 14
}

get {
  url: {{baseUrlWeb}}/configuration/hosts?search={"name":"{{Host1Name}}_2"}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The second duplication takes the next free suffix _2, the first copy already holding _1", function () {
    const body = res.getBody();
    expect(body.result).to.have.lengthOf(1);
    expect(body.result[0].name).to.eql(`${bru.getEnvVar("Host1Name")}_2`);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
