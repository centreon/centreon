meta {
  name: POST /configuration/hosts/templates - Create host template - HTTP 201
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/hosts/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{HostTemplate1Name}}",
    "alias": "{{HostTemplate1Alias}}",
    "check_command_id": {{CommandId}},
    "max_check_attempts": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Host template created successfully.", function () {
    const body = res.getBody();
    expect(body).to.have.property("id").that.is.a("number");
    bru.setEnvVar("HostTemplate1Id", body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
