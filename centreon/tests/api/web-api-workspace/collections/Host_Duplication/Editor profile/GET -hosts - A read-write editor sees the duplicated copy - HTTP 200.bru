meta {
  name: GET /configuration/hosts - A read-write editor sees the duplicated copy - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/hosts?search={"name":"{{Host1Name}}_1"}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("A non-admin user with host read/write rights sees the copy through its ACL scope", function () {
    const body = res.getBody();
    expect(body.result).to.have.lengthOf(1);
    expect(body.result[0].name).to.eql(`${bru.getEnvVar("Host1Name")}_1`);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
