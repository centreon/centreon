meta {
  name: GET /commands - List commands - HTTP 200
  type: http
  seq: 4
}

get {
  url: {{baseUrlWeb}}/configuration/commands
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Editor can list commands.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body.result.length).to.be.at.least(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
