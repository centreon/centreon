meta {
  name: POST /commands - Invalid field type for type - HTTP 400
  type: http
  seq: 7
}

post {
  url: {{baseUrlWeb}}/configuration/commands
  body: json
  auth: inherit
}

body:json {
  {"name": "{{CommandName}}", "type": 2, "command_line": "{{CommandLine}}", "is_shell_enabled": true}
}

assert {
  res.status: eq 400
}

tests {
  test("Command creation refused: invalid type field.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
