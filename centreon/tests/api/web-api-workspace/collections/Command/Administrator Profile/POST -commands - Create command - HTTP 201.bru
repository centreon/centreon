meta {
  name: POST /commands - Create command - HTTP 201
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/configuration/commands
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{CommandNameAdmin}}",
    "type": {{CommandType}},
    "command_line": "{{CommandLine}}",
    "is_shell": true
  }
}

tests {
  test("administrator access depends on ACL (not recomputed in CI): create allowed (201) or denied (403/404).", function () {
    expect(res.status).to.be.oneOf([201, 403, 404]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
