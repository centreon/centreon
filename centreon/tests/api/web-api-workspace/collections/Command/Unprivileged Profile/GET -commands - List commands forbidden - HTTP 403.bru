meta {
  name: GET /commands - List commands forbidden - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/commands
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("unprivileged cannot list commands.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
