meta {
  name: POST /monitoring/resources/submit - Submit result - HTTP 204
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/monitoring/resources/submit
  body: json
  auth: inherit
}

body:json {
  {
    "resources": [
      {
        "type": "host",
        "id": {{Host1Id}},
        "parent": null,
        "status": 0,
        "output": "Host OK"
      },
      {
        "type": "service",
        "id": {{Service1Id}},
        "parent": {
          "id": {{Host1Id}}
        },
        "status": 0,
        "output": "Service OK"
      }
    ]
  }
}

tests {
  test("administrator access depends on ACL (not recomputed in CI): allowed or denied (403/404 when the resource is ACL-filtered).", function () {
    expect(res.status).to.be.oneOf([204, 403, 404]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
