meta {
  name: POST /authentication/providers/configurations/local - Session login without REST API access - HTTP 200
  type: http
  seq: 5
}

post {
  url: {{protocol}}://{{server}}:{{portWeb}}/centreon/authentication/providers/configurations/local
  body: json
  auth: none
}

body:json {
  {
    "login": "{{NoRestUserLogin}}",
    "password": "{{NoRestUserPassword}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Session cookie received.", function () {
    const cookies = [].concat(res.getHeader("set-cookie") || []);
    const session = cookies.map((c) => c.split(";")[0]).find((c) => c.startsWith("PHPSESSID="));
    expect(session).to.be.a("string");
    bru.setVar("noRestSessionCookie", session);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
