meta {
  name: POST /internal.php - Results acceptor with a line break in service - HTTP 400
  type: http
  seq: 11
}

post {
  url: {{baseUriCentreonApiWeb}}/internal.php?object=centreon_results_acceptor&action=submit
  body: json
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

script:pre-request {
  bru.setVar("updateTime", Math.floor(Date.now() / 1000));
}

body:json {
  {
    "results": [
      {
        "host": "{{ResultHostName}}",
        "service": "{{ResultServiceName}}",
        "status": 0,
        "updatetime": {{updateTime}},
        "output": "Service OK"
      },
      {
        "host": "{{ResultHostName}}",
        "service": "line one\nline two",
        "status": 0,
        "updatetime": {{updateTime}},
        "output": "Service OK"
      }
    ]
  }
}

assert {
  res.status: eq 400
}

tests {
  test("The whole batch is refused.", function () {
    expect(res.getBody()).to.equal('Invalid characters in field "service".');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
