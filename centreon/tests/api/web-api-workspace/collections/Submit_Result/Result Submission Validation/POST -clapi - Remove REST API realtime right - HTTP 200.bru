meta {
  name: POST /clapi - Remove REST API realtime right - HTTP 200
  type: http
  seq: 4
}

post {
  url: {{baseUriCentreonCLAPI}}
  body: json
  auth: none
}

headers {
  centreon-auth-token: {{authToken}}
}

body:json {
  {
    "action": "setparam",
    "object": "CONTACT",
    "values": "{{NoRestUserLogin}};reach_api_rt;0"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
