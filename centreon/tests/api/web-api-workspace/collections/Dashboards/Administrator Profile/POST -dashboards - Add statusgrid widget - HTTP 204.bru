meta {
  name: POST /dashboards - Add statusgrid widget - HTTP 204
  type: http
  seq: 3
}

post {
  url: {{baseUrlWeb}}/configuration/dashboards/{{dashboardID}}
  body: multipart-form
  auth: inherit
}

body:multipart-form {
  panels[0][name]: centreon-widget-statusgrid
  panels[0][widget_type]: /widgets/statusgrid
  panels[0][layout][x]: 0
  panels[0][layout][y]: 0
  panels[0][layout][width]: 5
  panels[0][layout][height]: 3
  panels[0][layout][min_width]: 2
  panels[0][layout][min_height]: 2
  panels[0][widget_settings]: {"data":{"resources":[{"resourceType":"host","resources":[{"id":14,"name":"Centreon-Server"}]}]},"options":{"viewMode":"standard","resourceType":"service","statuses":["warning","problem","pending","success","undefined"],"sortBy":"status_severity_code","tiles":100,"refreshInterval":"default","description":{"content":"{\"root\":{\"children\":[{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}}","enabled":true}}}
}

assert {
  res.status: eq 204
}

tests {
  test("Statusgrid widget added successfully.", function () {
    expect(res.status).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
