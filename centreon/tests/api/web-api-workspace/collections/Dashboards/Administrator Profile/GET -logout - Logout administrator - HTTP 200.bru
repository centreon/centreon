meta {
  name: GET /logout - Logout administrator - HTTP 200
  type: http
  seq: 24
}

get {
  url: {{baseUrlWeb}}/logout
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

script:after-response {
  bru.deleteEnvVar("authToken");
}

tests {
  test("Logout successful.", function () {
    const body = res.getBody();
    expect(res.status).to.equal(200);
    expect(body.message).to.equal("Successful logout");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
