meta {
  name: POST /dashboards - Add topbottom widget - HTTP 204
  type: http
  seq: 11
}

post {
  url: {{baseUrlWeb}}/configuration/dashboards/{{dashboardID}}
  body: json
  auth: inherit
}

body:json {
  {
    "panels": [
      {
        "id": null,
        "name": "centreon-widget-topbottom",
        "widget_type": "/widgets/topbottom",
        "layout": { "x": 0, "y": 0, "width": 5, "height": 3, "min_width": 2, "min_height": 2 },
        "widget_settings": "{\"data\":{\"resources\":[{\"resourceType\":\"host\",\"resources\":[{\"id\":14,\"name\":\"Centreon-Server\"}]}],\"metrics\":[{\"id\":3,\"name\":\"rtmax\",\"unit\":\"ms\",\"includeAllMetrics\":true}]},\"options\":{\"topBottomSettings\":{\"numberOfValues\":10,\"order\":\"top\",\"showLabels\":true},\"valueFormat\":\"human\",\"refreshInterval\":\"default\"}}"
      }
    ]
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Topbottom widget added successfully.", function () {
    expect(res.status).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
