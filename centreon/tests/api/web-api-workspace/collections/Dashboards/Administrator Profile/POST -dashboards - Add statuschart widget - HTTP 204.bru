meta {
  name: POST /dashboards - Add statuschart widget - HTTP 204
  type: http
  seq: 17
}

post {
  url: {{baseUrlWeb}}/configuration/dashboards/{{dashboardID}}
  body: json
  auth: inherit
}

body:json {
  {
    "panels": [
      {
        "id": null,
        "name": "centreon-widget-statuschart",
        "widget_type": "/widgets/statuschart",
        "layout": { "x": 0, "y": 0, "width": 5, "height": 3, "min_width": 2, "min_height": 2 },
        "widget_settings": "{\"data\":{\"resources\":[{\"resourceType\":\"host\",\"resources\":[{\"id\":14,\"name\":\"Centreon-Server\"}]}]},\"options\":{\"displayType\":\"pie\",\"resourceTypes\":[\"host\",\"service\"],\"unit\":\"percentage\",\"displayValues\":true,\"displayLegend\":true,\"refreshInterval\":\"default\"}}"
      }
    ]
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Statuschart widget added successfully.", function () {
    expect(res.status).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
