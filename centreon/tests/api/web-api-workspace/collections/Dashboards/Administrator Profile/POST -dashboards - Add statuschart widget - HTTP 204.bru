meta {
  name: POST /dashboards - Add statuschart widget - HTTP 204
  type: http
  seq: 17
}

post {
  url: {{baseUrlWeb}}/configuration/dashboards/{{dashboardID}}
  body: multipart-form
  auth: inherit
}

body:multipart-form {
  panels[0][name]: centreon-widget-statuschart
  panels[0][widget_type]: /widgets/statuschart
  panels[0][layout][x]: 0
  panels[0][layout][y]: 0
  panels[0][layout][width]: 5
  panels[0][layout][height]: 3
  panels[0][layout][min_width]: 2
  panels[0][layout][min_height]: 2
  panels[0][widget_settings]: {"data":{"resources":[{"resourceType":"host","resources":[{"id":14,"name":"Centreon-Server"}]}]},"options":{"displayType":"pie","resourceTypes":["host","service"],"unit":"percentage","displayValues":true,"displayLegend":true,"refreshInterval":"default","description":{"content":"{\"root\":{\"children\":[{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}}","enabled":true},"name":""}}
}

assert {
  res.status: eq 204
}

tests {
  test("Statuschart widget added successfully.", function () {
    expect(res.status).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
