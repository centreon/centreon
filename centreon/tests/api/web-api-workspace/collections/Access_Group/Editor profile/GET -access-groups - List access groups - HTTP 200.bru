meta {
  name: GET /access-groups - List access groups - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/access-groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("The access groups visible to the editor are listed.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
