meta {
  name: GET /access-groups - Get AG forbidden - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/access-groups
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot list access groups.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("code").that.equals(403);
    expect(body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
