meta {
  name: GET /monitoring/severities/host - List host severities - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/monitoring/severities/host
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Administrator profile can list real-time host severities.", function () {
    const body = res.getBody();
    expect(body).to.have.property("result").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
