meta {
  name: GET /platform/topology - Get platform topology - HTTP 200
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/platform/topology
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Administrator can list platform topology.", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
