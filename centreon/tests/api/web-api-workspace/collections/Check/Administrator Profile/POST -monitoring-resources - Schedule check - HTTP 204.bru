meta {
  name: POST /monitoring/resources/check - Schedule check - HTTP 204
  type: http
  seq: 2
}

post {
  url: {{baseUrlWeb}}/monitoring/resources/check
  body: json
  auth: inherit
}

body:json {
  {
    "check": {
      "is_forced": true
    },
    "resources": [
      {
        "type": "host",
        "id": {{Host1Id}},
        "parent": null
      },
      {
        "type": "service",
        "id": {{Service1Id}},
        "parent": {
          "id": {{Host1Id}}
        }
      }
    ]
  }
}

tests {
  test("administrator access depends on ACL (not recomputed in CI): allowed or denied (403/404 when the resource is ACL-filtered).", function () {
    expect(res.status).to.be.oneOf([204, 403, 404]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
