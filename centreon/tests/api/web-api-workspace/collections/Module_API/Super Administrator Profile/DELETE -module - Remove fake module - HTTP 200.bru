meta {
  name: DELETE centreon_module remove fake-module-to-test-api - HTTP 200
  type: http
  seq: 5
}

delete {
  url: {{baseUriCentreonApiWeb}}/index.php?object=centreon_module&action=remove&id=fake-module-to-test-api&type=module
  body: none
  auth: none
}

headers {
