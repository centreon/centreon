meta {
  name: GET /openid - Get OpenID configuration forbidden - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/administration/authentication/providers/openid
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot read the OpenID provider configuration.", function () {

    expect(res.status).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
