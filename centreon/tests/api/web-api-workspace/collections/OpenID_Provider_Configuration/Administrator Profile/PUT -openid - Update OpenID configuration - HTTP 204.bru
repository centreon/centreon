meta {
  name: PUT /openid - Update OpenID configuration - HTTP 204
  type: http
  seq: 4
}

put {
  url: {{baseUrlWeb}}/administration/authentication/providers/openid
  body: json
  auth: inherit
}

body:json {
  {
    "is_active": false,
    "is_forced": false,
    "base_url": "https://localhost:8080",
    "authorization_endpoint": "/authorize",
    "token_endpoint": "/token",
    "introspection_token_endpoint": null,
    "userinfo_endpoint": "/userinfo",
    "endsession_endpoint": "/logout",
    "connection_scopes": ["openid"],
    "login_claim": "preferred_username",
    "client_id": "centreon-test",
    "client_secret": "test-secret",
    "authentication_type": "client_secret_post",
    "verify_peer": false,
    "auto_import": false,
    "contact_template": null,
    "email_bind_attribute": null,
    "fullname_bind_attribute": null,
    "redirect_url": null,
    "authentication_conditions": {
      "is_enabled": false,
      "attribute_path": "",
      "endpoint": { "type": "introspection_endpoint", "custom_endpoint": null },
      "authorized_values": [],
      "trusted_client_addresses": [],
      "blacklist_client_addresses": []
    },
    "roles_mapping": {
      "is_enabled": false,
      "apply_only_first_role": false,
      "attribute_path": "",
      "endpoint": { "type": "introspection_endpoint", "custom_endpoint": null },
      "relations": []
    },
    "groups_mapping": {
      "is_enabled": false,
      "attribute_path": "",
      "endpoint": { "type": "introspection_endpoint", "custom_endpoint": null },
      "relations": []
    }
  }
}

assert {
  res.status: eq 204
}

tests {
  test("OpenID configuration updated successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
