meta {
  name: GET /openid - Get OpenID configuration - HTTP 200
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/administration/authentication/providers/openid
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Response schema is valid", function () {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("is_active");
    expect(body).to.have.property("client_id");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
