meta {
  name: PATCH /openid - Partial update OpenID configuration - HTTP 204
  type: http
  seq: 5
}

patch {
  url: {{baseUrlWeb}}/administration/authentication/providers/openid
  body: json
  auth: inherit
}

body:json {
  {
    "is_active": false
  }
}

assert {
  res.status: eq 204
}

tests {
  test("OpenID configuration partially updated successfully.", function () {
    const body = res.getBody();
    expect(body).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
