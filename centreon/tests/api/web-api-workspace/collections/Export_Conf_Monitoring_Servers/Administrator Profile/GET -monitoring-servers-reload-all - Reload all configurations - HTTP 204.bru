meta {
  name: GET /monitoring-servers/reload - Reload all configurations - HTTP 204
  type: http
  seq: 7
}

get {
  url: {{baseUrlWeb}}/configuration/monitoring-servers/reload
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

tests {
