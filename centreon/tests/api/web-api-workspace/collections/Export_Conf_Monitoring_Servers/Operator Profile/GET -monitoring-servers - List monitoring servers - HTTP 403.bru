meta {
  name: GET /monitoring-servers - List monitoring servers - HTTP 403
  type: http
  seq: 3
}

get {
  url: {{baseUrlWeb}}/configuration/monitoring-servers
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Operator cannot list monitoring servers.", function () {
    const body = res.getBody();
    expect(body).to.have.property("code").that.equals(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
