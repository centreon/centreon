meta {
  name: GET /monitoring-servers - List monitoring servers - HTTP 403
  type: http
  seq: 2
}

get {
  url: {{baseUrlWeb}}/configuration/monitoring-servers
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
}

tests {
  test("Unprivileged user cannot list monitoring servers.", function () {
    expect(res.status).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
