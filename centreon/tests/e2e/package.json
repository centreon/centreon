{
  "name": "centreon",
  "version": "25.10.0",
  "description": "Cypress end-to-end tests for centreon",
  "scripts": {
    "cypress:open": "TESTCONTAINERS_RYUK_DISABLED=true cypress open --config-file cypress.dev.config.ts --e2e",
    "cypress:run": "TESTCONTAINERS_RYUK_DISABLED=true TS_NODE_PROJECT=tsconfig.json cypress run --env tags='not @ignore' --config-file cypress.config.ts --e2e",
    "cypress:run:develop:debug": "DEBUG=cypress:* cypress run --config-file cypress.dev.json 2> ./cypress/results/logs.txt",
    "cypress:open:dev": "cypress open --config-file cypress.dev.config.ts --e2e",
    "lint": "biome check ./features",
    "lint:fix": "pnpm lint --fix",
    "lint:ci": "biome ci ./features --error-on-warnings",
    "gherkinlint": "pnpm gherkin-lint -c ../../../.github/actions/gherkin-lint/.gherkin-lintrc ./features/",
    "ts:checks": "tsc --noEmit"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.0.2",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.3",
    "@biomejs/biome": "1.9.4",
    "@centreon/js-config": "24.12.1",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@swc/core": "^1.9.3",
    "@types/cypress": "^1.1.3",
    "@types/cypress-cucumber-preprocessor": "^4.0.5",
    "@types/node": "^20.11.27",
    "@types/ramda": "0.29.11",
    "cross-env": "^7.0.3",
    "cypress": "~13.16.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "cypress-multi-reporters": "^1.6.4",
    "cypress-on-fix": "^1.0.3",
    "cypress-real-events": "^1.13.0",
    "cypress-terminal-report": "^5.3.10",
    "cypress-wait-until": "^3.0.2",
    "dotenv": "^16.4.5",
    "gherkin-lint": "^4.2.4",
    "mochawesome": "^7.1.3",
    "mysql2": "^3.11.4",
    "path": "^0.12.7",
    "ramda": "0.29.1",
    "shell-exec": "^1.1.2",
    "swc-loader": "^0.2.3",
    "tar-fs": "^3.0.6",
    "testcontainers": "^10.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webpack": "^5.96.1"
  },
  "cypress-cucumber-preprocessor": {
    "filterSpecs": false,
    "nonGlobalStepDefinitions": true,
    "omitFiltered": true,
    "json": {
      "enabled": true,
      "output": "results/cucumber-logs/report.json"
    },
    "pretty": {
      "enabled": true
    }
  }
}