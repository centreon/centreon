{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <!-- Section: MIB import -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.title}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mnftr.html}
                    <label class="cf-label-float">{$form.mnftr.label}</label>
                    <img class="helpTooltip" name="vendor">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.filename.html}
                    <label class="cf-label-float">{$form.filename.label}</label>
                    <img class="helpTooltip" name="filename">
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if isset($form.generate)}
            {$form.generate.html}
        {/if}
        {$form.submit.html}
        {if isset($form.reset)}
            {$form.reset.html}
        {/if}
    </div>

    {if isset($msg)}
    <!-- Section: Status -->
    <div class="cf-section" id="cf-sec-status">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.status}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">{$msg}</div>
        </div>
    </div>
    {/if}

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}
