{$form.javascript}
<link href="./include/common/form/form.css" rel="stylesheet" type="text/css" />

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-links" onclick="cfScrollTo('cf-sec-links', this); return false;">{$form.header.links}</a>
    </div>

    <!-- Section: General Information -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.sc_name.html}
                    <label class="cf-label-float">{$form.sc_name.label}</label>
                    <img class="helpTooltip" name="name">
                </div>
                <div class="cf-field">
                    {$form.sc_description.html}
                    <label class="cf-label-float">{$form.sc_description.label}</label>
                    <img class="helpTooltip" name="description">
                </div>
                <div class="cf-toggle-row" style="flex:0;white-space:nowrap;">
                    <span>{$form.sc_activate.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-sc-activate-toggle" />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.sc_activate.html}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Links -->
    <div class="cf-section" id="cf-sec-links">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.links}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.sc_svcTpl.html}
                    <label class="cf-label-float">{$form.sc_svcTpl.label}</label>
                    <img class="helpTooltip" name="service_template">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-toggle-row">
                    <span>{$form.sc_type.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-sc-type-toggle" onchange="document.getElementById('sc_type').checked=this.checked; toggleSeverityFields();" />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.sc_type.html}</span>
                    <img class="helpTooltip" name="sc_type">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" id="severity_level" style="max-width:200px;">
                    {$form.sc_severity_level.html}
                    <label class="cf-label-float">{$form.sc_severity_level.label}</label>
                    <img class="helpTooltip" name="sc_severity_level">
                </div>
                <div class="cf-field" id="severity_icon">
                    {$form.sc_severity_icon.html}&nbsp;<img id='icon_id_ctn' src='./img/blank.gif' height='16' width='16'>
                    <label class="cf-label-float">{$form.sc_severity_icon.label}</label>
                    <img class="helpTooltip" name="sc_severity_icon">
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c" || $o == "mc"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {elseif isset($form.submitMC)}
                {$form.submitMC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

<script type='text/javascript' src='./include/common/javascript/showLogo.js'></script>
{literal}
<script type="text/javascript">
// Severity toggle — page-specific logic
function toggleSeverityFields() {
    if (jQuery('#sc_type').prop('checked')) {
        jQuery('#severity_level').show();
        jQuery('#severity_icon').show();
    } else {
        jQuery('#severity_level').hide();
        jQuery('#severity_icon').hide();
    }
}

jQuery(function() {
    showLogo('icon_id_ctn', document.getElementById('icon_id').value);
    var sevToggle = document.getElementById('cf-sc-type-toggle');
    var sevCheckbox = document.getElementById('sc_type');
    if (sevToggle && sevCheckbox) sevToggle.checked = sevCheckbox.checked;
    jQuery('#sc_type').click(function() { toggleSeverityFields(); });
    toggleSeverityFields();
});

document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
    CentreonForm.syncToggle('cf-sc-activate-toggle', 'sc_activate', '1', '0');
});
</script>
{/literal}
