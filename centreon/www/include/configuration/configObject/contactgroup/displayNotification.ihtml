<script type="text/javascript" src="./include/common/javascript/tool.js"></script>
<link href="./include/common/listing/listing.css" rel="stylesheet" type="text/css" />

{literal}
<style>
    body { background: #fff; margin: 0; }
    .dn-wrap { padding: 16px 18px; }
    .dn-title { font-size: 16px; font-weight: 600; color: var(--c-text-primary, #255891); margin: 0 0 14px; }
    .dn-filter { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .dn-filter label { font-size: 13px; font-weight: 600; color: var(--c-text-secondary, #6b7280); white-space: nowrap; }
    .dn-filter select { flex: 1; min-width: 0; height: 38px; border: 1px solid var(--c-stroke, #d0d5dd); border-radius: 6px; padding: 0 10px; background: #fff; font-size: 14px; }
    .dn-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .dn-chip { display: inline-block; padding: 4px 12px; border-radius: 14px; background: rgba(46,104,170,.10); color: #255891; font-size: 12px; font-weight: 600; text-decoration: none; }
    .dn-chip:hover { background: rgba(46,104,170,.20); }
    .dn-table-wrap { margin-bottom: 20px; }
    .dn-host-ico { color: var(--c-primary-main, #2E68AA); vertical-align: middle; margin-right: 8px; }
    .dn-empty { text-align: center; padding: 28px; color: var(--c-text-secondary, #6b7280); }
    .cl-listing-table { width: 100%; }
</style>
{/literal}

<form name='form' method='POST'>
<div class="dn-wrap">

    <div class="dn-filter">
        {$form.contact.label}
        {$form.contact.html}
        <input name="o" value="dn" type="hidden">
    </div>

    <div class="dn-nav">
        <a class="dn-chip" href='#host_escalation'>{$labels.host_escalation}</a>
        <a class="dn-chip" href='#service_escalation'>{$labels.service_escalation}</a>
        <a class="dn-chip" href='#simple_host'>{$labels.host_notifications}</a>
        <a class="dn-chip" href='#simple_service'>{$labels.service_notifications}</a>
    </div>

    {if $contact == 0}
        <div class="dn-empty">{$msgSelect}</div>
    {else}

    <div class="dn-table-wrap">
        <a name='host_escalation'></a>
        <table class="cl-listing-table">
            <thead><tr><th>{$headerMenu_host_esc}</th></tr></thead>
            <tbody>
            {section name=elem loop=$elemArrHostEsc}
            {assign var=host value=$elemArrHostEsc[elem].RowMenu_host}
            <tr>
                <td>{if $host != $hostOld}<svg class="dn-host-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><line x1="6" y1="6.5" x2="6.02" y2="6.5"/><line x1="6" y1="17.5" x2="6.02" y2="17.5"/></svg>{$elemArrHostEsc[elem].RowMenu_host}{else}&nbsp;{/if}</td>
            </tr>
            {sectionelse}
            <tr><td class="dn-empty">-</td></tr>
            {/section}
            </tbody>
        </table>
    </div>

    <div class="dn-table-wrap">
        <a name='service_escalation'></a>
        <table class="cl-listing-table">
            <thead><tr><th>{$headerMenu_host}</th><th>{$headerMenu_service_esc}</th></tr></thead>
            <tbody>
            {section name=elem loop=$elemArrSvcEsc}
            {assign var=host value=$elemArrSvcEsc[elem].RowMenu_host}
            <tr>
                <td>{if $host != $hostOld}<svg class="dn-host-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><line x1="6" y1="6.5" x2="6.02" y2="6.5"/><line x1="6" y1="17.5" x2="6.02" y2="17.5"/></svg>{$elemArrSvcEsc[elem].RowMenu_host}{else}&nbsp;{/if}</td>
                <td>{$elemArrSvcEsc[elem].RowMenu_service}</td>
            </tr>
            {assign var=hostOld value=$elemArrSvc[elem].RowMenu_host}
            {sectionelse}
            <tr><td colspan="2" class="dn-empty">-</td></tr>
            {/section}
            </tbody>
        </table>
    </div>

    <div class="dn-table-wrap">
        <a name='simple_host'></a>
        <table class="cl-listing-table">
            <thead><tr><th>{$headerMenu_host}</th></tr></thead>
            <tbody>
            {section name=elem loop=$elemArrHost}
            {assign var=host value=$elemArrHost[elem].RowMenu_host}
            <tr>
                <td>{if $host != $hostOld}<svg class="dn-host-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><line x1="6" y1="6.5" x2="6.02" y2="6.5"/><line x1="6" y1="17.5" x2="6.02" y2="17.5"/></svg>{$elemArrHost[elem].RowMenu_host}{else}&nbsp;{/if}</td>
            </tr>
            {sectionelse}
            <tr><td class="dn-empty">-</td></tr>
            {/section}
            </tbody>
        </table>
    </div>

    <div class="dn-table-wrap">
        <a name='simple_service'></a>
        <table class="cl-listing-table">
            <thead><tr><th>{$headerMenu_host}</th><th>{$headerMenu_service}</th></tr></thead>
            <tbody>
            {section name=elem loop=$elemArrSvc}
            {assign var=host value=$elemArrSvc[elem].RowMenu_host}
            <tr>
                <td>{if $host != $hostOld}<svg class="dn-host-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><line x1="6" y1="6.5" x2="6.02" y2="6.5"/><line x1="6" y1="17.5" x2="6.02" y2="17.5"/></svg>{$elemArrSvc[elem].RowMenu_host}{else}&nbsp;{/if}</td>
                <td>{$elemArrSvc[elem].RowMenu_service}</td>
            </tr>
            {assign var=hostOld value=$elemArrSvc[elem].RowMenu_host}
            {sectionelse}
            <tr><td colspan="2" class="dn-empty">-</td></tr>
            {/section}
            </tbody>
        </table>
    </div>

    {/if}
{$form.hidden}
</div>
</form>
