{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-members" onclick="cfScrollTo('cf-sec-members', this); return false;">{$form.header.notification}</a>
        <a href="#cf-sec-additional" onclick="cfScrollTo('cf-sec-additional', this); return false;">{$form.header.furtherInfos}</a>
    </div>

    <!-- Section: General Information -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.cg_name.html}
                    <label class="cf-label-float">{$form.cg_name.label}</label>
                    <img class="helpTooltip" name="contactgroup_name">
                </div>
                <div class="cf-field">
                    {$form.cg_alias.html}
                    <label class="cf-label-float">{$form.cg_alias.label}</label>
                    <img class="helpTooltip" name="alias">
                </div>
                <div class="cf-toggle-row">
                    <span>{$form.cg_activate.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-cg-activate-toggle"{if $cgActivateOn} checked{/if}{if $o == "w"} disabled{/if} />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.cg_activate.html}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Members -->
    <div class="cf-section" id="cf-sec-members">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.notification}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    <p class="oreonbutton">{$form.cg_contacts.html}</p>
                    <label class="cf-label-float">{$form.cg_contacts.label}</label>
                    <img class="helpTooltip" name="members">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    <p class="oreonbutton">{$form.cg_acl_groups.html}</p>
                    <label class="cf-label-float">{$form.cg_acl_groups.label}</label>
                    <img class="helpTooltip" name="acl_groups">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Additional Information -->
    <div class="cf-section" id="cf-sec-additional">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.furtherInfos}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.cg_comment.html}
                    <label class="cf-label-float">{$form.cg_comment.label}</label>
                </div>
            </div>
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
    CentreonForm.syncToggle('cf-cg-activate-toggle', 'cg_activate', '1', '0');
});
</script>
{/literal}
