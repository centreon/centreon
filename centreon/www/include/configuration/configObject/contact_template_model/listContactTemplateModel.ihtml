<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

<form name='form' method='POST'>
    <div class="cl-listing-container">
        <div class="cl-actions-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="{$msg.addL}" class="cl-btn-add">{$msg.addT}</a>
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-search-center">
                <input type="text" id="clSearchInput" name="searchCT" value="{$searchCT}" placeholder="{t}Search{/t}" class="cl-search-input">
                <button type="button" id="clSearchBtn" class="btc bt_success">{t}Search{/t}</button>
            </div>
            <div class="cl-pagination" id="clPaginationTop"></div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="ctListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_desc}</th>
                    <th>{$headerMenu_name}</th>
                    <th class="cl-col-center">{$headerMenu_hostNotif}</th>
                    <th class="cl-col-center">{$headerMenu_svNotif}</th>
                    <th class="cl-col-right">{$headerMenu_options}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="6" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

        <div class="cl-bottom-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                {$form.o2.html}
            </div>
            { else }
            <div>&nbsp;</div>
            { /if }
            <div class="cl-pagination" id="clPaginationBottom"></div>
        </div>
    </div>

<input type='hidden' name='o' id='o' value='42'>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

{literal}
<script type="text/javascript">
var ctListing = new CentreonListing({
    instanceName:  'ctListing',
    ajaxListUrl:   './include/configuration/configObject/contact_template_model/ajaxContactTemplateListing.php',
    ajaxToggleUrl: './include/configuration/configObject/contact_template_model/ajaxContactTemplateToggle.php',
    pageId:        {/literal}'{$ctPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'ct_listing_limit',
    emptyMessage:  'No contact templates found',
    autoRefresh:   30000,
    rowIdField:    'id',
    columns: [
        { id:'alias', render: function(row, l) {
            var link = 'main.php?p={/literal}{$ctPage}{literal}&o=c&contact_id=' + row.id;
            return '<a href="'+link+'"><img src="./img/icons/user-template.svg" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;" title="Contact template" />'+l.escape(row.alias||'')+'</a>';
        }},
        { id:'name', render: function(row, l) {
            var link = 'main.php?p={/literal}{$ctPage}{literal}&o=c&contact_id=' + row.id;
            return '<a href="'+link+'">'+l.escape(row.name)+'</a>';
        }},
        { id:'host_notif_tp', align:'center' },
        { id:'svc_notif_tp', align:'center' }
    ],
    renderOptions: function(row, l) {
        var checked = row.activate ? ' checked' : '';
        return '<label class="cl-toggle"><input type="checkbox" data-row-id="'+row.id+'"'+checked+' onchange="ctListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
    }
});
ctListing.init();
</script>
{/literal}
