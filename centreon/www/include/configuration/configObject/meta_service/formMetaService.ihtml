{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}

{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-check" onclick="cfScrollTo('cf-sec-check', this); return false;">{$form.header.check}</a>
        {if ! $isCloudPlatform}
        <a href="#cf-sec-notif" onclick="cfScrollTo('cf-sec-notif', this); return false;">{$form.header.notification}</a>
        {/if}
        <a href="#cf-sec-extended" onclick="cfScrollTo('cf-sec-extended', this); return false;">{$form.header.furtherInfos}</a>
    </div>

    <!-- Section: General Information -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.meta_name.html}
                    <label class="cf-label-float">{$form.meta_name.label}</label>
                    <img class="helpTooltip" name="name">
                </div>
                <div class="cf-field">
                    {$form.meta_display.html}
                    <label class="cf-label-float">{$form.meta_display.label}</label>
                    <img class="helpTooltip" name="display">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.warning.html}
                    <label class="cf-label-float">{$form.warning.label}</label>
                    <img class="helpTooltip" name="warning">
                </div>
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.critical.html}
                    <label class="cf-label-float">{$form.critical.label}</label>
                    <img class="helpTooltip" name="critical">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.calcul_type.html}
                    <label class="cf-label-float">{$form.calcul_type.label}</label>
                    <img class="helpTooltip" name="calcul_type">
                </div>
                <div class="cf-field">
                    {$form.data_source_type.html}
                    <label class="cf-label-float">{$form.data_source_type.label}</label>
                    <img class="helpTooltip" name="data_source_type">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.meta_select_mode.html}
                    <label class="cf-label-float">{$form.meta_select_mode.label}</label>
                    <img class="helpTooltip" name="select_mode">
                </div>
            </div>
            <div class="cf-row" id="row_regexp_str">
                <div class="cf-field">
                    {$form.regexp_str.html}
                    <label class="cf-label-float">{$form.regexp_str.label}</label>
                    <img class="helpTooltip" name="regexp">
                </div>
            </div>
            <div class="cf-row" id="row_metric">
                <div class="cf-field">
                    {$form.metric.html}
                    <label class="cf-label-float">{$form.metric.label}</label>
                    <img class="helpTooltip" name="metric">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Check options -->
    <div class="cf-section" id="cf-sec-check">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.check}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.check_period.html}
                    <label class="cf-label-float">{$form.check_period.label}</label>
                    <img class="helpTooltip" name="check_period">
                </div>
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.max_check_attempts.html}
                    <label class="cf-label-float">{$form.max_check_attempts.label}</label>
                    <img class="helpTooltip" name="max_check_attempts">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.normal_check_interval.html}
                    <label class="cf-label-float">{$form.normal_check_interval.label}</label>
                    <small class="cf-unit">{$time_unit}</small>
                    <img class="helpTooltip" name="check_interval">
                </div>
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.retry_check_interval.html}
                    <label class="cf-label-float">{$form.retry_check_interval.label}</label>
                    <small class="cf-unit">{$time_unit}</small>
                    <img class="helpTooltip" name="retry_interval">
                </div>
            </div>
        </div>
    </div>

    {if ! $isCloudPlatform}
    <!-- Section: Notification -->
    <div class="cf-section" id="cf-sec-notif">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.notification}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.notifications_enabled.html}
                    <label class="cf-label-float">{$form.notifications_enabled.label}</label>
                    <img class="helpTooltip" name="notifications_enabled">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.ms_cs.html}
                    <label class="cf-label-float">{$form.ms_cs.label}</label>
                    <img class="helpTooltip" name="contacts">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.ms_cgs.html}
                    <label class="cf-label-float">{$form.ms_cgs.label}</label>
                    <img class="helpTooltip" name="contact_groups">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.notification_interval.html}
                    <label class="cf-label-float">{$form.notification_interval.label}</label>
                    <small class="cf-unit">{$time_unit}</small>
                    <img class="helpTooltip" name="notification_interval">
                </div>
                <div class="cf-field">
                    {$form.notification_period.html}
                    <label class="cf-label-float">{$form.notification_period.label}</label>
                    <img class="helpTooltip" name="notification_period">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.ms_notifOpts.html}
                    <label class="cf-label-float">{$form.ms_notifOpts.label}</label>
                    <img class="helpTooltip" name="notification_options">
                </div>
            </div>
        </div>
    </div>
    {/if}

    <!-- Section: Additional information -->
    <div class="cf-section" id="cf-sec-extended">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.furtherInfos}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.geo_coords.html}
                    <label class="cf-label-float">{$form.geo_coords.label}</label>
                    <img class="helpTooltip" name="geo_coords">
                </div>
                <div class="cf-field">
                    {$form.graph_id.html}
                    <label class="cf-label-float">{$form.graph_id.label}</label>
                    <img class="helpTooltip" name="graph_template">
                </div>
                <div class="cf-toggle-row">
                    <span>{$form.meta_activate.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-meta-activate-toggle" />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.meta_activate.html}</span>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.meta_comment.html}
                    <label class="cf-label-float">{$form.meta_comment.label}</label>
                </div>
            </div>
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
    CentreonForm.syncToggle('cf-meta-activate-toggle', 'meta_activate', '1', '0');

    // Reset restores the radios but not the visibility flip; re-run on next tick.
    var form = document.forms['Form'];
    if (form) {
        form.addEventListener('reset', function () {
            setTimeout(function () {
                var checked = document.querySelector('input[name="meta_select_mode[meta_select_mode]"]:checked');
                if (checked) { checked.dispatchEvent(new Event('change')); }
            }, 0);
        });
    }
});
</script>
{/literal}
{$toggleScript}
