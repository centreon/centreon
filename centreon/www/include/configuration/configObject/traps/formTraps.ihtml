{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-def" class="active" onclick="cfScrollTo('cf-sec-def', this); return false;">{$tabTitle_1}</a>
        <a href="#cf-sec-relations" onclick="cfScrollTo('cf-sec-relations', this); return false;">{$tabTitle_2}</a>
        <a href="#cf-sec-advanced" onclick="cfScrollTo('cf-sec-advanced', this); return false;">{$tabTitle_3}</a>
    </div>

    <!-- ================================================================ -->
    <!-- Section 1: Trap definition (was tab1)                            -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-def">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$subtitle0}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field cf-field--md">
                    {$form.traps_name.html}
                    <label class="cf-label-float">{$form.traps_name.label}</label>
                    <img class="helpTooltip" name="trapname">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_mode.html}
                    <label class="cf-label-float">{$form.traps_mode.label}</label>
                    <img class="helpTooltip" name="mode">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.traps_oid.html}
                    <label class="cf-label-float">{$form.traps_oid.label}</label>
                    <img class="helpTooltip" name="oid">
                </div>
                <div class="cf-field">
                    {$form.manufacturer_id.html}
                    <label class="cf-label-float">{$form.manufacturer_id.label}</label>
                    <img class="helpTooltip" name="vendor">
                </div>
            </div>

            <div class="cf-subsection cf-subsection--gap">{$subtitle1}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_args.html}
                    <label class="cf-label-float">{$form.traps_args.label}</label>
                    <img class="helpTooltip" name="trap_args">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field cf-field--xs">
                    {$form.traps_status.html}
                    <label class="cf-label-float">{$form.traps_status.label}</label>
                    <img class="helpTooltip" name="trap_status">
                </div>
                <div class="cf-field cf-field--xs">
                    {$form.severity.html}
                    <label class="cf-label-float">{$form.severity.label}</label>
                    <img class="helpTooltip" name="severity">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_advanced_treatment.html}
                    <label class="cf-label-float">{$form.traps_advanced_treatment.label}</label>
                    <img class="helpTooltip" name="trap_advanced">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_advanced_treatment_default.html}
                    <label class="cf-label-float">{$form.traps_advanced_treatment_default.label}</label>
                    <img class="helpTooltip" name="traps_advanced_treatment_default">
                </div>
            </div>
            <div class="cf-row">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <img class="helpTooltip" name="trap_adv_args">
                    <span style="font-size:13px;font-weight:600;color:var(--list-color,#333);">{$trap_adv_args}</span>
                </div>
                {include file="file:$centreon_path/www/include/common/templates/clone.ihtml" cloneId="matchingrules" cloneSet=$cloneSetMaching}
            </div>

            <div class="cf-subsection">{$subtitle2}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_submit_result_enable.html}
                    <label class="cf-label-float">{$form.traps_submit_result_enable.label}</label>
                    <img class="helpTooltip" name="submit_result_enabled">
                </div>
            </div>

            <div class="cf-subsection">{$subtitle3}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_reschedule_svc_enable.html}
                    <label class="cf-label-float">{$form.traps_reschedule_svc_enable.label}</label>
                    <img class="helpTooltip" name="reschedule_enabled">
                </div>
            </div>

            <div class="cf-subsection">{$subtitle4}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_execution_command_enable.html}
                    <label class="cf-label-float">{$form.traps_execution_command_enable.label}</label>
                    <img class="helpTooltip" name="command_enabled">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_execution_command.html}
                    <label class="cf-label-float">{$form.traps_execution_command.label}</label>
                    <img class="helpTooltip" name="command_args">
                </div>
            </div>

            <div class="cf-subsection">{$subtitle5}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_comments.html}
                    <label class="cf-label-float">{$form.traps_comments.label}</label>
                    <img class="helpTooltip" name="comments">
                </div>
            </div>
            {if isset($form.required)}
            <div class="cf-row"><small>{$form.required._note}</small></div>
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 2: Relations (was tab2)                                  -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-relations">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$resourceTxt}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {if isset($form.host_filter)}{$form.host_filter.html}{/if}
                    {$form.services.html}
                    <label class="cf-label-float">{$serviceTxt}</label>
                    <img class="helpTooltip" name="services">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_templates.html}
                    <label class="cf-label-float">{$serviceTemplateTxt}</label>
                    <img class="helpTooltip" name="service_templates">
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 3: Advanced (was tab3)                                   -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-advanced">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$routingDefTxt}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_routing_mode.html}
                    <label class="cf-label-float">{$form.traps_routing_mode.label}</label>
                    <img class="helpTooltip" name="traps_routing_mode">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_routing_value.html}
                    <label class="cf-label-float">{$form.traps_routing_value.label}</label>
                    <img class="helpTooltip" name="traps_routing_value">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_routing_filter_services.html}
                    <label class="cf-label-float">{$form.traps_routing_filter_services.label}</label>
                    <img class="helpTooltip" name="traps_routing_filter_services">
                </div>
            </div>

            <div class="cf-subsection">{$preexecTxt}</div>
            <div class="cf-row">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <img class="helpTooltip" name="preexeccmd">
                    <span style="font-size:13px;font-weight:600;color:var(--list-color,#333);">{$preexeccmd_str}</span>
                </div>
                {include file="file:$centreon_path/www/include/common/templates/clone.ihtml" cloneId="preexec" cloneSet=$cloneSet}
            </div>

            <div class="cf-subsection">{t}Misc{/t}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_log.html}
                    <label class="cf-label-float">{$form.traps_log.label}</label>
                    <img class="helpTooltip" name="traps_log">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field cf-field--md">
                    {$form.traps_timeout.html}&nbsp;{t}seconds{/t}
                    <label class="cf-label-float">{$form.traps_timeout.label}</label>
                    <img class="helpTooltip" name="traps_timeout">
                </div>
                <div class="cf-field cf-field--md">
                    {$form.traps_exec_interval.html}&nbsp;{t}seconds{/t}
                    <label class="cf-label-float">{$form.traps_exec_interval.label}</label>
                    <img class="helpTooltip" name="traps_exec_interval">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field cf-radio-group">
                    {$form.traps_exec_interval_type.html}
                    <label class="cf-label-float">{$form.traps_exec_interval_type.label}</label>
                    <img class="helpTooltip" name="traps_exec_interval_type">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_exec_method.html}
                    <label class="cf-label-float">{$form.traps_exec_method.label}</label>
                    <img class="helpTooltip" name="traps_exec_method">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_downtime.html}
                    <label class="cf-label-float">{$form.traps_downtime.label}</label>
                    <img class="helpTooltip" name="traps_downtime">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_output_transform.html}
                    <label class="cf-label-float">{$form.traps_output_transform.label}</label>
                    <img class="helpTooltip" name="traps_output_transform">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.traps_customcode.html}
                    <label class="cf-label-float">{$form.traps_customcode.label}</label>
                    <img class="helpTooltip" name="traps_customcode">
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Shared design-system toggles (built before initFormPage so the chip
    // auto-transform skips them)
    CentreonForm.makeToggle([
        'traps_advanced_treatment',
        'traps_submit_result_enable',
        'traps_reschedule_svc_enable',
        'traps_execution_command_enable',
        'traps_routing_mode'
    ]);
    CentreonForm.initFormPage();
});
</script>
{/literal}
