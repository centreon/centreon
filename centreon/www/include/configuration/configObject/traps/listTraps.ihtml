<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

<form name='form' method='POST'>
    <h1 class="cl-page-title">{t}SNMP traps{/t}</h1>
    <hr class="cl-title-sep">
    <div class="cl-filter-box">
        <div class="cl-filter-bar">
            <span class="cl-filter-label">{t}Trap{/t}</span>
            <input type="text" id="clSearchInput" name="searchT" value="{$searchT}" class="cl-search-input" placeholder="{t}Name, OID or vendor{/t}" style="max-width:none;width:200px;">
            <span class="cl-filter-label">{t}Status{/t}</span>
            {$form.status.html}<button type="button" class="cl-clear-select" onclick="jQuery('#status').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
            <span class="cl-filter-label">{t}Vendor{/t}</span>
            {$form.vendor.html}<button type="button" class="cl-clear-select" onclick="jQuery('#vendor').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
            <button type="button" id="clSearchBtn" class="btc bt_success">{t}Search{/t}</button>
        </div>
    </div>

    <div class="cl-listing-container">
        <div class="cl-actions-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="{$msg.addL}" class="cl-btn-add">{$msg.addT}</a>
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-pagination" id="clPaginationTop"></div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="trapsListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_name}</th>
                    <th>{$headerMenu_oid}</th>
                    <th class="cl-col-center">{$headerMenu_status}</th>
                    <th>{$headerMenu_vendor}</th>
                    <th>{$headerMenu_output}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="7" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value='42'>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

{literal}
<script type="text/javascript">
var trapsListing = new CentreonListing({
    instanceName:  'trapsListing',
    ajaxListUrl:   './include/configuration/configObject/traps/ajaxTrapsListing.php',
    pageId:        {/literal}'{$trapsPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'traps_listing_limit',
    emptyMessage:  'No traps found',
    autoRefresh:   30000,
    rowIdField:    'id',
    extraParams:   function() {
        var p = {};
        var st = jQuery('#status').val(); if (st) p.status = st;
        var vd = jQuery('#vendor').val(); if (vd) p.vendor = vd;
        return p;
    },
    columns: [
        { id:'name', render: function(row, l) {
            var link = 'main.php?p={/literal}{$trapsPage}{literal}&o=c&traps_id=' + row.id;
            return '<a href="'+link+'">'+l.escape(row.name)+'</a>';
        }},
        { id:'oid', render: function(row, l) {
            return '<span style="font-family:monospace;font-size:12px;">'+l.escape(row.oid)+'</span>';
        }},
        { id:'status', align:'center', render: function(row, l) {
            if (!row.status) return '';
            var cls = {'OK':'cl-status-ok','Warning':'cl-status-warning','Critical':'cl-status-critical','Unknown':'cl-status-unknown','Pending':'cl-status-pending'}[row.status] || '';
            return '<span class="'+cls+'" style="font-weight:600;">'+l.escape(row.status)+'</span>';
        }},
        { id:'vendor' },
        { id:'output' }
    ],
    renderOptions: function(row) {
        return '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
    }
});
trapsListing.init();
</script>
{/literal}
