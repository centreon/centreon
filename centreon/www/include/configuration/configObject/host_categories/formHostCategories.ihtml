{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-relations" onclick="cfScrollTo('cf-sec-relations', this); return false;">{$form.header.relation}</a>
        <a href="#cf-sec-additional" onclick="cfScrollTo('cf-sec-additional', this); return false;">{$form.header.furtherInfos}</a>
    </div>

    <!-- Section: General Information -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.hc_name.html}
                    <label class="cf-label-float">{$form.hc_name.label}</label>
                    <img class="helpTooltip" name="hc_name">
                </div>
                <div class="cf-field">
                    {$form.hc_alias.html}
                    <label class="cf-label-float">{$form.hc_alias.label}</label>
                    <img class="helpTooltip" name="hc_alias">
                </div>
                <div class="cf-toggle-row">
                    <span>{$form.hc_activate.label}</span>
                    <label class="cl-toggle{if $o == "w"} cl-toggle--readonly{/if}">
                        <input type="checkbox" id="cf-hc-activate-toggle"{if $hcActivateOn} checked{/if}{if $o == "w"} disabled{/if} />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.hc_activate.html}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Relations -->
    <div class="cf-section" id="cf-sec-relations">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.relation}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.hc_hosts.html}
                    <label class="cf-label-float">{$form.hc_hosts.label}</label>
                    <img class="helpTooltip" name="hc_hosts">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.hc_hostsTemplate.html}
                    <label class="cf-label-float">{$form.hc_hostsTemplate.label}</label>
                    <img class="helpTooltip" name="hc_hostsTemplate">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-toggle-row">
                    <span>{$form.hc_type.label}</span>
                    <label class="cl-toggle{if $o == "w"} cl-toggle--readonly{/if}">
                        <input type="checkbox" id="cf-hc-type-toggle" onchange="document.getElementById('hc_type').checked=this.checked; toggleSeverityFields();"{if $hcTypeOn} checked{/if}{if $o == "w"} disabled{/if} />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.hc_type.html}</span>
                    <img class="helpTooltip" name="hc_type">
                </div>
            </div>
            <div class="cf-row-inline" id="severity_level">
                <div class="cf-field" style="max-width:200px;">
                    {$form.hc_severity_level.html}
                    <label class="cf-label-float">{$form.hc_severity_level.label}</label>
                    <img class="helpTooltip" name="hc_severity_level">
                </div>
                <div class="cf-field" id="severity_icon">
                    {$form.hc_severity_icon.html}&nbsp;<img id='icon_id_ctn' src='./img/blank.gif' height='22' width='22' style="vertical-align:middle;background:#fff;border:1px solid var(--c-stroke,#d0d5dd);border-radius:4px;padding:2px;">
                    <label class="cf-label-float">{$form.hc_severity_icon.label}</label>
                    <img class="helpTooltip" name="hc_severity_icon">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Additional Information -->
    <div class="cf-section" id="cf-sec-additional">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.furtherInfos}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.hc_comment.html}
                    <label class="cf-label-float">{$form.hc_comment.label}</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

<script type='text/javascript' src='./include/common/javascript/showLogo.js'></script>
<script type="text/javascript">var cfHcReadOnly = {if $o == "w"}true{else}false{/if};</script>
{literal}
<script type="text/javascript">
// Severity toggle — page-specific logic
function toggleSeverityFields() {
    if (jQuery('#hc_type').prop('checked')) {
        jQuery('#severity_level').show();
    } else {
        jQuery('#severity_level').hide();
    }
}

// Render each media option with a 16x16 thumbnail in the selector
function cfIconOption(state) {
    if (!state.id || String(state.id).indexOf('REP') === 0 || isNaN(parseInt(state.id, 10))) {
        return state.text; // directory header or empty option
    }
    var url = './include/common/getHiddenImage.php?id=' + state.id + '&logo=1';
    var label = String(state.text).replace(/^[\s ]+/, '');
    return jQuery('<span><img src="' + url + '" style="width:16px;height:16px;vertical-align:middle;margin-right:6px;object-fit:contain;">' + label + '</span>');
}

jQuery(function() {
    var iconSelect = document.getElementById('icon_id');
    if (iconSelect) {
        showLogo('icon_id_ctn', iconSelect.value);
        if (cfHcReadOnly) {
            // Read-only: QuickForm already shows the icon value as text, drop the picker.
            jQuery(iconSelect).hide();
        } else {
            jQuery('#icon_id').select2({
                templateResult: cfIconOption,
                templateSelection: cfIconOption,
                width: '100%'
            });
        }
    }
    // The toggle carries the server-driven state (set in the markup); push it onto the
    // hidden QuickForm checkbox so it is submitted correctly, then reveal the fields.
    var sevToggle = document.getElementById('cf-hc-type-toggle');
    var sevCheckbox = document.getElementById('hc_type');
    if (sevToggle && sevCheckbox) sevCheckbox.checked = sevToggle.checked;
    toggleSeverityFields();
});

document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();

    // The toggle carries the server-driven state (set in the markup); mirror it onto the
    // hidden QuickForm radio pair on load and on every change so the form submits it.
    (function () {
        var toggle = document.getElementById('cf-hc-activate-toggle');
        if (!toggle) return;
        var apply = function () {
            var on = document.querySelector('input[name="hc_activate[hc_activate]"][value="1"]')
                || document.querySelector('input[name="hc_activate"][value="1"]');
            var off = document.querySelector('input[name="hc_activate[hc_activate]"][value="0"]')
                || document.querySelector('input[name="hc_activate"][value="0"]');
            if (on) { on.checked = toggle.checked; }
            if (off) { off.checked = !toggle.checked; }
        };
        apply();
        toggle.addEventListener('change', apply);
    })();
});
</script>
{/literal}
