{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
<script type="text/javascript" src="./include/common/javascript/tool.js"></script>
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-relations" onclick="cfScrollTo('cf-sec-relations', this); return false;">{t}Relations{/t}</a>
        <a href="#cf-sec-misc" onclick="cfScrollTo('cf-sec-misc', this); return false;">{t}Misc{/t}</a>
    </div>

    <!-- Section: Configuration -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:240px;">
                    {$form.dep_name.html}
                    <label class="cf-label-float">{$form.dep_name.label}</label>
                    <img class="helpTooltip" name="name">
                </div>
                <div class="cf-field" style="flex:2;">
                    {$form.dep_description.html}
                    <label class="cf-label-float">{$form.dep_description.label}</label>
                    <img class="helpTooltip" name="description">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.inherits_parent.html}
                    <label class="cf-label-float">{$form.inherits_parent.label}</label>
                    <img class="helpTooltip" name="inherits_parent">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.execution_failure_criteria.html}
                    <label class="cf-label-float">{$form.execution_failure_criteria.label}</label>
                    <img class="helpTooltip" name="execution_failure_criteria">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.notification_failure_criteria.html}
                    <label class="cf-label-float">{$form.notification_failure_criteria.label}</label>
                    <img class="helpTooltip" name="notification_failure_criteria">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Relations -->
    <div class="cf-section" id="cf-sec-relations">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Relations{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.dep_sgParents.html}
                    <label class="cf-label-float">{$form.dep_sgParents.label}</label>
                    <img class="helpTooltip" name="servicegroup_name">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.dep_sgChilds.html}
                    <label class="cf-label-float">{$form.dep_sgChilds.label}</label>
                    <img class="helpTooltip" name="dependent_servicegroup_name">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Misc -->
    <div class="cf-section" id="cf-sec-misc">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Misc{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.dep_comment.html}
                    <label class="cf-label-float">{$form.dep_comment.label}</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}
