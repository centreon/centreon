{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

        <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.connector_name.html}
                    <label class="cf-label-float">{$form.connector_name.label}</label>
                    <img class="helpTooltip" name="connector_name">
                </div>
                <div class="cf-field" style="flex:1;min-width:0;">
                    {$form.connector_description.html}
                    <label class="cf-label-float">{$form.connector_description.label}</label>
                    <img class="helpTooltip" name="connector_description">
                </div>
                <div class="cf-toggle-row">
                    <span id="cf-connector-status-label">{$form.connector_status.label}</span>
                    <label class="cl-toggle{if $o == "w"} cl-toggle--readonly{/if}">
                        <input type="checkbox" id="cf-connector-status-toggle" aria-labelledby="cf-connector-status-label"{if $connectorStatusOn} checked{/if}{if $o == "w"} disabled{/if} />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.connector_status.html}</span>
                    <img class="helpTooltip" name="connector_status">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.command_line.html}
                    <label class="cf-label-float">{$form.command_line.label}</label>
                    <img class="helpTooltip" name="command_line">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row">
                <div class="cf-insert-builder">
                    <div class="cf-insert-row">
                        <input type="button" class="cf-insert-btn" value="+" onclick="insertValueQuery(1)" title="{t}Insert resource macro{/t}"/>
                        {$form.resource.html}
                    </div>
                    <div class="cf-insert-row">
                        <input type="button" class="cf-insert-btn" value="+" onclick="insertValueQuery(2)" title="{t}Insert connector{/t}"/>
                        {$form.plugins.html}
                    </div>
                    <div class="cf-insert-row">
                        <input type="button" class="cf-insert-btn" value="+" onclick="insertValueQuery(3)" title="{t}Insert macro{/t}"/>
                        {$form.macros.html}
                    </div>
                </div>
            </div>
            {/if}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.command_id.html}
                    <label class="cf-label-float">{$form.command_id.label}</label>
                    <img class="helpTooltip" name="command_id">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small>{$form.required._note}</small></div>
            {/if}
        </div>
    </div>

        <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
    CentreonForm.syncToggle('cf-connector-status-toggle', 'connector_status', '1', '0');
});
</script>
{/literal}
