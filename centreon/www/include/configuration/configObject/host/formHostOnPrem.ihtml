    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c" || $o == "mc"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {elseif isset($form.submitMC)}
                {$form.submitMC.html}
            {else}
