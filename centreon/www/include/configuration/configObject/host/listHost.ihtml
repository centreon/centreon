<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

<form name='form' method='POST'>
    <h1 class="cl-page-title">{t}Hosts{/t}</h1>
    <hr class="cl-title-sep">
    <div class="cl-filter-box">
        <div class="cl-filter-bar">
            <span class="cl-filter-label">{$Hosts}</span>
            <input type="text" id="clSearchInput" name="searchH" value="{$searchH}" class="cl-search-input" placeholder="{t}Name, alias or IP{/t}" style="max-width:none;width:180px;">
            <span class="cl-filter-label">{$Hostgroup}</span>
            {$form.hostgroup.html}<button type="button" class="cl-clear-select" onclick="jQuery('#hostgroup').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
            <span class="cl-filter-label">{$Poller}</span>
            {$form.poller.html}<button type="button" class="cl-clear-select" onclick="jQuery('#poller').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
            <span class="cl-filter-label">{$Template}</span>
            {$form.template.html}<button type="button" class="cl-clear-select" onclick="jQuery('#template').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
            <button type="button" id="clSearchBtn" class="btc bt_success">{t}Search{/t}</button>
        </div>
    </div>

    <div class="cl-listing-container">
        <div class="cl-actions-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="{$msg.addL}" class="cl-btn-add">{$msg.addT}</a>
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-pagination" id="clPaginationTop"></div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="hostListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_name}</th>
                    <th class="cl-col-center">{$headerMenu_mon}</th>
                    <th>{$headerMenu_desc}</th>
                    <th class="cl-col-center">{$headerMenu_address}</th>
                    <th class="cl-col-center">{$headerMenu_poller}</th>
                    <th class="cl-col-center">{$headerMenu_parent}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="8" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value='42'>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

{literal}
<script type="text/javascript">
var hostListing = new CentreonListing({
    instanceName:  'hostListing',
    ajaxListUrl:   './include/configuration/configObject/host/ajaxHostListing.php',
    ajaxToggleUrl: './include/configuration/configObject/host/ajaxHostToggle.php',
    pageId:        {/literal}'{$hostPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'host_listing_limit',
    emptyMessage:  'No hosts found',
    autoRefresh:   15000,
    rowIdField:    'id',
    extraParams:   function() {
        var p = {};
        var hg = jQuery('#hostgroup').val(); if (hg) p.hostgroup = hg;
        var pl = jQuery('#poller').val(); if (pl) p.poller = pl;
        var tp = jQuery('#template').val(); if (tp) p.template = tp;
        var st = jQuery('#status').val(); if (st) p.status = st;
        return p;
    },
    columns: [
        { id:'name', render: function(row, l) {
            var link = 'main.php?p={/literal}{$hostPage}{literal}&o=c&host_id=' + row.id;
            var icon = row.icon
                ? '<img src="'+l.escape(row.icon)+'" class="ico-16" style="vertical-align:middle;margin-right:8px;" onerror="this.outerHTML=\'<img src=./img/icons/host.svg class=ico-16 style=width:16px;height:16px;vertical-align:middle;margin-right:8px; />\'" />'
                : '<img src="./img/icons/host.svg" class="ico-16" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;" />';
            return '<a href="'+link+'">'+icon+l.escape(row.name)+'</a>';
        }},
        { id:'mon_state', align:'center', render: function(row, l) {
            if (row.mon_state === null || row.mon_state === undefined) return '<span style="opacity:.3;">-</span>';
            var cls = ['cl-mon-up','cl-mon-down','cl-mon-unreach','cl-mon-up','cl-mon-pending'][row.mon_state] || 'cl-mon-pending';
            var labels = ['UP','DOWN','UNREACHABLE','UP','PENDING'];
            var label = labels[row.mon_state] || 'PENDING';
            // Build tooltip content
            var tip = '<b>Status:</b> ' + label;
            if (row.mon_ack) tip += ' (ACK)';
            if (row.mon_dt) tip += ' (DT)';
            if (row.mon_last) tip += '<br><b>Last check:</b> ' + new Date(row.mon_last * 1000).toLocaleString();
            if (row.mon_since) {
                var dur = Math.floor((Date.now()/1000 - row.mon_since));
                var d = Math.floor(dur/86400), h = Math.floor((dur%86400)/3600), m = Math.floor((dur%3600)/60);
                tip += '<br><b>Duration:</b> ' + (d ? d+'d ':'') + h+'h '+m+'m';
            }
            if (row.mon_output) tip += '<br><b>Output:</b> ' + l.escape(row.mon_output).substring(0,120);
            return '<span class="cl-mon-badge '+cls+'" data-cl-tooltip="'+tip.replace(/"/g,'&quot;')+'" style="cursor:help;"></span>';
        }},
        { id:'alias' },
        { id:'address', align:'center' },
        { id:'poller', align:'center' },
        { id:'templates', align:'center', render: function(row, l) {
            if (!row.templates || !row.templates.length) return '';
            var parts = [];
            for (var i=0; i<row.templates.length; i++) {
                var t = row.templates[i];
                parts.push('<a href="main.php?p=60103&o=c&host_id='+t.id+'">'+l.escape(t.name)+'</a>');
            }
            return parts.join(' | ');
        }}
    ],
    renderOptions: function(row, l) {
        var svcLink = './main.php?p=602&search=' + encodeURIComponent(row.name);
        var checked = row.activate ? ' checked' : '';
        return '<a href="'+svcLink+'" title="Display all Services"><img src="./img/icons/all_services.svg" style="width:14px;height:14px;vertical-align:middle;opacity:.6;" /></a>' +
            '<label class="cl-toggle"><input type="checkbox" data-row-id="'+row.id+'"'+checked+' onchange="hostListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
    }
});
hostListing.init();


// Instant tooltip for monitoring badges
(function() {
    var tip = null;
    jQuery(document).on('mouseenter', '[data-cl-tooltip]', function() {
        var content = jQuery(this).attr('data-cl-tooltip');
        if (!content) return;
        if (tip) tip.remove();
        tip = jQuery('<div></div>').html(content).css({
            position:'fixed', zIndex:99999,
            background:'#222', color:'#eee',
            border:'1px solid #555', borderRadius:'6px',
            padding:'8px 12px', fontSize:'12px',
            whiteSpace:'nowrap', boxShadow:'0 2px 8px rgba(0,0,0,.3)',
            pointerEvents:'none', maxWidth:'400px'
        });
        jQuery('body').append(tip);
        var r = this.getBoundingClientRect();
        var t = r.top - tip.outerHeight() - 6;
        if (t < 0) t = r.bottom + 6;
        tip.css({ top:t+'px', left:(r.left + r.width/2 - tip.outerWidth()/2)+'px' });
    }).on('mouseleave', '[data-cl-tooltip]', function() {
        if (tip) { tip.remove(); tip = null; }
    });
})();
</script>
{/literal}
