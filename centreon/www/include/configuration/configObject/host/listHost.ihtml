{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

{literal}
<script type="text/javascript">
CentreonForm.detectSidePanelClose();
</script>
{/literal}

<form name='form' method='POST'>
    <div class="cl-page-header">
        <h1 class="cl-page-title">{t}Hosts{/t}</h1>
        <span class="cl-page-title-sep"></span>
        <p class="cl-page-desc">{t}Configure the hosts monitored by your platform.{/t}</p>
    </div>
    <div class="cl-listing-container">
        <div class="cl-actions-bar cl-actions-bar--centered">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="#" class="cl-btn-add" data-panel-url="main.get.php?p={$hostPage}&o=a" data-panel-title="{t}Add a Host{/t}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">{$msg.addT}</a>
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-toolbar-center">
                <div class="cl-search cl-search--with-adv">
                    <span class="cl-search-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                    <input type="text" id="clSearchInput" name="searchH" class="cl-search-simple" placeholder="{t}Search{/t}" autocomplete="off">
                    <button type="button" class="cl-adv-icon-btn" data-cl-adv-panel="clAdvPanel" onclick="clToggleAdvancedFilters(this)" title="{t}Advanced filters{/t}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                        <span class="cl-adv-badge"></span>
                    </button>

                    <div class="cl-adv-panel cl-adv-panel--popover" id="clAdvPanel">
                        <div class="cl-adv-inner">
                            <div class="cl-adv-fields">
                                <div class="cl-adv-field">
                                    <label>{$Hostgroup}</label>
                                    {$form.hostgroup.html}
                                </div>
                                <div class="cl-adv-field">
                                    <label>{$Poller}</label>
                                    {$form.poller.html}
                                </div>
                                <div class="cl-adv-field">
                                    <label>{$Template}</label>
                                    {$form.template.html}
                                </div>
                                <div class="cl-adv-field">
                                    <label>{$State}</label>
                                    {$form.status.html}
                                </div>
                            </div>
                            <div class="cl-adv-actions">
                                <button type="button" class="cl-adv-clear" onclick="jQuery('#hostgroup,#poller,#template,#status').val('').trigger('change'); document.getElementById('clSearchBtn').click();">{t}Clear{/t}</button>
                                <button type="button" id="clSearchBtn" class="cl-adv-search">{t}Search{/t}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cl-toolbar-right">
                <div class="cl-pagination" id="clPaginationTop"></div>
            </div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="hostListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_name}</th>
                    <th class="cl-col-center">{$headerMenu_mon}</th>
                    <th>{$headerMenu_desc}</th>
                    <th class="cl-col-center">{$headerMenu_address}</th>
                    <th class="cl-col-center">{$headerMenu_poller}</th>
                    <th class="cl-col-center">{$headerMenu_parent}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="8" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value=''>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

<!-- Side panel -->
<div class="cf-side-overlay" id="cfSideOverlay" onclick="cfClosePanel();"></div>
<div class="cf-side-panel" id="cfSidePanel">
    <div class="cf-side-panel-resize" id="cfSidePanelResize"></div>
    <div class="cf-side-panel-header">
        <span class="cf-side-panel-title" id="cfSidePanelTitle"></span>
        <button class="cf-side-panel-close" onclick="cfClosePanel();">&times;</button>
    </div>
    <div class="cf-side-panel-body">
        <iframe id="cfSidePanelFrame" src="about:blank"></iframe>
    </div>
</div>

{*
   Real-time monitoring badge labels. Page-specific — only this listing carries a
   monitoring badge — so they stay here instead of the shared clI18n. Kept in one
   Smarty-processed block rather than as {/literal}{t}{literal} toggles inside the
   script below, which would be unreadable ten times over.

   Every one of these is an existing catalog entry: no new string is created.
*}
<script type="text/javascript">
    var hostMonI18n = {ldelim}
        status: "{t escape='js'}Status{/t}",
        lastCheck: "{t escape='js'}Last check{/t}",
        duration: "{t escape='js'}Duration{/t}",
        output: "{t escape='js'}Output{/t}",
        acknowledged: "{t escape='js'}Acknowledged{/t}",
        downtime: "{t escape='js'}Downtime{/t}",
        // Indexed by the state the endpoint returns:
        // 0 = up, 1 = down, 2 = unreachable, 3 = (unused, kept aligned), 4 = pending
        states: [
            "{t escape='js'}Up{/t}",
            "{t escape='js'}Down{/t}",
            "{t escape='js'}Unreachable{/t}",
            "{t escape='js'}Up{/t}",
            "{t escape='js'}Pending{/t}"
        ]
    {rdelim};
</script>

{literal}
<script type="text/javascript">

var hostListing = new CentreonListing({
    instanceName:  'hostListing',
    ajaxListUrl:   './include/configuration/configObject/host/ajaxHostListing.php',
    ajaxToggleUrl: './include/configuration/configObject/host/ajaxHostToggle.php',
    pageId:        {/literal}'{$hostPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'host_listing_limit',
    autoRefresh:   15000,
    liveSearch:    true,
    rowIdField:    'id',
    extraParams:   function() {
        var p = {};
        var hg = jQuery('#hostgroup').val(); if (hg) p.hostgroup = hg;
        var pl = jQuery('#poller').val(); if (pl) p.poller = pl;
        var tp = jQuery('#template').val(); if (tp) p.template = tp;
        var st = jQuery('#status').val(); if (st) p.status = st;
        return p;
    },
    columns: [
        { id:'name', render: function(row, l) {
            var editUrl = 'main.get.php?p={/literal}{$hostPage}{literal}&o=c&host_id=' + row.id;
            var title = '{/literal}{t escape='js'}Modify Host{/t}{literal}';
            var icon = row.icon
                ? '<img src="'+clEscapeAttr(row.icon)+'" class="ico-16 cl-name-icon" onerror="this.onerror=null;this.src=\'./img/icons/host.svg\';" />'
                : '<svg viewBox="0 0 24 24" width="16" height="16" class="cl-name-icon" fill="currentColor"><path d="M4 21C3.45 21 2.97917 20.8042 2.5875 20.4125C2.19583 20.0208 2 19.55 2 19V5C2 4.45 2.19583 3.97917 2.5875 3.5875C2.97917 3.19583 3.45 3 4 3H9C9.55 3 10.0208 3.19583 10.4125 3.5875C10.8042 3.97917 11 4.45 11 5V19C11 19.55 10.8042 20.0208 10.4125 20.4125C10.0208 20.8042 9.55 21 9 21H4ZM15 21C14.45 21 13.9792 20.8042 13.5875 20.4125C13.1958 20.0208 13 19.55 13 19V5C13 4.45 13.1958 3.97917 13.5875 3.5875C13.9792 3.19583 14.45 3 15 3H20C20.55 3 21.0208 3.19583 21.4125 3.5875C21.8042 3.97917 22 4.45 22 5V19C22 19.55 21.8042 20.0208 21.4125 20.4125C21.0208 20.8042 20.55 21 20 21H15ZM4 19H9V5H4V19ZM15 19H20V5H15V19ZM5 15H8V13H5V15ZM16 15H19V13H16V15ZM5 12H8V10H5V12ZM16 12H19V10H16V12ZM5 9H8V7H5V9ZM16 9H19V7H16V9Z"/></svg>';
            return '<a href="#" data-panel-url="'+clEscapeAttr(editUrl)+'" data-panel-title="'+clEscapeAttr(title)+'" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+icon+'<span class="cl-name-label">'+l.escape(row.name)+'</span></a>';
        }},
        { id:'mon_state', align:'center', render: function(row, l) {
            if (row.mon_state === null || row.mon_state === undefined) return '<span style="opacity:.3;">-</span>';
            var cls = ['cl-mon-up','cl-mon-down','cl-mon-unreach','cl-mon-up','cl-mon-pending'][row.mon_state] || 'cl-mon-pending';
            var label = hostMonI18n.states[row.mon_state] || hostMonI18n.states[4];
            // Tooltip is rendered as plain text (textContent), so line breaks
            // must be real newlines (\n) and labels plain — no HTML tags.
            var tip = hostMonI18n.status + ': ' + label;
            if (row.mon_ack) tip += ' (' + hostMonI18n.acknowledged + ')';
            if (row.mon_dt) tip += ' (' + hostMonI18n.downtime + ')';
            if (row.mon_last) tip += '\n' + hostMonI18n.lastCheck + ': ' + new Date(row.mon_last * 1000).toLocaleString();
            if (row.mon_since) {
                var dur = Math.floor((Date.now()/1000 - row.mon_since));
                var d = Math.floor(dur/86400), h = Math.floor((dur%86400)/3600), m = Math.floor((dur%3600)/60);
                tip += '\n' + hostMonI18n.duration + ': ' + (d ? d+'d ':'') + h+'h '+m+'m';
            }
            // Truncate before escaping: cutting escaped text can land inside an
            // entity and leave a dangling "&am" in the attribute.
            if (row.mon_output) tip += '\n' + hostMonI18n.output + ': ' + l.escape(String(row.mon_output).substring(0,120));
            return '<span class="cl-mon-badge '+cls+'" data-cl-tooltip="'+tip.replace(/"/g,'&quot;')+'" style="cursor:help;"></span>';
        }},
        { id:'alias' },
        { id:'address', align:'center' },
        { id:'poller', align:'center' },
        { id:'templates', align:'center', render: function(row, l) {
            if (!row.templates || !row.templates.length) return '';
            // Host Templates menu ACL: 0 = no access, 1 = read/write, 2 = read-only
            var tplAccess = {/literal}{$hostTplAccess}{literal};
            // Generic panel title, never "<action> - <name>": a translated title
            // can carry an apostrophe ("Modifier le modèle d'hôte"), which is why
            // it travels through the dataset instead of an inline JS string.
            var tplTitle = '{/literal}{t escape='js'}Modify Host Template{/t}{literal}';
            var parts = [];
            for (var i=0; i<row.templates.length; i++) {
                var t = row.templates[i];
                var tplName = l.escape(t.name);
                if (tplAccess === 1 || tplAccess === 2) {
                    // read/write -> edit (o=c), read-only -> view (o=w, frozen form)
                    var mode = (tplAccess === 1) ? 'c' : 'w';
                    var tplUrl = 'main.get.php?p=60103&o=' + mode + '&host_id=' + t.id;
                    parts.push('<a href="#" data-panel-url="'+clEscapeAttr(tplUrl)+'" data-panel-title="'+clEscapeAttr(tplTitle)+'" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+tplName+'</a>');
                } else {
                    // no access to the Host Templates menu -> not clickable
                    parts.push(tplName);
                }
            }
            return parts.join(' | ');
        }}
    ],
    renderOptions: function(row, l, writeAccess) {
        var svcLink = './main.php?p=602&search=' + encodeURIComponent(row.name);
        var checked = row.activate ? ' checked' : '';
        // Two escaping hops: 'javascript' for this string literal, then
        // clEscapeAttr() below because the value lands in an HTML attribute.
        var svcTooltip = '{/literal}{$HelpServices|escape:'javascript'}{literal}';
        return '<a href="'+svcLink+'" title="'+clEscapeAttr(svcTooltip)+'" style="margin-right:8px;color:var(--bt-info-background-color,#2E68AA);vertical-align:middle;"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" style="vertical-align:middle;"><path d="M10 12c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2M6 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m0 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m12-8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m-4 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m-4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m-4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2"/></svg></a>' +
            '<label class="cl-toggle"><input type="checkbox" data-row-id="'+row.id+'"'+checked+' onchange="hostListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            (writeAccess ? '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>' : '');
    }
});
hostListing.init();
CentreonForm.initSidePanel(hostListing);
</script>
{/literal}
