{$form.javascript}
{literal}
<style>
/* Hide breadcrumb and page title when loaded in side panel */
.cf-in-panel .cf-page-title,
.cf-in-panel .cf-tab-nav { margin-top: 0; }
</style>
<script type="text/javascript">
// Detect if we're inside the side panel iframe and hide breadcrumb + title
if (window.frameElement && window.frameElement.id === 'cfSidePanelFrame') {
    document.addEventListener('DOMContentLoaded', function() {
        // Hide the breadcrumb (rendered by main.get.php before our form)
        var breadcrumb = document.querySelector('.pathway');
        if (breadcrumb) breadcrumb.style.display = 'none';
        // Hide the page title (already in the panel header)
        var title = document.querySelector('.cf-page-title');
        if (title) title.style.display = 'none';
        // Add class for panel-specific styles
        var wrapper = document.querySelector('.cf-form-wrapper');
        if (wrapper) wrapper.classList.add('cf-in-panel');
    });
}
</script>
{/literal}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-timeperiods" class="active" onclick="cfScrollTo('cf-sec-timeperiods', this); return false;">{t}General Information{/t}</a>
        <a href="#cf-sec-basic" onclick="cfScrollTo('cf-sec-basic', this); return false;">{t}Basic Settings{/t}</a>
        <a href="#cf-sec-advanced" onclick="cfScrollTo('cf-sec-advanced', this); return false;">{t}Advanced settings{/t}</a>
        <a href="#cf-sec-exceptions" onclick="cfScrollTo('cf-sec-exceptions', this); return false;">{t}Time Range Exceptions{/t}</a>
    </div>

    <!-- ================================================================ -->
    <!-- All sections in a single scrollable page                         -->
    <!-- ================================================================ -->
    <div id="cf-tab-general">

        <!-- Section: Timeperiods -->
        <div class="cf-section" id="cf-sec-timeperiods">
            <div class="cf-section-header" onclick="cfToggleSection(this)">
                {t}Timeperiods{/t}
                <span class="cf-section-chevron">&#9660;</span>
            </div>
            <div class="cf-section-body">
                <div class="cf-row-inline">
                    <div class="cf-field">
                        {$form.tp_name.html}
                        <label class="cf-label-float">{$form.tp_name.label}</label>
                        <img class="helpTooltip" name="timeperiod_name">
                    </div>
                    <div class="cf-field">
                        {$form.tp_alias.html}
                        <label class="cf-label-float">{$form.tp_alias.label}</label>
                        <img class="helpTooltip" name="alias">
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Basic Settings (weekdays) -->
        <div class="cf-section" id="cf-sec-basic">
            <div class="cf-section-header" onclick="cfToggleSection(this)">
                {t}Basic Settings{/t}
                <span class="cf-section-chevron">&#9660;</span>
            </div>
            <div class="cf-section-body">
                <div class="cf-row-inline">
                    <div class="cf-field">
                        {$form.tp_sunday.html}
                        <label>{$form.tp_sunday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                    <div class="cf-field">
                        {$form.tp_monday.html}
                        <label>{$form.tp_monday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                </div>
                <div class="cf-row-inline">
                    <div class="cf-field">
                        {$form.tp_tuesday.html}
                        <label>{$form.tp_tuesday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                    <div class="cf-field">
                        {$form.tp_wednesday.html}
                        <label>{$form.tp_wednesday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                </div>
                <div class="cf-row-inline">
                    <div class="cf-field">
                        {$form.tp_thursday.html}
                        <label>{$form.tp_thursday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                    <div class="cf-field">
                        {$form.tp_friday.html}
                        <label>{$form.tp_friday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                </div>
                <div class="cf-row-inline">
                    <div class="cf-field">
                        {$form.tp_saturday.html}
                        <label>{$form.tp_saturday.label}</label>
                        <img class="helpTooltip" name="weekday">
                    </div>
                    <div class="cf-field">
                        <!-- spacer -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Advanced Settings -->
        <div class="cf-section" id="cf-sec-advanced">
            <div class="cf-section-header" onclick="cfToggleSection(this)">
                {t}Advanced settings{/t}
                <span class="cf-section-chevron">&#9660;</span>
            </div>
            <div class="cf-section-body">
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.tp_include.html}
                        <label class="cf-label-float">{$form.tp_include.label}</label>
                        <img class="helpTooltip" name="include">
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Time Range Exceptions -->
        <div class="cf-section" id="cf-sec-exceptions">
            <div class="cf-section-header" onclick="cfToggleSection(this)">
                {t}Time Range exceptions{/t}
                <span class="cf-section-chevron">&#9660;</span>
            </div>
            <div class="cf-section-body">
                <input type="hidden" name="nbOfExceptions" id="hiddenExInput">

                <div id="exceptionTable" class="cf-dynamic-list">
                    <!-- Dynamic exception rows inserted here by JS -->
                </div>

                {if $o != "w"}
                <span class="cf-add-entry" onclick="addBlankInput();">+ {t}Add new entry{/t}</span>
                {/if}
            </div>
        </div>

    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}

<script type="text/javascript">
    displayExistingExceptions({$countExceptions});
</script>
