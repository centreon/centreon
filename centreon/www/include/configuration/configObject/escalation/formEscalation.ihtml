{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-resources" onclick="cfScrollTo('cf-sec-resources', this); return false;">{t}Resources{/t}</a>
        <a href="#cf-sec-misc" onclick="cfScrollTo('cf-sec-misc', this); return false;">{t}Misc{/t}</a>
    </div>

    <!-- Section: Information -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="flex:3;">
                    {$form.esc_name.html}
                    <label class="cf-label-float">{$form.esc_name.label}</label>
                    <img class="helpTooltip" name="name">
                </div>
                <div class="cf-field" style="flex:7;">
                    {$form.esc_alias.html}
                    <label class="cf-label-float">{$form.esc_alias.label}</label>
                    <img class="helpTooltip" name="alias">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.first_notification.html}
                    <label class="cf-label-float">{$form.first_notification.label}</label>
                    <img class="helpTooltip" name="first_notification">
                </div>
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.last_notification.html}
                    <label class="cf-label-float">{$form.last_notification.label}</label>
                    <img class="helpTooltip" name="last_notification">
                </div>
                <div class="cf-field" style="flex:0 1 300px;">
                    {$form.notification_interval.html}{$time_unit}
                    <label class="cf-label-float">{$form.notification_interval.label}</label>
                    <img class="helpTooltip" name="notification_interval">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.escalation_period.html}
                    <label class="cf-label-float">{$form.escalation_period.label}</label>
                    <img class="helpTooltip" name="escalation_period">
                </div>
            </div>
            <div class="cf-subsection">{t}Escalation Options{/t}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.escalation_options1.html}
                    <label class="cf-label-float">{$form.escalation_options1.label}</label>
                    <img class="helpTooltip" name="host_escalation_options">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.escalation_options2.html}
                    <label class="cf-label-float">{$form.escalation_options2.label}</label>
                    <img class="helpTooltip" name="service_escalation_options">
                </div>
            </div>
            <div class="cf-subsection">{t}Contacts{/t}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_cgs.html}
                    <label class="cf-label-float">{$form.esc_cgs.label}</label>
                    <img class="helpTooltip" name="contact_groups">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Impacted Resources -->
    <div class="cf-section" id="cf-sec-resources">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Resources{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.host_inheritance_to_services.html}
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_hosts.html}
                    <label class="cf-label-float">{$form.esc_hosts.label}</label>
                    <img class="helpTooltip" name="host_name">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_hServices.html}
                    <label class="cf-label-float">{$form.esc_hServices.label}</label>
                    <img class="helpTooltip" name="service_description">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.hostgroup_inheritance_to_services.html}
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_hgs.html}
                    <label class="cf-label-float">{$form.esc_hgs.label}</label>
                    <img class="helpTooltip" name="hostgroup_name">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_sgs.html}
                    <label class="cf-label-float">{$form.esc_sgs.label}</label>
                    <img class="helpTooltip" name="servicegroup_name">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_metas.html}
                    <label class="cf-label-float">{$form.esc_metas.label}</label>
                    <img class="helpTooltip" name="metaservice_name">
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Misc -->
    <div class="cf-section" id="cf-sec-misc">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Misc{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esc_comment.html}
                    <label class="cf-label-float">{$form.esc_comment.label}</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}
