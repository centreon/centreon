{$form.javascript}
{$javascript}
<div id="popin"><p id="msg-wrapper"></p></div>
<form {$form.attributes}>
    {if $inheritance !="1" }
    <!-- notification inheritance option -->
    <div style='visibility: hidden'>
        {if isset($form.contact_additive_inheritance) && isset($form.cg_additive_inheritance)}
            {$form.contact_additive_inheritance.html}
            {$form.cg_additive_inheritance.html}
        {/if}
    </div>
    {/if}

<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-basic" class="active" onclick="cfScrollTo('cf-sec-basic', this); return false;">{t}General{/t}</a>
        <a href="#cf-sec-checks" onclick="cfScrollTo('cf-sec-checks', this); return false;">{t}Checks{/t}</a>
        <a href="#cf-sec-notif" onclick="cfScrollTo('cf-sec-notif', this); return false;">{t}Notifications{/t}</a>
        <a href="#cf-sec-relations" onclick="cfScrollTo('cf-sec-relations', this); return false;">{t}Relations{/t}</a>
        <a href="#cf-sec-data" onclick="cfScrollTo('cf-sec-data', this); return false;">{t}Data Processing{/t}</a>
        <a href="#cf-sec-extended" onclick="cfScrollTo('cf-sec-extended', this); return false;">{t}Misc{/t}</a>
    </div>

    <!-- ================================================================ -->
    <!-- Section 1: General (was tab1)                                     -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-basic">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                {if $msg.tpl}
                <div class="cf-field">
                    {$form.service_alias.html}
                    <label class="cf-label-float">{$form.service_alias.label}</label>
                    <img class="helpTooltip" name="service_alias">
                </div>
                {/if}
                {if $o != "mc"}
                <div class="cf-field" style="flex:0 0 35%;max-width:35%;">
                    {$form.service_description.html}
                    <label class="cf-label-float">{$form.service_description.label}</label>
                    <img class="helpTooltip" name="service_description">
                </div>
                {/if}
                {if !$msg.tpl}
                    {if $service_type == "BYHOST"}
                    <div class="cf-field" style="flex:0 0 40%;max-width:40%;">
                        <p class="oreonbutton">{$form.service_hPars.html}</p>
                        <label class="cf-label-float">{$form.service_hPars.label}</label>
                        <img class="helpTooltip" name="host_name">
                    </div>
                    {/if}
                    {if $service_type == "BYHOSTGROUP"}
                    <div class="cf-field" style="flex:0 0 40%;max-width:40%;">
                        <p class="oreonbutton">{$form.service_hgPars.html}</p>
                        <label class="cf-label-float">{$form.service_hgPars.label}</label>
                        <img class="helpTooltip" name="hostgroup_name">
                    </div>
                    {/if}
                {/if}
                {if !isset($isServiceTemplate)}
                <div class="cf-toggle-row" style="flex:0 0 15%;white-space:nowrap;">
                    <span>{t}Status{/t}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-service-activate-toggle" />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.service_activate.html}</span>
                    <img class="helpTooltip" name="service_activate">
                </div>
                {/if}
            </div>
            {if !$msg.tpl}
                {if $o == "mc"}
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.mc_mod_Pars.html}
                        <label class="cf-label-float">{$form.mc_mod_Pars.label}</label>
                        <img class="helpTooltip" name="mc_update">
                    </div>
                </div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 1b: Checks (template, macros, check command, scheduling) -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-checks">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Checks{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field" style="max-width:70%;">
                    {$form.service_template_model_stm_id.html}
                    {if $o == "a" || $o == "c"}
                        &nbsp;<img src='./img/icons/show_template.png' title="Show template" class="ico-16"style='cursor:pointer;vertical-align:middle;' onClick="window.open('main.php?p=60206&service_id='+ document.Form.elements['service_template_model_stm_id'].options[document.Form.elements['service_template_model_stm_id'].selectedIndex].value + '&o=w&min=1','','toolbar=no,location=no,directories=no,status=no,scrollbars=yes,resizable=yes,copyhistory=no, width=800, height=600');">
                        &nbsp;<img src='./img/icons/edit_mode.png' title="Edit template" class="ico-14" style='cursor:pointer;vertical-align:middle;' onClick="window.open('main.php?p=60206&service_id='+ document.Form.elements['service_template_model_stm_id'].options[document.Form.elements['service_template_model_stm_id'].selectedIndex].value + '&o=c&min=1','','toolbar=no,location=no,directories=no,status=no,scrollbars=yes,resizable=yes,copyhistory=no, width=800, height=600');">
                    {/if}
                    <label class="cf-label-float">{$form.service_template_model_stm_id.label}</label>
                    <img class="helpTooltip" name="use">
                </div>
            </div>

            <div class="cf-subsection">{t}Macros{/t}</div>
            <div class="cf-row">
                {include file="file:$centreon_path/www/include/common/templates/cloneMacro.ihtml" cloneId="macro" cloneSet=$cloneSetMacro}
            </div>

            <div class="cf-subsection">{t}Check Command{/t}</div>
            <div class="cf-row">
                <div class="cf-field" style="max-width:70%;">
                    {$form.command_command_id.html}
                    {if $o == "a" || $o == "c"}
                    &nbsp;<img class='ico-14' src='./img/icons/info.png' style='cursor:help;vertical-align:middle;' onClick="window.open('main.php?p=608&command_id='+ document.Form.elements['command_command_id'].options[document.Form.elements['command_command_id'].selectedIndex].value + '&min=1','','toolbar=no,location=no,directories=no,status=no,scrollbars=yes,resizable=yes,copyhistory=no, width=1000, height=200');">
                    {/if}
                    <label class="cf-label-float">{$form.command_command_id.label}</label>
                    <img class="helpTooltip" name="check_command">
                </div>
            </div>
            {if $o == "a" || $o == "c" || $o == "w" || $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {if isset($form.hiddenArg) && isset($argChecker)}
                        {$form.hiddenArg.html}{$argChecker}
                    {/if}
                    <div id='dynamicDiv'></div>
                    <label class="cf-label-float">{$form.command_command_id_arg.label}</label>
                    <img class="helpTooltip" name="check_command_args">
                </div>
            </div>
            {/if}
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.command_command_id_arg.html}&nbsp;<img src="./img/icones/16x16/arrow_left_blue.gif" style='cursor:pointer;' alt="*"  onClick="set_arg('example1','command_command_id_arg');"><input type="text" name="example1" disabled>
                    <label class="cf-label-float">{$form.command_command_id_arg.label}</label>
                    <img class="helpTooltip" name="check_command_args">
                </div>
            </div>
            {/if}

            <div class="cf-subsection">{t}Service Scheduling Options{/t}</div>
            <div class="cf-row">
                <div class="cf-field" style="max-width:260px;">
                    {$form.timeperiod_tp_id.html}
                    <label class="cf-label-float">{$form.timeperiod_tp_id.label}</label>
                    <img class="helpTooltip" name="check_period">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:260px;">
                    {$form.service_normal_check_interval.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_normal_check_interval.label}</label>
                    <img class="helpTooltip" name="check_interval">
                </div>
                <div class="cf-field" style="max-width:260px;">
                    {$form.service_retry_check_interval.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_retry_check_interval.label}</label>
                    <img class="helpTooltip" name="retry_interval">
                </div>
                <div class="cf-field" style="max-width:180px;">
                    {$form.service_max_check_attempts.html}
                    <label class="cf-label-float">{$form.service_max_check_attempts.label}</label>
                    <img class="helpTooltip" name="max_check_attempts">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_active_checks_enabled.html}
                    <label class="cf-label-float">{$form.service_active_checks_enabled.label}</label>
                    <img class="helpTooltip" name="active_checks_enabled">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_passive_checks_enabled.html}
                    <label class="cf-label-float">{$form.service_passive_checks_enabled.label}</label>
                    <img class="helpTooltip" name="passive_checks_enabled">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_is_volatile.html}
                    <label class="cf-label-float">{$form.service_is_volatile.label}</label>
                    <img class="helpTooltip" name="is_volatile">
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 2: Notifications (was tab2)                              -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-notif">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.title2}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.service_notifications_enabled.html}
                    <label class="cf-label-float">{$form.service_notifications_enabled.label}</label>
                    <img class="helpTooltip" name="notifications_enabled">
                </div>
                {if !isset($isServiceTemplate)}
                <div class="cf-toggle-row" style="flex:0 0 auto;white-space:nowrap;">
                    <span>{$form.service_use_only_contacts_from_host.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-use-only-contacts-toggle" />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.service_use_only_contacts_from_host.html}</span>
                    <img class="helpTooltip" name="use_only_contacts_from_host">
                </div>
                {/if}
            </div>

            <div id="cf-notif-receivers-sep" class="cf-subsection">{t}Notification receivers{/t}</div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_cgs.html}
                    <label class="cf-label-float">{$form.mc_mod_cgs.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            {if $o == "mc"}
                {if $inheritance =="1"}
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.mc_contact_additive_inheritance.html}
                        <label class="cf-label-float">{$form.mc_contact_additive_inheritance.label}</label>
                        <img class="helpTooltip" name="contact_additive_inheritance">
                    </div>
                </div>
                {/if}
                <div class="cf-row cf-notif-receiver-row">
                    <div class="cf-field" style="max-width:50%;">
                        {$form.service_cs.html}
                        <label class="cf-label-float">{$form.service_cs.label}</label>
                        <img class="helpTooltip" name="contact_groups">
                    </div>
                </div>
            {else}
                <div class="cf-row cf-notif-receiver-row">
                    <div class="cf-field" style="max-width:50%;">
                        {$form.service_cs.html}
                        <label class="cf-label-float">{$form.service_cs.label}</label>
                        <img class="helpTooltip" name="contacts">
                    </div>
                </div>
                {if $inheritance =="1"}
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.contact_additive_inheritance.html}
                        <img class="helpTooltip" name="contact_additive_inheritance">
                    </div>
                </div>
                {/if}
            {/if}
            {if $o == "mc"}
                {if $inheritance =="1" }
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.mc_cg_additive_inheritance.html}
                        <label class="cf-label-float">{$form.mc_cg_additive_inheritance.label}</label>
                        <img class="helpTooltip" name="cg_additive_inheritance">
                    </div>
                </div>
                {/if}
                <div class="cf-row cf-notif-receiver-row">
                    <div class="cf-field" style="max-width:50%;">
                        {$form.service_cgs.html}
                        <label class="cf-label-float">{$form.service_cgs.label}</label>
                        <img class="helpTooltip" name="contact_groups">
                    </div>
                </div>
            {else}
                <div class="cf-row cf-notif-receiver-row">
                    <div class="cf-field" style="max-width:50%;">
                        {$form.service_cgs.html}
                        <label class="cf-label-float">{$form.service_cgs.label}</label>
                        <img class="helpTooltip" name="contact_groups">
                    </div>
                </div>
                {if $inheritance =="1" }
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.cg_additive_inheritance.html}
                        <img class="helpTooltip" name="cg_additive_inheritance">
                    </div>
                </div>
                {/if}
            {/if}

            <div class="cf-subsection">{t}Notification options{/t}</div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_notifopt_notification_interval.html}
                    <label class="cf-label-float">{$form.mc_mod_notifopt_notification_interval.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_notifopt_timeperiod.html}
                    <label class="cf-label-float">{$form.mc_mod_notifopt_timeperiod.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:60%;">
                    {$form.timeperiod_tp_id2.html}
                    <label class="cf-label-float">{$form.timeperiod_tp_id2.label}</label>
                    <img class="helpTooltip" name="notification_period">
                </div>
                <div class="cf-field" style="max-width:40%;">
                    {$form.service_notification_interval.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_notification_interval.label}</label>
                    <img class="helpTooltip" name="notification_interval">
                </div>
            </div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_notifopts.html}
                    <label class="cf-label-float">{$form.mc_mod_notifopts.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_notifOpts.html}
                    <label class="cf-label-float">{$form.service_notifOpts.label}</label>
                    <img class="helpTooltip" name="notification_options">
                </div>
            </div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_notifopt_first_notification_delay.html}
                    <label class="cf-label-float">{$form.mc_mod_notifopt_first_notification_delay.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:40%;">
                    {$form.service_first_notification_delay.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_first_notification_delay.label}</label>
                    <img class="helpTooltip" name="first_notification_delay">
                </div>
                <div class="cf-field" style="max-width:40%;">
                    {$form.service_recovery_notification_delay.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_recovery_notification_delay.label}</label>
                    <img class="helpTooltip" name="recovery_notification_delay">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 3: Relations (was tab3)                                  -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-relations">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.links}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            {if !$msg.tpl}
                {if $o == "mc"}
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.mc_mod_sgs.html}
                        <label class="cf-label-float">{$form.mc_mod_sgs.label}</label>
                        <img class="helpTooltip" name="mc_update">
                    </div>
                </div>
                {/if}
                <div class="cf-row">
                    <div class="cf-field">
                        <p class="oreonbutton">{$form.service_sgs.html}</p>
                        <label class="cf-label-float">{$form.service_sgs.label}</label>
                        <img class="helpTooltip" name="servicegroups">
                    </div>
                </div>
            {else}
                {if $o == "mc"}
                <div class="cf-row">
                    <div class="cf-field">
                        {$form.mc_mod_Pars.html}
                        <label class="cf-label-float">{$form.mc_mod_Pars.label}</label>
                        <img class="helpTooltip" name="mc_update">
                    </div>
                </div>
                {/if}
                <div class="cf-row">
                    <div class="cf-field">
                        <p class="oreonbutton">{$form.service_hPars.html}</p>
                        <label class="cf-label-float">{$form.service_hPars.label}</label>
                        <img class="helpTooltip" name="host_templates">
                    </div>
                </div>
            {/if}

            <div class="cf-subsection">{$form.header.traps}</div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_traps.html}
                    <label class="cf-label-float">{$form.mc_mod_traps.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row">
                <div class="cf-field" style="max-width:50%;">
                    <p class="oreonbutton">
                        {if isset($form.mnftr)}
                            {$form.mnftr.html}
                        {/if}
                        {$form.service_traps.html}
                    </p>
                    <label class="cf-label-float">{$form.service_traps.label}</label>
                    <img class="helpTooltip" name="snmptraps">
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 4: Data Processing (was tab4)                            -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-data">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.treatment}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.service_obsess_over_service.html}
                    <label class="cf-label-float">{$form.service_obsess_over_service.label}</label>
                    <img class="helpTooltip" name="obsess_over_service">
                </div>
                <div class="cf-field" style="max-width:260px;">
                    {$form.service_acknowledgement_timeout.html}&nbsp;{$time_unit}
                    <label class="cf-label-float">{$form.service_acknowledgement_timeout.label}</label>
                    <img class="helpTooltip" name="service_acknowledgement_timeout">
                </div>
            </div>

            <div class="cf-subsection">{$Freshness_Control_options}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.service_check_freshness.html}
                    <label class="cf-label-float">{$form.service_check_freshness.label}</label>
                    <img class="helpTooltip" name="check_freshness">
                </div>
                <div class="cf-field" style="max-width:260px;">
                    {$form.service_freshness_threshold.html}&nbsp;{$seconds}
                    <label class="cf-label-float">{$form.service_freshness_threshold.label}</label>
                    <img class="helpTooltip" name="freshness_threshold">
                </div>
            </div>

            <div class="cf-subsection">{$Flapping_Options}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.service_flap_detection_enabled.html}
                    <label class="cf-label-float">{$form.service_flap_detection_enabled.label}</label>
                    <img class="helpTooltip" name="flap_detection_enabled">
                </div>
                <div class="cf-field" style="max-width:200px;">
                    {$form.service_low_flap_threshold.html}&nbsp;%
                    <label class="cf-label-float">{$form.service_low_flap_threshold.label}</label>
                    <img class="helpTooltip" name="low_flap_threshold">
                </div>
                <div class="cf-field" style="max-width:200px;">
                    {$form.service_high_flap_threshold.html}&nbsp;%
                    <label class="cf-label-float">{$form.service_high_flap_threshold.label}</label>
                    <img class="helpTooltip" name="high_flap_threshold">
                </div>
            </div>

            <div class="cf-subsection">{$History_Options}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.service_retain_status_information.html}
                    <label class="cf-label-float">{$form.service_retain_status_information.label}</label>
                    <img class="helpTooltip" name="retain_status_information">
                </div>
                <div class="cf-field">
                    {$form.service_retain_nonstatus_information.html}
                    <label class="cf-label-float">{$form.service_retain_nonstatus_information.label}</label>
                    <img class="helpTooltip" name="retain_nonstatus_information">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_stalOpts.html}
                    <label class="cf-label-float">{$form.service_stalOpts.label}</label>
                    <img class="helpTooltip" name="stalking_options">
                </div>
            </div>

            <div class="cf-subsection">{$Event_Handler}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_event_handler_enabled.html}
                    <label class="cf-label-float">{$form.service_event_handler_enabled.label}</label>
                    <img class="helpTooltip" name="event_handler_enabled">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.command_command_id2.html}
                    {if $o == "a" || $o == "c"}
                    &nbsp;<img src='./img/icons/info.png' class='ico-14' style='cursor:help;vertical-align:middle;' onClick="window.open('main.php?p=608&command_id='+ document.Form.elements['command_command_id2'].options[document.Form.elements['command_command_id2'].selectedIndex].value + '&min=1','','toolbar=no,location=no,directories=no,status=no,scrollbars=yes,resizable=yes,copyhistory=no, width=1000, height=200');">
                    {/if}
                    <label class="cf-label-float">{$form.command_command_id2.label}</label>
                    <img class="helpTooltip" name="event_handler">
                </div>
            </div>
            {if $v > "1"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.command_command_id_arg2.html}
                    {if $o == "a" || $o == "c"}
                    &nbsp;<img src="./img/icons/arrow-left.png" class="ico-14" style='cursor: pointer;margin: 0 6px;vertical-align: middle;' alt="*" onClick="set_arg('example2','command_command_id_arg2');"><input type="text" name="example2" disabled>
                    {/if}
                    <label class="cf-label-float">{$form.command_command_id_arg2.label}</label>
                    <img class="helpTooltip" name="event_handler_args">
                </div>
            </div>
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 5: Extended Info (was tab5)                              -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-extended">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.title4}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.graph_id.html}
                    <label class="cf-label-float">{$form.graph_id.label}</label>
                    <img class="helpTooltip" name="graph_template">
                </div>
                {if $o == "mc"}
                <div class="cf-field">
                    {$form.mc_mod_sc.html}
                    <label class="cf-label-float">{$form.mc_mod_sc.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
                {/if}
                <div class="cf-field">
                    {$form.service_categories.html}
                    <label class="cf-label-float">{$form.service_categories.label}</label>
                    <img class="helpTooltip" name="categories">
                </div>
            </div>

            <div class="cf-subsection">{$form.header.nagios}</div>
            <div class="cf-row-inline">
                {if $msg.nagios >= 2}
                <div class="cf-field" style="max-width:50%;">
                    {$form.esi_notes.html}
                    <label class="cf-label-float">{$form.esi_notes.label}</label>
                    <img class="helpTooltip" name="notes">
                </div>
                {/if}
                <div class="cf-field" style="max-width:50%;">
                    {$form.esi_notes_url.html}
                    <label class="cf-label-float">{$form.esi_notes_url.label}</label>
                    <img class="helpTooltip" name="notes_url">
                </div>
            </div>
            {if $msg.nagios >= 2}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.esi_action_url.html}
                    <label class="cf-label-float">{$form.esi_action_url.label}</label>
                    <img class="helpTooltip" name="action_url">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.esi_icon_image.html}&nbsp;&nbsp;<img id='esi_icon_image_img' src='./img/blank.gif' class="img_box" >
                    <label class="cf-label-float">{$form.esi_icon_image.label}</label>
                    <img class="helpTooltip" name="icon_image">
                </div>
                <div class="cf-field">
                    {$form.esi_icon_image_alt.html}
                    <label class="cf-label-float">{$form.esi_icon_image_alt.label}</label>
                    <img class="helpTooltip" name="icon_image_alt">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.criticality_id.html}
                    <label class="cf-label-float">{$form.criticality_id.label}</label>
                    <img class="helpTooltip" name="criticality_id">
                </div>
                {if isset($form.geo_coords.label)}
                <div class="cf-field">
                    {$form.geo_coords.html}
                    <label class="cf-label-float">{$form.geo_coords.label}</label>
                    <img class="helpTooltip" name="geo_coords">
                </div>
                <div class="cf-field" style="flex:0 0 auto;">
                    <span id="svcGeoPickerBtn" class="cf-geo-picker-btn" title="{t}Find coordinates by address{/t}">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-7.6 8-13a8 8 0 1 0-16 0c0 5.4 8 13 8 13z"/><circle cx="12" cy="9" r="3"/></svg>
                    </span>
                </div>
                <div id="geoPickerPopin" style="display:none;">
                    <div style="padding:20px;min-width:420px;max-width:480px;">
                        <h3 style="margin:0 0 14px;font-size:15px;font-weight:600;color:var(--list-color,#333);">{t}Find coordinates by address{/t}</h3>
                        <div class="cf-field" style="position:relative;margin:0;">
                            <input type="text" id="svcGeoAddress" autocomplete="off" placeholder=" " />
                            <label>&#128205; {t}Address{/t}</label>
                            <div id="svcGeoResults" class="cf-geo-dropdown"></div>
                        </div>
                    </div>
                </div>
                {/if}
            </div>

            <div class="cf-subsection">{$form.header.furtherInfos}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.service_comment.html}
                    <label class="cf-label-float">{$form.service_comment.label}</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c" || $o == "mc"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {elseif isset($form.submitMC)}
                {$form.submitMC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

<script>
var alert_check_interval = null;

{if isset($alert_check_interval)}
    var alert_check_interval = "{$alert_check_interval}";
{/if}

var alert_max_length_exceeded = null;
{ if isset($alert_max_length_exceeded)}
alert_max_length_exceeded = "{$alert_max_length_exceeded}";
{/if}

{literal}
jQuery('input[name=service_normal_check_interval]').change(function() {
    if (parseInt(jQuery(this).val()) >= 1440) {
        alert(alert_check_interval);
    }
});

$('input[name=esi_notes_url], input[name=esi_action_url]').change(function () {
    inputName = $(this).parent('td').prev().text();
    if ($(this).val().length > 2048) {
        alert(alert_max_length_exceeded.replace('%s', $.trim(inputName)).replace('%d', '2048'));
    }
});

$('input[name=esi_notes]').change(function () {
    inputName = $(this).parent('td').prev().text();
    if ($(this).val().length > 512) {
        alert(alert_max_length_exceeded.replace('%s', $.trim(inputName)).replace('%d', '512'));
    }
});

jQuery(function() {

    sheepIt = jQuery("#macro").sheepIt({
        separator: '',
        allowRemoveLast: true,
        allowRemoveCurrent: true,
        allowRemoveAll: true,
        minFormsCount: 0,
        maxFormsCount: 200,
        continuousIndex : false,
        iniFormsCount: jQuery("#clone-count-macro").data("clone-count-macro"),
        data: jQuery("#clone-values-macro").data("clone-values-macro"),
        afterAdd: function(source, newForm) {
            jQuery(newForm).find("input[id^='macroPassword_']").parent().show();
        }
    });

    /**
    * Mechanism to clear the password input field when it gets focus
    * and recover its previous value when it lost focus if no new value has been defined.
    */
    jQuery('ul#macro').find('input[id^=\'macroValue_\']').on('click', function () {
    if ($(this).closest('div').find('input[type=\'checkbox\']:checked').val() === '1') {
      // It's a password input
      const actualValue = $(this).val();
      $(this).val('');
      $(this).one('focusout', function() {
        if ($(this).val().length === 0) {
          $(this).val(actualValue);
        }
      });
    }
    });

    jQuery(".onemacro").each(function(idx,elem) {
        var from = jQuery(elem).find('input[name^=macroFrom]').val();
        if (from === "direct") {
        } else if (from === "fromTpl") {
            jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
            jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
        } else {
            jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-command-background-color)',border : '1px solid var(--custom-macros-command-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
            jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-command-background-color)',border : '1px solid var(--custom-macros-command-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
        }

        // Set a 'Macro value' field as password field, on edit mode
        if (jQuery(elem).find("input[id^='macroPassword']").is(':checked')) {
            jQuery(elem).find("input[name^='macroValue']").prop('type', 'password');
        }

        {/literal}{if $form.frozen == false}{literal}
        // Display undo button on template macro
        if (typeof jQuery(elem).find("input[name^='macroTplValToDisplay']") != 'undefined') {
            if (jQuery(elem).find("input[name^='macroTplValToDisplay']").val() == "1") {
                var tplValueField = jQuery(elem).find("input[name^='macroTplValue']");
                var tplValue = tplValueField.val();

                // Reset macro value on click on undo button
                jQuery(elem).find('.cf-macro-reset-slot')
                    .removeClass('cf-macro-action-slot')
                    .attr('title', '{t}Reset to template value{/t}')
                    .html('<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>')
                    .on('click',function() {
                        jQuery(elem).find("input[name^='macroValue']").val(tplValue);
                        jQuery(elem).find('input[name^=macroFrom]').val("fromTpl");
                        jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                        jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                    });
            }
        }
        {/literal}{/if}{literal}

        jQuery(elem).find("input[name^='macroInput']").on("input",function() {
            jQuery(elem).find('input[name^=macroFrom]').val("direct");
            jQuery(elem).find("input[name^='macroInput']").css({
                "color" : "var(--custom-macros-font-color)",
                "background" : "var(--input-select-background-color)"
            });
            jQuery(elem).find("input[name^='macroValue']").css({
                "color" : "var(--custom-macros-font-color)",
                "background" : "var(--input-select-background-color)"
            });
        });
        jQuery(elem).find("input[name^='macroValue']").on("input",function() {
            jQuery(elem).find('input[name^=macroFrom]').val("direct");
            jQuery(elem).find("input[name^='macroInput']").css({
                "color" : "var(--custom-macros-font-color)",
                "background" : "var(--input-select-background-color)"
            });
            jQuery(elem).find("input[name^='macroValue']").css({
                "color" : "var(--custom-macros-font-color)",
                "background" : "var(--input-select-background-color)"
            });
        });

        var $passwordCheckbox = jQuery(elem).find("input[id^='macroPassword_']");
        {/literal}{if $form.frozen == true}{literal}
        if ($passwordCheckbox.is(':checked')) {
            $passwordCheckbox.replaceWith('[x]');
        } else {
            $passwordCheckbox.replaceWith('[ ]');
        }
        {/literal}{else}{literal}
        if ($passwordCheckbox.is(':checked')) {
            $passwordCheckbox.closest('span').hide();
        }
        {/literal}{/if}{literal}

    });

    jQuery(".macroclone").sortable({
           handle: ".clonehandle",
           axis: "y",
           helper: "clone",
           opacity: 0.5,
           placeholder: "clone-placeholder",
           tolerance: "pointer"
        }
    );

    function bindInhertance(animate) {
        var duration = animate ? 200 : 0;
        if (jQuery("input[name='service_use_only_contacts_from_host[service_use_only_contacts_from_host]']:checked").val() == "1") {
            jQuery("input[name='contact_additive_inheritance']").attr('disabled', 'disabled');
            jQuery("input[name='cg_additive_inheritance']").attr('disabled', 'disabled');
            jQuery("#service_cs").attr('disabled', 'disabled');
            jQuery("#service_cs").select2("val", "");
            jQuery("#service_cgs").attr('disabled', 'disabled');
            jQuery("#service_cgs").select2("val", "");

            jQuery("#cf-notif-receivers-sep").slideUp(duration);
            jQuery(".cf-notif-receiver-row").slideUp(duration);

            return;
        }

        jQuery("#cf-notif-receivers-sep").slideDown(duration);
        jQuery(".cf-notif-receiver-row").slideDown(duration);

        {/literal}{if $form.frozen == false}{literal}
        jQuery("input[name='contact_additive_inheritance']").removeAttr('disabled');
        jQuery("input[name='cg_additive_inheritance']").removeAttr('disabled');
        jQuery("#service_cs").removeAttr('disabled');
        jQuery("#service_cgs").removeAttr('disabled');
        {/literal}{/if}{literal}
    }

    bindInhertance(false);
    jQuery("input[name='service_use_only_contacts_from_host[service_use_only_contacts_from_host]']").on('click',function() {
        bindInhertance(true);
    });
    jQuery('#cf-use-only-contacts-toggle').on('change',function() {
        bindInhertance(true);
    });


    jQuery('select[name=service_template_model_stm_id], select[name=command_command_id]').on('change',function(event,data) {
        if (typeof data != "undefined" && typeof data.origin != undefined && data.origin == "select2defaultinit") {
            return false;
    }
    {/literal}{if $o != "mc"}{literal}
    jQuery.ajax({
        url: "./include/configuration/configObject/service/refreshMacroAjax.php",
        type: "POST",
        dataType : "json",
        data: $(this.form).serialize(),
        success : function(json) {
            jQuery("#clone-count-macro").data("clone-count-macro",json.count);
            jQuery("#clone-values-macro").data("clone-values-macro",json.macros);
            sheepIt.removeAllForms();
            for (i = 0; i < jQuery("#clone-count-macro").data("clone-count-macro"); i++) {
                sheepIt.addForm();
            }

            sheepIt.inject(jQuery("#clone-values-macro").data("clone-values-macro"));

            jQuery(".macroclone").sortable({
                   handle: ".clonehandle",
                   axis: "y",
                   helper: "clone",
                   opacity: 0.5,
                   placeholder: "clone-placeholder",
                   tolerance: "pointer"
                }
            );

            jQuery(".onemacro").each(function(idx, elem) {
                var from = jQuery(elem).find('input[name^=macroFrom]').val();
                if (from === "direct") {
                } else if (from === "fromTpl") {
                    jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                    jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                } else {
                    jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-command-background-color)',border : '1px solid var(--custom-macros-command-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                    jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-command-background-color)',border : '1px solid var(--custom-macros-command-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                }

                if (jQuery(elem).find("input[id^='macroPassword_']").is(':checked')) {
                    jQuery(elem).find("input[name^='macroValue']").prop('type', 'password');
                }

                {/literal}{if $form.frozen == false}{literal}
                // Display undo button on template macro
                if (typeof jQuery(elem).find("input[name^='macroTplValToDisplay']") != 'undefined') {
                    if (jQuery(elem).find("input[name^='macroTplValToDisplay']").val() == "1") {
                        var tplValueField = jQuery(elem).find("input[name^='macroTplValue']");
                        var tplValue = tplValueField.val();

                        var tplInputField = jQuery(elem).find("input[name^='macroInput']");
                        var tplInput = tplInputField.val();

                        // Reset macro value on click on undo button
                        jQuery(elem).find('.cf-macro-reset-slot')
                            .removeClass('cf-macro-action-slot')
                            .attr('title', '{t}Reset to template value{/t}')
                            .html('<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>')
                            .on('click',function() {
                                jQuery(elem).find("input[name^='macroValue']").val(tplValue);
                                jQuery(elem).find("input[name^='macroInput']").val(tplInput);
                                jQuery(elem).find('input[name^=macroFrom]').val("fromTpl");
                                jQuery(elem).find("input[name^='macroInput']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                                jQuery(elem).find("input[name^='macroValue']").css({'background-color' : 'var(--custom-macros-template-background-color)',border : '1px solid var(--custom-macros-template-border-color)',color: 'var(--custom-macros-placeholder-font-color)'});
                            });
                    }
                }
                {/literal}{/if}{literal}

                jQuery(elem).find("input[name^='macroInput']").on("input",function() {
                    jQuery(elem).find('input[name^=macroFrom]').val("direct");
                    jQuery(elem).find("input[name^='macroInput']").css({
                        "color" : "var(--custom-macros-font-color)",
                        "background" : "var(--input-select-background-color)"
                    });
                    jQuery(elem).find("input[name^='macroValue']").css({
                        "color" : "var(--custom-macros-font-color)",
                        "background" : "var(--input-select-background-color)"
                    });
                });
                jQuery(elem).find("input[name^='macroValue']").on("input",function() {
                    jQuery(elem).find('input[name^=macroFrom]').val("direct");
                    jQuery(elem).find("input[name^='macroInput']").css({
                        "color" : "var(--custom-macros-font-color)",
                        "background" : "var(--input-select-background-color)"
                    });
                    jQuery(elem).find("input[name^='macroValue']").css({
                        "color" : "var(--custom-macros-font-color)",
                        "background" : "var(--input-select-background-color)"
                    });
                });

                if (jQuery(elem).find("input[id^='macroPassword_']").is(':checked')) {
                    jQuery(elem).find("input[name^='macroValue']").prop('type', 'password');
                    jQuery(elem).find("input[id^='macroPassword_']").closest('span').hide();
                }
                });
        },
        error: function(jqXHR, data) {
            let message = 'Internal error';
            if (typeof(jqXHR.responseJSON) === 'object') {
               if (typeof(jqXHR.responseJSON.message) !== "undefined") {
                   message = jqXHR.responseJSON.message;
               }
            }
            jQuery('#msg-wrapper').html('<span class="msg-field error">' + message + '</span>');
            jQuery('#popin').centreonPopin("open");
        }
    });
    {/literal}{/if}{literal}
    });

    CentreonForm.initFormPage({ macros: true });
    {/literal}{if !isset($isServiceTemplate)}{literal}
    CentreonForm.syncToggle('cf-service-activate-toggle', 'service_activate', '1', '0');
    CentreonForm.syncToggle('cf-use-only-contacts-toggle', 'service_use_only_contacts_from_host', '1', '0');
    {/literal}{/if}{literal}

    // Geo coordinates picker — same address autocomplete as the Host form
    // (CentreonForm.initGeoAutocomplete), but tucked away in a popin so it
    // doesn't clutter the Service form: the search field/results use their
    // own ids, and picking a result closes the popin instead of echoing the
    // address back into the search field.
    (function() {
        var pickerBtn = document.getElementById('svcGeoPickerBtn');
        if (pickerBtn) {
            pickerBtn.addEventListener('click', function() {
                jQuery('#geoPickerPopin').centreonPopin('open');
            });
        }
        CentreonForm.initGeoAutocomplete({
            inputId: 'svcGeoAddress',
            resultsId: 'svcGeoResults',
            onSelect: function() {
                jQuery('#geoPickerPopin').centreonPopin('close');
            }
        });
    })();
});

{/literal}
</script>
