<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

{literal}
<script type="text/javascript">
if (window.frameElement && window.frameElement.id === 'cfSidePanelFrame') {
    try { window.parent.cfClosePanel(); } catch(e) {}
}
</script>
{/literal}

<form name='form' method='POST'>
    <h1 class="cl-page-title">{t}Services{/t}</h1>
    <p class="cl-page-desc">{t}Configure the services monitored on your hosts.{/t}</p>
    <div class="cl-listing-container">
        <div class="cl-actions-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="#" class="cl-btn-add" onclick="cfOpenPanel('main.get.php?p={$svcPage}&o=a', '{t}Add a Service{/t}'); return false;">{$msg.addT}</a>
                <span class="cl-more-actions"><span class="cl-more-actions-icon" aria-hidden="true">&#x22EF;</span>{$form.o1.html}</span>
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-search-center">
                <div class="cl-search">
                    <span class="cl-search-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                    <input type="text" id="clSearchS" name="searchS" value="{$searchS}" class="cl-search-simple" placeholder="{t}Search service{/t}" autocomplete="off">
                    <button type="button" class="cl-adv-btn cl-adv-btn--in-search" data-cl-adv-panel="clAdvPanel" data-cl-label-show="{t}Advanced filters{/t}" data-cl-label-hide="{t}Hide filters{/t}" title="{t}Advanced filters{/t}" aria-label="{t}Advanced filters{/t}" onclick="clToggleAdvancedFilters(this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                    </button>
                </div>
            </div>
            <div class="cl-toolbar-right">
                <div class="cl-pagination" id="clPaginationTop"></div>
            </div>
        </div>

        <div class="cl-adv-panel" id="clAdvPanel">
            <div class="cl-adv-inner">
                <div class="cl-adv-fields">
                    <div class="cl-adv-field">
                        <label>{t}Host{/t}</label>
                        <input type="text" id="clSearchH" name="searchH" value="{$searchH}" placeholder=" " autocomplete="off">
                    </div>
                    <div class="cl-adv-field">
                        <label>{t}Template{/t}</label>
                        <div class="cl-adv-control">
                            {$form.template.html}
                            <button type="button" class="cl-adv-clear-field" onclick="jQuery('#template').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
                        </div>
                    </div>
                    <div class="cl-adv-field">
                        <label>{t}Status{/t}</label>
                        <div class="cl-adv-control">
                            {$form.status.html}
                            <button type="button" class="cl-adv-clear-field" onclick="jQuery('#status').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
                        </div>
                    </div>
                    <div class="cl-filter-toggle">
                        <label class="cl-toggle">
                            <input type="checkbox" id="hostStatusCb" name="hostStatus" {if $hostStatusChecked}checked{/if} />
                            <span class="cl-toggle-slider"></span>
                        </label>
                        <span>{t}Disabled hosts{/t}</span>
                    </div>
                </div>
                <div class="cl-adv-actions">
                    <button type="button" class="cl-adv-clear" onclick="jQuery('#clSearchH').val(''); jQuery('#template,#status').val('').trigger('change'); jQuery('#hostStatusCb').prop('checked', false); document.getElementById('clSearchBtn').click();">{t}Clear{/t}</button>
                    <button type="button" id="clSearchBtn" class="cl-adv-search">{t}Search{/t}</button>
                </div>
            </div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="svcListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_name}</th>
                    <th>{$headerMenu_desc}</th>
                    <th class="cl-col-center">{$headerMenu_mon}</th>
                    <th class="cl-col-center">{$headerMenu_sched}</th>
                    <th class="cl-col-center">{$headerMenu_parent}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="8" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value='42'>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

<!-- Side panel -->
<div class="cf-side-overlay" id="cfSideOverlay" onclick="cfClosePanel();"></div>
<div class="cf-side-panel" id="cfSidePanel">
    <div class="cf-side-panel-resize" id="cfSidePanelResize"></div>
    <div class="cf-side-panel-header">
        <span class="cf-side-panel-title" id="cfSidePanelTitle"></span>
        <button class="cf-side-panel-close" onclick="cfClosePanel();">&times;</button>
    </div>
    <div class="cf-side-panel-body">
        <iframe id="cfSidePanelFrame" src="about:blank"></iframe>
    </div>
</div>

{literal}
<script type="text/javascript">
function cfOpenPanel(url, title) {
    document.getElementById('cfSidePanelTitle').textContent = title || '';
    document.getElementById('cfSidePanelFrame').src = url;
    document.getElementById('cfSideOverlay').classList.add('open');
    document.getElementById('cfSidePanel').classList.add('open');
}
function cfClosePanel() {
    document.getElementById('cfSideOverlay').classList.remove('open');
    document.getElementById('cfSidePanel').classList.remove('open');
    setTimeout(function() { document.getElementById('cfSidePanelFrame').src = 'about:blank'; }, 300);
    svcListing.fetch(svcListing.getState().num, svcListing.getState().limit, svcListing.getState().search, true);
}
(function() {
    var handle = document.getElementById('cfSidePanelResize');
    var panel = document.getElementById('cfSidePanel');
    var dragging = false;
    handle.addEventListener('mousedown', function(e) {
        e.preventDefault(); dragging = true; handle.classList.add('active');
        document.body.style.cursor = 'col-resize';
        var iframe = document.getElementById('cfSidePanelFrame');
        if (iframe) iframe.style.pointerEvents = 'none';
    });
    document.addEventListener('mousemove', function(e) {
        if (!dragging) return;
        var w = window.innerWidth - e.clientX;
        if (w < 400) w = 400; if (w > window.innerWidth * 0.95) w = window.innerWidth * 0.95;
        panel.style.width = w + 'px';
    });
    document.addEventListener('mouseup', function() {
        if (!dragging) return; dragging = false; handle.classList.remove('active');
        document.body.style.cursor = '';
        var iframe = document.getElementById('cfSidePanelFrame');
        if (iframe) iframe.style.pointerEvents = '';
    });
})();
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') cfClosePanel(); });

// Theme-aware default icons (inline SVG using var(--icons-fill-color)), wrapped
// with the row spacing so they stay visible in light and dark modes. Custom
// per-host/service logos keep their own image; the onerror fallback swaps to these.
var clDefaultHostIcon = '<span style="display:inline-flex;align-items:center;vertical-align:middle;margin-right:6px;">' + ({/literal}{$defaultHostIconJs}{literal}) + '</span>';
var clDefaultServiceIcon = '<span style="display:inline-flex;align-items:center;vertical-align:middle;margin-right:4px;">' + ({/literal}{$defaultServiceIconJs}{literal}) + '</span>';

var svcListing = new CentreonListing({
    instanceName:  'svcListing',
    ajaxListUrl:   './include/configuration/configObject/service/ajaxServiceByHostListing.php',
    ajaxToggleUrl: './include/configuration/configObject/service/ajaxServiceToggle.php',
    liveSearchFields: ['clSearchS'],
    pageId:        {/literal}'{$svcPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'svc_byhost_listing_limit',
    emptyMessage:  'No services found',
    autoRefresh:   15000,
    rowIdField:    'id',
    extraParams:   function() {
        var p = {};
        var sh = jQuery('#clSearchH').val(); if (sh) p.searchH = sh;
        var ss = jQuery('#clSearchS').val(); if (ss) p.searchS = ss;
        p.search = '';
        var tp = jQuery('#template').val(); if (tp) p.template = tp;
        var st = jQuery('#status').val(); if (st) p.status = st;
        if (jQuery('#hostStatusCb').is(':checked')) p.hostStatus = 1;
        return p;
    }
});

// Custom renderRows for host grouping (assigned after construction to avoid Smarty issues)
var _svcPageId = {/literal}'{$svcPage}'{literal};
var _svcWriteAccess = {/literal}'{$mode_access}'{literal} === 'w';

svcListing.renderRows = function(rows) {
    var self = svcListing;
    var tbody = jQuery('#clTableBody');
    tbody.empty();

    if (!rows || !rows.length) {
        tbody.html('<tr><td colspan="8" style="text-align:center;padding:24px;color:#a7a9ac;">No services found</td></tr>');
        return;
    }

    var lastHost = null;
    var monLabels = ['OK','WARNING','CRITICAL','UNKNOWN','PENDING'];
    var monClasses = ['cl-mon-up','cl-mon-warning','cl-mon-down','cl-mon-unknown','cl-mon-pending'];

    for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var rid = row.id;

        var tr = '<tr><td class="cl-col-picker"><div class="md-checkbox md-checkbox-inline"><input type="checkbox" id="select_'+rid+'" name="select['+rid+']" value="1" /><label class="empty-label" for="select_'+rid+'"></label></div></td>';

        // Host (grouped)
        if (row.host_name !== lastHost) {
            var hostLink = 'main.php?p=60101&o=c&host_id=' + row.host_id;
            var hostIcon = row.host_icon
                ? '<img src="'+self.escape(row.host_icon)+'" class="ico-16" style="vertical-align:middle;margin-right:6px;" onerror="this.outerHTML=clDefaultHostIcon;" />'
                : clDefaultHostIcon;
            // Host monitoring badge
            var hBadge = '';
            if (row.host_mon_state !== null && row.host_mon_state !== undefined) {
                var hCls = ['cl-mon-up','cl-mon-down','cl-mon-unreach'][row.host_mon_state] || 'cl-mon-pending';
                var hLabels = ['UP','DOWN','UNREACHABLE'];
                var hLabel = hLabels[row.host_mon_state] || 'PENDING';
                var hTip = '<b>'+hLabel+'</b>';
                if (row.host_mon_output) hTip += '<br>' + self.escape(row.host_mon_output).substring(0,100);
                hBadge = ' <span class="cl-mon-badge '+hCls+'" data-cl-tooltip="'+hTip.replace(/"/g,'&quot;')+'" style="cursor:help;margin-left:4px;"></span>';
            }
            tr += '<td><a href="'+hostLink+'">'+hostIcon+self.escape(row.host_name)+'</a>'+hBadge+'</td>';
            lastHost = row.host_name;
        } else {
            tr += '<td></td>';
        }

        // Service
        var svcEditUrl = 'main.get.php?p=' + _svcPageId + '&o=c&service_id=' + rid;
        var svcTitle = 'Modify a Service - ' + (row.desc || '');
        var svcIcon = row.svc_icon
            ? '<img src="'+self.escape(row.svc_icon)+'" class="ico-14" style="vertical-align:middle;margin-right:4px;" onerror="this.outerHTML=clDefaultServiceIcon;" />'
            : clDefaultServiceIcon;
        tr += '<td><a href="#" onclick="cfOpenPanel(\''+svcEditUrl+'\', \''+self.escape(svcTitle).replace(/\x27/g,"&#39;")+'\'); return false;">'+svcIcon+self.escape(row.desc||'')+'</a></td>';

        // Monitoring status
        if (row.mon_state === null || row.mon_state === undefined) {
            tr += '<td class="cl-col-center"><span style="opacity:.3;">-</span></td>';
        } else {
            var mCls = monClasses[row.mon_state] || 'cl-mon-pending';
            var mLabel = monLabels[row.mon_state] || 'PENDING';
            var tip = '<b>'+mLabel+'</b>';
            if (row.mon_last) tip += '<br>Last: ' + new Date(row.mon_last*1000).toLocaleString();
            if (row.mon_output) tip += '<br>' + self.escape(row.mon_output).substring(0,100);
            tr += '<td class="cl-col-center"><span class="cl-mon-badge '+mCls+'" data-cl-tooltip="'+tip.replace(/"/g,'&quot;')+'" style="cursor:help;"></span></td>';
        }

        // Scheduling
        tr += '<td class="cl-col-center" style="font-size:11px;">' + self.escape(row.scheduling||'') + '</td>';

        // Templates
        var tplHtml = '';
        if (row.templates && row.templates.length) {
            var parts = [];
            for (var t = 0; t < row.templates.length; t++) {
                parts.push('<a href="main.php?p=60206&o=c&service_id='+row.templates[t].id+'">'+self.escape(row.templates[t].name)+'</a>');
            }
            tplHtml = parts.join(' &gt; ');
        }
        tr += '<td class="cl-col-center" style="font-size:11px;">' + tplHtml + '</td>';

        // Options
        var checked = row.activate ? ' checked' : '';
        var optHtml = '<label class="cl-toggle"><input type="checkbox" data-row-id="'+rid+'"'+checked+' onchange="svcListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+rid+']"/>';
        if (!_svcWriteAccess) {
            optHtml = optHtml.replace(/onchange="[^"]*"/g, '').replace(/<input[^>]*cl-dup-input[^>]*>/g, '');
            optHtml = optHtml.replace(/<input type="checkbox"/g, '<input type="checkbox" disabled');
        }
        tr += '<td class="cl-col-right"><div class="cl-options-cell">' + optHtml + '</div></td>';

        tr += '</tr>';
        tbody.append(tr);
    }
};

// Override search to use both host and service fields
jQuery('#clSearchBtn').off('click').on('click', function() {
    svcListing.fetch(0, svcListing.getState().limit, '');
});
jQuery('#clSearchH, #clSearchS').on('keypress', function(e) {
    if (e.which === 13) { e.preventDefault(); jQuery('#clSearchBtn').click(); }
});

svcListing.init();

// Instant tooltip
(function() {
    var tip = null;
    jQuery(document).on('mouseenter', '[data-cl-tooltip]', function() {
        var content = jQuery(this).attr('data-cl-tooltip');
        if (!content) return;
        if (tip) tip.remove();
        tip = jQuery('<div></div>').html(content).css({
            position:'fixed', zIndex:99999,
            background:'#222', color:'#eee',
            border:'1px solid #555', borderRadius:'6px',
            padding:'8px 12px', fontSize:'12px',
            whiteSpace:'nowrap', boxShadow:'0 2px 8px rgba(0,0,0,.3)',
            pointerEvents:'none', maxWidth:'400px'
        });
        jQuery('body').append(tip);
        var r = this.getBoundingClientRect();
        var t = r.top - tip.outerHeight() - 6;
        if (t < 0) t = r.bottom + 6;
        tip.css({ top:t+'px', left:(r.left + r.width/2 - tip.outerWidth()/2)+'px' });
    }).on('mouseleave', '[data-cl-tooltip]', function() {
        if (tip) { tip.remove(); tip = null; }
    });
})();
</script>
{/literal}
