{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}

<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

{literal}
<script type="text/javascript">
CentreonForm.detectSidePanelClose();
</script>
{/literal}

<form name='form' method='POST'>
    <div class="cl-page-header">
        <h1 class="cl-page-title">{t}Services{/t}</h1>
        <span class="cl-page-title-sep"></span>
        <p class="cl-page-desc">{t}Configure the services monitored on your hosts.{/t}</p>
    </div>
    <div class="cl-listing-container">
        <div class="cl-actions-bar cl-actions-bar--centered">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="#" class="cl-btn-add" data-panel-url="main.get.php?p={$svcPage}&o=a" data-panel-title="{t}Add a Service{/t}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">{$msg.addT}</a>
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-toolbar-center">
                <div class="cl-search cl-search--with-adv">
                    <span class="cl-search-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                    <input type="text" id="clSearchS" name="searchS" value="{$searchS}" class="cl-search-simple" placeholder="{t}Search{/t}" autocomplete="off">
                    <button type="button" class="cl-adv-icon-btn" data-cl-adv-panel="clAdvPanel" onclick="clToggleAdvancedFilters(this)" title="{t}Advanced filters{/t}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                        <span class="cl-adv-badge"></span>
                    </button>

                    <div class="cl-adv-panel cl-adv-panel--popover" id="clAdvPanel">
                        <div class="cl-adv-inner">
                            <div class="cl-adv-fields">
                                <div class="cl-adv-field">
                                    <label>{t}Host{/t}</label>
                                    <input type="text" id="clSearchH" name="searchH" value="{$searchH}" placeholder="{t}Search{/t}" autocomplete="off">
                                </div>
                                <div class="cl-adv-field">
                                    <label>{t}Template{/t}</label>
                                    {$form.template.html}
                                </div>
                                <div class="cl-adv-field">
                                    <label>{t}Status{/t}</label>
                                    {$form.status.html}
                                </div>
                                <div class="cl-filter-toggle">
                                    <label class="cl-toggle">
                                        <input type="checkbox" id="hostStatusCb" name="hostStatus" />
                                        <span class="cl-toggle-slider"></span>
                                    </label>
                                    <span>{t}Disabled hosts{/t}</span>
                                </div>
                            </div>
                            <div class="cl-adv-actions">
                                <button type="button" class="cl-adv-clear" onclick="jQuery('#clSearchH').val(''); jQuery('#template,#status').val('').trigger('change'); jQuery('#hostStatusCb').prop('checked', false); document.getElementById('clSearchBtn').click();">{t}Clear{/t}</button>
                                <button type="button" id="clSearchBtn" class="cl-adv-search">{t}Search{/t}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cl-toolbar-right">
                <div class="cl-pagination" id="clPaginationTop"></div>
            </div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="svcListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_name}</th>
                    <th>{$headerMenu_desc}</th>
                    <th class="cl-col-center">{$headerMenu_mon}</th>
                    <th class="cl-col-center">{$headerMenu_sched}</th>
                    <th class="cl-col-center">{$headerMenu_parent}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="8" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value=''>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

<!-- Side panel -->
<div class="cf-side-overlay" id="cfSideOverlay" onclick="cfClosePanel();"></div>
<div class="cf-side-panel" id="cfSidePanel">
    <div class="cf-side-panel-resize" id="cfSidePanelResize"></div>
    <div class="cf-side-panel-header">
        <span class="cf-side-panel-title" id="cfSidePanelTitle"></span>
        <button class="cf-side-panel-close" onclick="cfClosePanel();">&times;</button>
    </div>
    <div class="cf-side-panel-body">
        <iframe id="cfSidePanelFrame" src="about:blank"></iframe>
    </div>
</div>

{literal}
<script type="text/javascript">

// Filter state lives in the listing's own sessionStorage entry, the one
// CentreonListing writes on every fetch. It restores <select> filters itself, so
// only the two text inputs and the "disabled hosts" checkbox are re-applied
// here. Doing it client-side is what makes "Clear" stick: the cleared value is
// what gets persisted, so a refresh reloads an empty filter instead of
// resurrecting the previous one from the PHP session.
//
// A deep link (main.php?p=602&search=<host name>, the "Display all Services for
// this host" icon) is a fresh filter: it keeps the value Smarty put in the
// field, replaces the remembered filters and starts back on page 1.
//
// This runs BEFORE the constructor on purpose: CentreonListing snapshots the
// session state when it is built, so a later write would not be seen by its own
// restore step.
(function () {
    var stateKey = 'cl_state_svc_byhost_listing_limit';
    var deepLink = {/literal}{$deepLinkSearch|default:0}{literal} > 0;
    var state = null;
    try { state = JSON.parse(sessionStorage.getItem(stateKey) || 'null'); } catch (e) {}

    if (deepLink) {
        try {
            state = state || {};
            state.num = 0;
            // Replace, not merge: a remembered template or status filter would
            // otherwise narrow the host's services without showing why.
            state.extra = { searchH: jQuery('#clSearchH').val() || '' };
            state.labels = {};
            sessionStorage.setItem(stateKey, JSON.stringify(state));
        } catch (e) {}
        return;
    }

    if (state && state.extra) {
        jQuery('#clSearchH').val(state.extra.searchH || '');
        jQuery('#clSearchS').val(state.extra.searchS || '');
        jQuery('#hostStatusCb').prop('checked', !!state.extra.hostStatus);
    }
})();

var svcListing = new CentreonListing({
    instanceName:  'svcListing',
    ajaxListUrl:   './include/configuration/configObject/service/ajaxServiceByHostListing.php',
    ajaxToggleUrl: './include/configuration/configObject/service/ajaxServiceToggle.php',
    liveSearchFields: ['clSearchS'],
    pageId:        {/literal}'{$svcPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'svc_byhost_listing_limit',
    autoRefresh:   15000,
    rowIdField:    'id',
    extraParams:   function() {
        var p = {};
        var sh = jQuery('#clSearchH').val(); if (sh) p.searchH = sh;
        var ss = jQuery('#clSearchS').val(); if (ss) p.searchS = ss;
        p.search = '';
        var tp = jQuery('#template').val(); if (tp) p.template = tp;
        var st = jQuery('#status').val(); if (st) p.status = st;
        if (jQuery('#hostStatusCb').is(':checked')) p.hostStatus = 1;
        return p;
    }
});

// Custom renderRows for host grouping (assigned after construction to avoid Smarty issues)
var _svcPageId = {/literal}'{$svcPage}'{literal};
var _svcWriteAccess = {/literal}'{$mode_access}'{literal} === 'w';
// Menu ACL on the linked pages: 0 = no access, 1 = read/write, 2 = read-only
var hostAccess = {/literal}{$hostAccess}{literal};
var svcTplAccess = {/literal}{$svcTplAccess}{literal};

svcListing.renderRows = function(rows) {
    var self = svcListing;
    var tbody = jQuery('#clTableBody');
    tbody.empty();

    if (!rows || !rows.length) {
        // Same translated label as the framework's default renderRows; when the
        // page has no services at all (and no filter) CentreonListing replaces
        // this with the welcome empty state.
        tbody.html('<tr><td colspan="8" style="text-align:center;padding:24px;color:#a7a9ac;">' +
            self.escape(clListingLabel('noResults', 'No results found')) + '</td></tr>');
        return;
    }

    var lastHost = null;
    var monLabels = ['OK','WARNING','CRITICAL','UNKNOWN','PENDING'];
    var monClasses = ['cl-mon-up','cl-mon-warning','cl-mon-down','cl-mon-unknown','cl-mon-pending'];

    for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var rid = row.id;
        var rkey = row.key || rid;

        var tr = '<tr><td class="cl-col-picker"><div class="md-checkbox md-checkbox-inline"><input type="checkbox" id="select_'+rkey+'" name="select['+rid+']" value="1" /><label class="empty-label" for="select_'+rkey+'"></label></div></td>';

        // Host (grouped)
        if (row.host_name !== lastHost) {
            // Default icon: the HostIcon of the header top-counter (packages/ui/src/Icon/HostIcon.tsx)
            var hostIcon = row.host_icon
                ? '<img src="'+clEscapeAttr(row.host_icon)+'" class="ico-16" style="vertical-align:middle;margin-right:6px;" onerror="this.src=\'./img/icons/host.svg\'" />'
                : '<svg viewBox="0 0 24 24" width="16" height="16" style="vertical-align:middle;margin-right:6px;" fill="currentColor"><path d="M4 21C3.45 21 2.97917 20.8042 2.5875 20.4125C2.19583 20.0208 2 19.55 2 19V5C2 4.45 2.19583 3.97917 2.5875 3.5875C2.97917 3.19583 3.45 3 4 3H9C9.55 3 10.0208 3.19583 10.4125 3.5875C10.8042 3.97917 11 4.45 11 5V19C11 19.55 10.8042 20.0208 10.4125 20.4125C10.0208 20.8042 9.55 21 9 21H4ZM15 21C14.45 21 13.9792 20.8042 13.5875 20.4125C13.1958 20.0208 13 19.55 13 19V5C13 4.45 13.1958 3.97917 13.5875 3.5875C13.9792 3.19583 14.45 3 15 3H20C20.55 3 21.0208 3.19583 21.4125 3.5875C21.8042 3.97917 22 4.45 22 5V19C22 19.55 21.8042 20.0208 21.4125 20.4125C21.0208 20.8042 20.55 21 20 21H15ZM4 19H9V5H4V19ZM15 19H20V5H15V19ZM5 15H8V13H5V15ZM16 15H19V13H16V15ZM5 12H8V10H5V12ZM16 12H19V10H16V12ZM5 9H8V7H5V9ZM16 9H19V7H16V9Z"/></svg>';
            // No host monitoring badge here: this is a service configuration
            // listing, so the host's live state is not relevant.
            // Hosts menu ACL: 0 = no access, 1 = read/write, 2 = read-only
            var hostName = self.escape(row.host_name);
            if (hostAccess === 1 || hostAccess === 2) {
                var hMode = (hostAccess === 1) ? 'c' : 'w';
                var hostEditUrl = 'main.get.php?p=60101&o=' + hMode + '&host_id=' + row.host_id;
                tr += '<td><a href="#" data-panel-url="'+clEscapeAttr(hostEditUrl)+'" data-panel-title="{/literal}{t}Modify a Host{/t}{literal}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+hostIcon+hostName+'</a></td>';
            } else {
                // no access to the Hosts menu -> not clickable
                tr += '<td>'+hostIcon+hostName+'</td>';
            }
            lastHost = row.host_name;
        } else {
            tr += '<td></td>';
        }

        // Service
        var svcEditUrl = 'main.get.php?p=' + _svcPageId + '&o=c&service_id=' + rid;
        // Default icon: the ServiceIcon of the header top-counter (MUI Grain)
        var svcIcon = row.svc_icon
            ? '<img src="'+clEscapeAttr(row.svc_icon)+'" class="ico-14" style="vertical-align:middle;margin-right:4px;" onerror="this.src=\'./img/icons/service.svg\'" />'
            : '<svg viewBox="0 0 24 24" width="14" height="14" style="vertical-align:middle;margin-right:4px;" fill="currentColor"><path d="M10 12c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2M6 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m0 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m12-8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m-4 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m-4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m-4-4c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2"/></svg>';
        tr += '<td><a href="#" data-panel-url="'+clEscapeAttr(svcEditUrl)+'" data-panel-title="{/literal}{t}Modify a Service{/t}{literal}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+svcIcon+self.escape(row.desc||'')+'</a></td>';

        // Monitoring status
        if (row.mon_state === null || row.mon_state === undefined) {
            tr += '<td class="cl-col-center"><span style="opacity:.3;">-</span></td>';
        } else {
            var mCls = monClasses[row.mon_state] || 'cl-mon-pending';
            var mLabel = monLabels[row.mon_state] || 'PENDING';
            var tip = '<b>'+mLabel+'</b>';
            if (row.mon_last) tip += '<br>{/literal}{t escape='js'}Last Check{/t}{literal}: ' + new Date(row.mon_last*1000).toLocaleString();
            var mOut = row.mon_output ? String(row.mon_output).substring(0,100) : '';
            tr += '<td class="cl-col-center"><span class="cl-mon-badge '+mCls+'" data-cl-tooltip="'+tip.replace(/"/g,'&quot;')+'"'
                + (mOut ? ' data-cl-tooltip-text="'+self.escape(mOut).replace(/"/g,'&quot;')+'"' : '')
                + ' style="cursor:help;"></span></td>';
        }

        // Scheduling
        tr += '<td class="cl-col-center" style="font-size:11px;">' + self.escape(row.scheduling||'') + '</td>';

        // Templates
        var tplHtml = '';
        if (row.templates && row.templates.length) {
            var parts = [];
            for (var t = 0; t < row.templates.length; t++) {
                var tplName = self.escape(row.templates[t].name);
                if (svcTplAccess === 1 || svcTplAccess === 2) {
                    // read/write -> edit (o=c), read-only -> view (o=w, frozen form)
                    var tMode = (svcTplAccess === 1) ? 'c' : 'w';
                    var tplUrl = 'main.get.php?p=60206&o=' + tMode + '&service_id=' + row.templates[t].id;
                    parts.push('<a href="#" data-panel-url="'+clEscapeAttr(tplUrl)+'" data-panel-title="{/literal}{t}Modify a Service Template Model{/t}{literal}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+tplName+'</a>');
                } else {
                    // no access to the Service Templates menu -> not clickable
                    parts.push(tplName);
                }
            }
            tplHtml = parts.join(' &gt; ');
        }
        tr += '<td class="cl-col-center" style="font-size:11px;">' + tplHtml + '</td>';

        // Options
        var checked = row.activate ? ' checked' : '';
        var optHtml = '<label class="cl-toggle"><input type="checkbox" data-row-id="'+rid+'"'+checked+' onchange="svcListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+rid+']"/>';
        if (!_svcWriteAccess) {
            optHtml = optHtml.replace(/onchange="[^"]*"/g, '').replace(/<input[^>]*cl-dup-input[^>]*>/g, '');
            optHtml = optHtml.replace(/<input type="checkbox"/g, '<input type="checkbox" disabled');
        }
        tr += '<td class="cl-col-right"><div class="cl-options-cell">' + optHtml + '</div></td>';

        tr += '</tr>';
        tbody.append(tr);
    }
};

// Override search to use both host and service fields
jQuery('#clSearchBtn').off('click').on('click', function() {
    svcListing.fetch(0, svcListing.getState().limit, '');
});
jQuery('#clSearchH, #clSearchS').on('keypress', function(e) {
    if (e.which === 13) { e.preventDefault(); jQuery('#clSearchBtn').click(); }
});

svcListing.init();
CentreonForm.initSidePanel(svcListing);

// Instant tooltip
(function() {
    var tip = null;
    jQuery(document).on('mouseenter', '[data-cl-tooltip]', function() {
        var content = jQuery(this).attr('data-cl-tooltip');
        var extra = jQuery(this).attr('data-cl-tooltip-text');
        if (!content && !extra) return;
        if (tip) tip.remove();
        tip = jQuery('<div></div>').css({
            position:'fixed', zIndex:99999,
            background:'#222', color:'#eee',
            border:'1px solid #555', borderRadius:'6px',
            padding:'8px 12px', fontSize:'12px',
            whiteSpace:'nowrap', boxShadow:'0 2px 8px rgba(0,0,0,.3)',
            pointerEvents:'none', maxWidth:'400px'
        });
        // Structural part (app-generated labels) is safe HTML; the plugin output
        // is untrusted and injected as a text node so it is never parsed as HTML
        if (content) { tip.html(content); }
        if (extra) {
            if (content) { tip.append('<br>'); }
            tip.append(document.createTextNode(extra));
        }
        jQuery('body').append(tip);
        var r = this.getBoundingClientRect();
        var t = r.top - tip.outerHeight() - 6;
        if (t < 0) t = r.bottom + 6;
        tip.css({ top:t+'px', left:(r.left + r.width/2 - tip.outerWidth()/2)+'px' });
    }).on('mouseleave', '[data-cl-tooltip]', function() {
        if (tip) { tip.remove(); tip = null; }
    });
})();
</script>
{/literal}
