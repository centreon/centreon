{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.title}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-notif" onclick="cfScrollTo('cf-sec-notif', this); return false;">{$form.header.notification}</a>
        <a href="#cf-sec-centreon" onclick="cfScrollTo('cf-sec-centreon', this); return false;">{$form.header.centreon}</a>
        <a href="#cf-sec-access" onclick="cfScrollTo('cf-sec-access', this); return false;">{t}Access Restriction{/t}</a>
        <a href="#cf-sec-additional" onclick="cfScrollTo('cf-sec-additional', this); return false;">{$form.header.additional}</a>
    </div>

    <!-- ================================================================ -->
    <!-- Section 1: Information & Notifications (was tab1)                 -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            {if $o != "mc"}
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:320px;">
                    {$form.contact_alias.html}
                    <label class="cf-label-float">{$form.contact_alias.label}</label>
                    <img class="helpTooltip" name="alias">
                </div>
                <div class="cf-field" style="max-width:440px;">
                    {$form.contact_name.html}
                    <label class="cf-label-float">{$form.contact_name.label}</label>
                    <img class="helpTooltip" name="contact_name">
                </div>
                <div class="cf-toggle-row">
                    <span>{$form.contact_activate.label}</span>
                    <label class="cl-toggle">
                        <input type="checkbox" id="cf-contact-activate-toggle"{if $contactActivateOn} checked{/if}{if $o == "w"} disabled{/if} />
                        <span class="cl-toggle-slider"></span>
                    </label>
                    <span style="display:none;">{$form.contact_activate.html}</span>
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_email.html}
                    <label class="cf-label-float">{$form.contact_email.label}</label>
                    <img class="helpTooltip" name="email">
                </div>
                <div class="cf-field">
                    {$form.contact_pager.html}
                    <label class="cf-label-float">{$form.contact_pager.label}</label>
                    <img class="helpTooltip" name="pager">
                </div>
            </div>
            {/if}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_template_id.html}
                    <label class="cf-label-float">{$form.contact_template_id.label}</label>
                </div>
            </div>

            <div class="cf-subsection">{t}Groups{/t}</div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_cg.html}
                    <label class="cf-label-float">{$form.mc_mod_cg.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row">
                <div class="cf-field">
                    <p class="oreonbutton">{$form.contact_cgNotif.html}</p>
                    <label class="cf-label-float">{t}Contact Groups{/t}</label>
                    <img class="helpTooltip" name="contactgroups">
                </div>
            </div>
            {if $o != "mc" and isset($ldapGroups)}
            <div class="cf-row">
                <div class="cf-field">
                    <div>{foreach item=group from=$ldapGroups}&nbsp;{$group|escape}<br/>{/foreach}</div>
                    <label class="cf-label-float">{$ldap_group}</label>
                    <img class="helpTooltip" name="ldap_group">
                </div>
            </div>
            {/if}

            <div class="cf-subsection">{t}Misc{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_lang.html}
                    <label class="cf-label-float">{$form.contact_lang.label}</label>
                    <img class="helpTooltip" name="language">
                </div>
                <div class="cf-field">
                    {$form.default_page.html}
                    <label class="cf-label-float">{$form.default_page.label}</label>
                    <img class="helpTooltip" name="default_page">
                </div>
                <div class="cf-field">
                    {$form.contact_location.html}
                    <label class="cf-label-float">{$form.contact_location.label}</label>
                    <img class="helpTooltip" name="location">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
            {if isset($modules_template) && is_array($modules_template)}
                {foreach item=module_template from=$modules_template}
                    {include file=$module_template}
                {/foreach}
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section: Notifications                                            -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-notif">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.notification}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_enable_notifications.html}
                    <label class="cf-label-float">{$form.contact_enable_notifications.label}</label>
                    <img class="helpTooltip" name="contact_enable_notifications">
                </div>
            </div>

            <div class="cf-subsection">{$form.header.hostNotification}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_hostNotifOpts.html}
                    <label class="cf-label-float">{$form.contact_hostNotifOpts.label}</label>
                    <img class="helpTooltip" name="host_notification_options">
                </div>
            </div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_hcmds.html}
                    <label class="cf-label-float">{$form.mc_mod_hcmds.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.timeperiod_tp_id.html}
                    <label class="cf-label-float">{$form.timeperiod_tp_id.label}</label>
                    <img class="helpTooltip" name="host_notification_period">
                </div>
                <div class="cf-field">
                    <p class="oreonbutton">{$form.contact_hostNotifCmds.html}</p>
                    <label class="cf-label-float">{$form.contact_hostNotifCmds.label}</label>
                    <img class="helpTooltip" name="host_notification_commands">
                </div>
            </div>

            <div class="cf-subsection">{$form.header.serviceNotification}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_svNotifOpts.html}
                    <label class="cf-label-float">{$form.contact_svNotifOpts.label}</label>
                    <img class="helpTooltip" name="service_notification_options">
                </div>
            </div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_svcmds.html}
                    <label class="cf-label-float">{$form.mc_mod_svcmds.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.timeperiod_tp_id2.html}
                    <label class="cf-label-float">{$form.timeperiod_tp_id2.label}</label>
                    <img class="helpTooltip" name="service_notification_period">
                </div>
                <div class="cf-field">
                    <p class="oreonbutton">{$form.contact_svNotifCmds.html}</p>
                    <label class="cf-label-float">{$form.contact_svNotifCmds.label}</label>
                    <img class="helpTooltip" name="service_notification_commands">
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 2: Centreon authentication (was tab2)                    -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-centreon">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.centreon}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_oreon.html}
                    <label class="cf-label-float">{$form.contact_oreon.label}</label>
                    <img class="helpTooltip" name="centreon_login">
                </div>
                <div class="cf-field">
                    {$form.contact_auth_type.html}
                    <label class="cf-label-float">{$form.contact_auth_type.label}</label>
                    <img class="helpTooltip" name="auth_type">
                </div>
            </div>
            {if isset($ldap) && $ldap == "1"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_ldap_dn.html}
                    <label class="cf-label-float">{$form.contact_ldap_dn.label}</label>
                    <img class="helpTooltip" name="ldap_dn">
                </div>
            </div>
            {/if}
            {if $authTypeConnectedUser == 'local' && $authTypeContact != 'ldap' && $o != "mc" && $o != "w"}
            <div id="cf-password-block">
                <div class="cf-subsection">{t}Password{/t}</div>
                {if $o == "c"}
                <div class="cf-row">
                    <div class="cf-field" style="max-width:50%;">
                        {$form.current_password.html}
                        <label class="cf-label-float">{$form.current_password.label}</label>
                        <img class="helpTooltip" name="current_password">
                    </div>
                </div>
                {/if}
                <div class="cf-row-inline">
                    <div class="cf-field" style="max-width:320px;">
                        {$form.contact_passwd.html}
                        <label class="cf-label-float">{$form.contact_passwd.label}</label>
                        <img class="helpTooltip" name="password">
                    </div>
                    <div style="flex:0 0 auto;white-space:nowrap;align-self:center;">
                        {$form.contact_gen_passwd.html}
                    </div>
                    <div class="cf-field" style="max-width:240px;">
                        {$form.contact_passwd2.html}
                        <label class="cf-label-float">{$form.contact_passwd2.label}</label>
                        <img class="helpTooltip" name="password2">
                    </div>
                </div>
            </div>
            {/if}
            {if $authTypeConnectedUser == 'local' && $authTypeContact != 'ldap' && $o != "mc" && $o != "w" && $autologinEnabled}
            <div class="cf-subsection">{t}Autologin{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:420px;">
                    {$form.contact_autologin_key.html}
                    <label class="cf-label-float">{$form.contact_autologin_key.label}</label>
                    <img class="helpTooltip" name="autologin_key">
                </div>
                <div style="flex:0 0 auto;white-space:nowrap;align-self:center;">
                    {$form.contact_gen_akey.html}
                </div>
            </div>
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 3: Access restriction                                    -->
    <!-- ================================================================ -->
    <div class="cf-section" id="cf-sec-access">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {t}Access Restriction{/t}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-subsection cf-subsection--flush">{t}Global Access Right{/t}</div>
            {if $o == "mc"}
            <div class="cf-row">
                <div class="cf-field">
                    {$form.mc_mod_acl.html}
                    <label class="cf-label-float">{$form.mc_mod_acl.label}</label>
                    <img class="helpTooltip" name="mc_update">
                </div>
            </div>
            {/if}
            <div class="cf-row-inline">
                {if $displayAdminFlag == 1}
                <div class="cf-field">
                    {$form.contact_admin.html}
                    <label class="cf-label-float">{$form.contact_admin.label}</label>
                    <img class="helpTooltip" name="admin">
                </div>
                {/if}
                <div class="cf-field">
                    {$form.contact_acl_groups.html}
                    <label class="cf-label-float">{$form.contact_acl_groups.label}</label>
                    <img class="helpTooltip" name="aclgroups">
                </div>
            </div>
            {if $displayAdminFlag == 1}
            <div class="cf-subsection">{t}API Access{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.reach_api.html}
                    <label class="cf-label-float">{$form.reach_api.label}</label>
                    <img class="helpTooltip" name="reach_api">
                </div>
                <div class="cf-field">
                    {$form.reach_api_rt.html}
                    <label class="cf-label-float">{$form.reach_api_rt.label}</label>
                    <img class="helpTooltip" name="reach_api_rt">
                </div>
            </div>
            {/if}
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Section 3: Additional (was tab3)                                 -->
    <!-- ================================================================ -->
    <div class="cf-section collapsed" id="cf-sec-additional">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.additional}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-subsection cf-subsection--flush">{$form.header.furtherAddress}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_address1.html}
                    <label class="cf-label-float">{$form.contact_address1.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
                <div class="cf-field">
                    {$form.contact_address2.html}
                    <label class="cf-label-float">{$form.contact_address2.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_address3.html}
                    <label class="cf-label-float">{$form.contact_address3.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
                <div class="cf-field">
                    {$form.contact_address4.html}
                    <label class="cf-label-float">{$form.contact_address4.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.contact_address5.html}
                    <label class="cf-label-float">{$form.contact_address5.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
                <div class="cf-field">
                    {$form.contact_address6.html}
                    <label class="cf-label-float">{$form.contact_address6.label}</label>
                    <img class="helpTooltip" name="addressx">
                </div>
            </div>

            <div class="cf-subsection">{$form.header.furtherInfos}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.contact_comment.html}
                    <label class="cf-label-float">{$form.contact_comment.label}</label>
                </div>
            </div>
            {if $o == "a" || $o == "c"}
                {if isset($form.required)}
                <div class="cf-row"><small>{$form.required._note}</small></div>
                {/if}
            {/if}
        </div>
    </div>

    <!-- Action buttons -->
    <div class="cf-actions">
        {if $o == "a" || $o == "c" || $o == "mc"}
            {$form.reset.html}
            {if isset($form.submitC)}
                {$form.submitC.html}
            {elseif isset($form.submitMC)}
                {$form.submitMC.html}
            {else}
                {$form.submitA.html}
            {/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>

{$form.hidden}
</form>
{$helptext}
<script type="text/javascript">
{literal}
    function handleReachRealTimeChange() {
        var frontEndYes = document.getElementById('contact_oreon_yes');

        var radioYes = document.getElementById('reach_api_rt_yes');
        var radioNo = document.getElementById('reach_api_rt_no');

        if (frontEndYes && radioYes && radioNo) {
            if (frontEndYes.checked) {
                radioYes.checked = true;
                radioYes.disabled = true;
                radioNo.disabled = true;

                radioYes.parentElement.style.opacity = "0.5";
                radioNo.parentElement.style.opacity = "0.5";
            } else {
                radioNo.checked = true;
                radioYes.removeAttribute('disabled');
                radioNo.removeAttribute('disabled');

                radioYes.parentElement.style.opacity = "1";
                radioNo.parentElement.style.opacity = "1";
            }
        }
    }

    window.addEventListener('load', (event) => {
        var frontEndYes = document.getElementById('contact_oreon_yes');
        var frontEndNo = document.getElementById('contact_oreon_no');

        if (frontEndYes) frontEndYes.addEventListener('click', handleReachRealTimeChange);
        if (frontEndNo) frontEndNo.addEventListener('click', handleReachRealTimeChange);
    });

    // Hide all password fields unless the auth source is Centreon (local)
    function cfToggleContactPasswords() {
        var authEl = document.getElementById('contact_auth_type');
        var block = document.getElementById('cf-password-block');
        if (!block) return;
        var val = authEl ? String(authEl.value || '').toLowerCase() : 'local';
        block.style.display = (val === 'local') ? '' : 'none';
    }

    // Grey out the ACL access list when the contact is an admin (admin = full
    // access). The control is left submittable on purpose: a disabled select is
    // not posted, and updateAccessGroupLinks() then rewrites
    // acl_group_contacts_relations from an empty list, dropping the links the
    // contact would get back when it stops being an admin.
    function cfToggleAclByAdmin() {
        var yes = document.getElementById('contact_admin_yes');
        var isAdmin = !!(yes && yes.checked);
        var acl = document.getElementById('contact_acl_groups');
        if (!acl) return;
        acl.setAttribute('aria-disabled', isAdmin ? 'true' : 'false');
        var wrap = acl.closest('.cf-field') || acl.parentElement;
        if (wrap) {
            wrap.style.opacity = isAdmin ? '0.5' : '';
            wrap.style.pointerEvents = isAdmin ? 'none' : '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        CentreonForm.initFormPage();
        CentreonForm.syncToggle('cf-contact-activate-toggle', 'contact_activate', '1', '0');
        if (window.jQuery) {
            jQuery('#contact_auth_type').on('change', cfToggleContactPasswords);
            jQuery('input[name^="contact_admin"]').on('change', cfToggleAclByAdmin);
        }
        var authEl = document.getElementById('contact_auth_type');
        if (authEl) authEl.addEventListener('change', cfToggleContactPasswords);
        ['contact_admin_yes', 'contact_admin_no'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('change', cfToggleAclByAdmin);
        });
        cfToggleContactPasswords();
        cfToggleAclByAdmin();
    });
{/literal}
</script>
