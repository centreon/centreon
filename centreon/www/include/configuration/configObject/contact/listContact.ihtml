{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

{literal}
<script type="text/javascript">
CentreonForm.detectSidePanelClose();
</script>
{/literal}

<form name='form' method='POST'>
    <div class="cl-page-header">
        <h1 class="cl-page-title">{t}Contacts{/t}</h1>
        <span class="cl-page-title-sep"></span>
        <p class="cl-page-desc">{t}Configure the users and notification contacts of your platform.{/t}</p>
    </div>
    <div class="cl-listing-container">
        <div class="cl-actions-bar cl-actions-bar--centered">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="#" class="cl-btn-add" data-panel-url="main.get.php?p={$contactPage}&o=a" data-panel-title="{t}Add a contact{/t}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">{$msg.addT}</a>
                {if isset($ldap) && $ldap == "1" }<a href="{$msg.ldap_importL}" class="cl-btn-secondary">{$msg.ldap_importT}</a>{/if}
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-toolbar-center">
                <div class="cl-search cl-search--with-adv">
                    <span class="cl-search-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                    <input type="text" id="clSearchInput" name="searchC" value="{$searchC|escape}" class="cl-search-simple" placeholder="{t}Search{/t}" autocomplete="off">
                    <button type="button" class="cl-adv-icon-btn" data-cl-adv-panel="clAdvPanel" onclick="clToggleAdvancedFilters(this)" title="{t}Advanced filters{/t}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                        <span class="cl-adv-badge"></span>
                    </button>

                    <div class="cl-adv-panel cl-adv-panel--popover" id="clAdvPanel">
                        <div class="cl-adv-inner">
                            <div class="cl-adv-fields">
                                <div class="cl-adv-field">
                                    <label>{t}Contact group{/t}</label>
                                    <div class="cl-adv-control">
                                        {$form.contactGroup.html}
                                        <button type="button" class="cl-adv-clear-field" onclick="jQuery('#contactGroup').val('').trigger('change');" title="{t}Clear{/t}">&times;</button>
                                    </div>
                                </div>
                            </div>
                            <div class="cl-adv-actions">
                                <button type="button" class="cl-adv-clear" onclick="jQuery('#contactGroup').val('').trigger('change'); document.getElementById('clSearchBtn').click();">{t}Clear{/t}</button>
                                <button type="button" id="clSearchBtn" class="cl-adv-search">{t}Search{/t}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cl-toolbar-right">
                <div class="cl-pagination" id="clPaginationTop"></div>
            </div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="contactListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_desc}</th>
                    <th>{$headerMenu_name}</th>
                    <th class="cl-col-center">{$headerMenu_email}</th>
                    <th class="cl-col-center">{$headerMenu_hostNotif}</th>
                    <th class="cl-col-center">{$headerMenu_svNotif}</th>
                    <th class="cl-col-center">{$headerMenu_lang}</th>
                    <th class="cl-col-center">{$headerMenu_access}</th>
                    <th class="cl-col-center">{$headerMenu_admin}</th>
                    <th class="cl-col-right">{t}Actions{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="10" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

    </div>

<input type='hidden' name='o' id='o' value=''>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

<!-- Side panel -->
<div class="cf-side-overlay" id="cfSideOverlay" onclick="cfClosePanel();"></div>
<div class="cf-side-panel" id="cfSidePanel">
    <div class="cf-side-panel-resize" id="cfSidePanelResize"></div>
    <div class="cf-side-panel-header">
        <span class="cf-side-panel-title" id="cfSidePanelTitle"></span>
        <button class="cf-side-panel-close" onclick="cfClosePanel();">&times;</button>
    </div>
    <div class="cf-side-panel-body">
        <iframe id="cfSidePanelFrame" src="about:blank"></iframe>
    </div>
</div>

{literal}
<script type="text/javascript">

var contactListing = new CentreonListing({
    instanceName:  'contactListing',
    ajaxListUrl:   './include/configuration/configObject/contact/ajaxContactListing.php',
    ajaxToggleUrl: './include/configuration/configObject/contact/ajaxContactToggle.php',
    pageId:        {/literal}'{$contactPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'contact_listing_limit',
    extraParams:   function() { var cg = jQuery('#contactGroup').val(); return (cg && cg !== '') ? { contactGroup: cg } : {}; },
    autoRefresh:   30000,
    liveSearch:    true,
    rowIdField:    'id',
    columns: [
        { id:'alias', render: function(row, l) {
            var editUrl = 'main.get.php?p={/literal}{$contactPage}{literal}&o=c&contact_id=' + row.id;
            var icon = row.admin ? './img/icons/admin.svg' : './img/icons/user.svg';
            var title = row.admin ? '{/literal}{t}Administrator{/t}{literal}' : '{/literal}{t}User{/t}{literal}';
            return '<a href="#" data-panel-url="'+clEscapeAttr(editUrl)+'" data-panel-title="{/literal}{t}Modify a Contact{/t}{literal}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;"><img src="'+icon+'" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;" title="'+title+'" />'+l.escape(row.alias||'')+'</a>';
        }},
        { id:'name', render: function(row, l) {
            var editUrl = 'main.get.php?p={/literal}{$contactPage}{literal}&o=c&contact_id=' + row.id;
            return '<a href="#" data-panel-url="'+clEscapeAttr(editUrl)+'" data-panel-title="{/literal}{t}Modify a Contact{/t}{literal}" onclick="cfOpenPanel(this.dataset.panelUrl, this.dataset.panelTitle); return false;">'+l.escape(row.name)+'</a>';
        }},
        { id:'email', align:'center' },
        { id:'host_notif', align:'center', render: function(row, l) { return row.host_notif ? l.escape(row.host_notif) : '-'; }},
        { id:'svc_notif', align:'center', render: function(row, l) { return row.svc_notif ? l.escape(row.svc_notif) : '-'; }},
        { id:'lang', align:'center' },
        { id:'access', align:'center', render: function(row) {
            return row.access
                ? '<span class="cl-tag cl-tag--success">Enabled</span>'
                : '<span class="cl-tag cl-tag--neutral">Disabled</span>';
        }},
        { id:'admin', align:'center', render: function(row) {
            return row.admin
                ? '<span class="cl-tag cl-tag--info">Yes</span>'
                : '<span class="cl-tag cl-tag--neutral">No</span>';
        }}
    ],
    renderOptions: function(row, l) {
        // Cannot toggle yourself
        var checked = row.activate ? ' checked' : '';
        // Unblock action for locked users (admin only); full reload after the action.
        var unblock = '';
        if (row.blocked) {
            unblock = '<a href="main.get.php?p={/literal}{$contactPage}{literal}&o=un&contact_id=' + row.id + '&centreon_token={/literal}{$centreonToken}{literal}" title="{/literal}{t}Unblock{/t}{literal}" class="cl-unblock" style="margin-right:8px;" onclick="return confirm(\'{/literal}{t escape='js'}Do you really want to unblock this user?{/t}{literal}\');"><img src="./img/icons/lock_closed.png" class="ico-14"/></a>';
        }
        var dup = '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
        if (row.is_current_user) {
            // Show toggle disabled for current user (can't self-disable)
            return unblock + '<label class="cl-toggle"><input type="checkbox"'+checked+' disabled /><span class="cl-toggle-slider"></span></label>' + dup;
        }
        return unblock + '<label class="cl-toggle"><input type="checkbox" data-row-id="'+row.id+'"'+checked+' onchange="contactListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' + dup;
    }
});
contactListing.init();
CentreonForm.initSidePanel(contactListing);

jQuery('#clClearBtn').on('click', function() {
    jQuery('#clSearchInput').val('');
    jQuery('#contactGroup').val('').trigger('change');
    var state = contactListing.getState();
    contactListing.fetch(0, state.limit, '');
});
</script>
{/literal}
