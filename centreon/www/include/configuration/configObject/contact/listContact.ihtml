<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

<form name='form' method='POST'>
    <div class="cl-filter-box">
        <div class="cl-filter-bar">
            <span class="cl-filter-label">{t}Contact{/t}</span>
            <input type="text" id="clSearchInput" name="searchC" value="{$searchC}" class="cl-search-input" placeholder="{t}Name or alias{/t}">
            <span class="cl-filter-label" style="margin-left:8px;">{t}Contact group{/t}</span>
            {$form.contactGroup.html}<button type="button" id="clClearBtn" title="{t}Clear filters{/t}" style="background:none;border:none;cursor:pointer;font-size:16px;color:var(--color-danger,#FF4A4A);padding:4px 2px;margin-left:-2px;">&times;</button>
            <button type="button" id="clSearchBtn" class="btc bt_success" style="margin-left:4px;">{t}Search{/t}</button>
        </div>
    </div>
    <div class="cl-listing-container">
        <div class="cl-actions-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                <a href="{$msg.addL}" class="cl-btn-add">{$msg.addT}</a>
                {if isset($ldap) && $ldap == "1" }<a href="{$msg.ldap_importL}" class="btc bt_info ml-2">{$msg.ldap_importT}</a>{/if}
                {$form.o1.html}
            </div>
            { else }
            <div class="cl-actions-left">&nbsp;</div>
            { /if }
            <div class="cl-pagination" id="clPaginationTop"></div>
        </div>

        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th class="cl-col-picker">
                        <div class="md-checkbox md-checkbox-inline">
                            <input type="checkbox" id="checkall" name="checkall" onclick="contactListing.checkUncheckAll(this);"/>
                            <label class="empty-label" for="checkall"></label>
                        </div>
                    </th>
                    <th>{$headerMenu_desc}</th>
                    <th>{$headerMenu_name}</th>
                    <th class="cl-col-center">{$headerMenu_email}</th>
                    <th class="cl-col-center">{$headerMenu_hostNotif}</th>
                    <th class="cl-col-center">{$headerMenu_svNotif}</th>
                    <th class="cl-col-center">{$headerMenu_lang}</th>
                    <th class="cl-col-center">{$headerMenu_access}</th>
                    <th class="cl-col-center">{$headerMenu_admin}</th>
                    <th class="cl-col-right">{$headerMenu_options}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="10" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>

        <div class="cl-bottom-bar">
            { if $mode_access == 'w' }
            <div class="cl-actions-left">
                {$form.o2.html}
            </div>
            { else }
            <div>&nbsp;</div>
            { /if }
            <div class="cl-pagination" id="clPaginationBottom"></div>
        </div>
    </div>

<input type='hidden' name='o' id='o' value='42'>
<input type='hidden' id='limit' name='limit' value=''>
{$form.hidden}
</form>

{literal}
<script type="text/javascript">
var contactListing = new CentreonListing({
    instanceName:  'contactListing',
    ajaxListUrl:   './include/configuration/configObject/contact/ajaxContactListing.php',
    ajaxToggleUrl: './include/configuration/configObject/contact/ajaxContactToggle.php',
    pageId:        {/literal}'{$contactPage}'{literal},
    writeAccess:   {/literal}'{$mode_access}'{literal} === 'w',
    defaultLimit:  {/literal}{$defaultLimit}{literal},
    storageKey:    'contact_listing_limit',
    emptyMessage:  'No contacts found',
    extraParams:   function() { var cg = jQuery('#contactGroup').val(); console.log('contactGroup filter value:', cg); return (cg && cg !== '') ? { contactGroup: cg } : {}; },
    autoRefresh:   30000,
    rowIdField:    'id',
    columns: [
        { id:'alias', render: function(row, l) {
            var link = 'main.php?p={/literal}{$contactPage}{literal}&o=c&contact_id=' + row.id;
            var icon = row.admin ? './img/icons/admin.svg' : './img/icons/user.svg';
            var title = row.admin ? 'Administrator' : 'User';
            return '<a href="'+link+'"><img src="'+icon+'" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;" title="'+title+'" />'+l.escape(row.alias||'')+'</a>';
        }},
        { id:'name', render: function(row, l) {
            var link = 'main.php?p={/literal}{$contactPage}{literal}&o=c&contact_id=' + row.id;
            return '<a href="'+link+'">'+l.escape(row.name)+'</a>';
        }},
        { id:'email', align:'center' },
        { id:'host_notif', align:'center' },
        { id:'svc_notif', align:'center' },
        { id:'lang', align:'center' },
        { id:'access', align:'center', render: function(row) { return row.access ? 'Enabled' : 'Disabled'; }},
        { id:'admin', align:'center', render: function(row) { return row.admin ? 'Yes' : 'No'; }}
    ],
    renderOptions: function(row, l) {
        // Cannot toggle yourself
        var checked = row.activate ? ' checked' : '';
        if (row.is_current_user) {
            // Show toggle disabled for current user (can't self-disable)
            return '<label class="cl-toggle"><input type="checkbox"'+checked+' disabled /><span class="cl-toggle-slider"></span></label>' +
                '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
        }
        return '<label class="cl-toggle"><input type="checkbox" data-row-id="'+row.id+'"'+checked+' onchange="contactListing.toggleActivation(this);"/><span class="cl-toggle-slider"></span></label>' +
            '<input onKeypress="if(event.keyCode>31&&(event.keyCode<45||event.keyCode>57))event.returnValue=false;if(event.which>31&&(event.which<45||event.which>57))return false;" maxlength="3" size="3" value="1" class="cl-dup-input" name="dupNbr['+row.id+']"/>';
    }
});
contactListing.init();

jQuery('#clClearBtn').on('click', function() {
    jQuery('#clSearchInput').val('');
    jQuery('#contactGroup').val('').trigger('change');
    var state = contactListing.getState();
    contactListing.fetch(0, state.limit, '');
});
</script>
{/literal}
