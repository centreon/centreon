{$form.javascript}
<link href="./include/common/form/form.css" rel="stylesheet" type="text/css" />

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.ftitle}</h1>

    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:260px;">
                    {$form.name.html}
                    <label class="cf-label-float">{$form.name.label}</label>
                    <img class="helpTooltip" name="tip_template_name">
                </div>
                <div class="cf-field">
                    {$form.vertical_label.html}
                    <label class="cf-label-float">{$form.vertical_label.label}</label>
                    <img class="helpTooltip" name="tip_vertical_label">
                </div>
                <div class="cf-field">
                    {$form.default_tpl1.html}
                    <label class="cf-label-float">{$form.default_tpl1.label}</label>
                </div>
            </div>

            <div class="cf-subsection">{t}Graph size{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.width.html}&nbsp;px
                    <label class="cf-label-float">{$form.width.label}</label>
                    <img class="helpTooltip" name="tip_width">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.height.html}&nbsp;px
                    <label class="cf-label-float">{$form.height.label}</label>
                    <img class="helpTooltip" name="tip_height">
                </div>
            </div>

            <div class="cf-subsection">{t}Limits{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.lower_limit.html}
                    <label class="cf-label-float">{$form.lower_limit.label}</label>
                    <img class="helpTooltip" name="tip_lower_limit">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.upper_limit.html}
                    <label class="cf-label-float">{$form.upper_limit.label}</label>
                    <img class="helpTooltip" name="tip_upper_limit">
                </div>
                <div class="cf-field">
                    {$form.size_to_max.html}
                    <label class="cf-label-float">{$form.size_to_max.label}</label>
                </div>
            </div>

            <div class="cf-subsection">{t}Scaling parameters{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.base.html}
                    <label class="cf-label-float">{$form.base.label}</label>
                    <img class="helpTooltip" name="tip_base">
                </div>
                <div class="cf-field">
                    {$form.scaled.html}
                    <label class="cf-label-float">{$form.scaled.label}</label>
                    <img class="helpTooltip" name="tip_scale_graph_values">
                </div>
            </div>

            <div class="cf-row">
                <div class="cf-field">
                    {$form.comment.html}
                    <label class="cf-label-float">{$form.comment.label}</label>
                    <img class="helpTooltip" name="tip_comments">
                </div>
            </div>

            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small>{if isset($form.required)}{$form.required._note}{/if}</small></div>
            {/if}
        </div>
    </div>

    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}{$form.submitC.html}{/if}
            {$form.submitA.html}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Solo checkboxes (size_to_max, scaled, default_tpl1) auto-convert to
    // design-system toggles; "size to max" greys the upper limit via the
    // declarative data-cf-disables attribute (see formGraphTemplate.php).
    CentreonForm.initFormPage();
});
</script>
{/literal}
