{$form.javascript}
<link href="./include/common/form/form.css" rel="stylesheet" type="text/css" />
{literal}
<style type="text/css">
/* iPhone toggle (self-contained) */
.cf-form-wrapper .cl-toggle { position: relative; top: auto; left: auto; margin: 0; padding: 0; display: inline-block; width: 36px; height: 20px; cursor: pointer; flex-shrink: 0; pointer-events: auto; }
.cf-form-wrapper .cl-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.cf-form-wrapper .cl-toggle-slider { position: absolute; inset: 0; background: #ccc; border-radius: 20px; transition: background .25s; pointer-events: auto; }
.cf-form-wrapper .cl-toggle-slider::before { content: ''; position: absolute; height: 16px; width: 16px; left: 2px; bottom: 2px; background: #fff; border-radius: 50%; transition: transform .25s; box-shadow: 0 1px 3px rgba(0,0,0,.2); }
.cf-form-wrapper .cl-toggle input:checked + .cl-toggle-slider { background: var(--color-success, #88B922); }
.cf-form-wrapper .cl-toggle input:checked + .cl-toggle-slider::before { transform: translateX(16px); }
.cf-field-toggle { display: flex; align-items: center; gap: 10px; }
.cf-field-toggle .cf-toggle-label { position: static; pointer-events: auto; font-size: 13px; color: var(--list-color, #333); }
.cf-field-toggle .helpTooltip { position: static; }
</style>
{/literal}

<form {$form.attributes}>
<div class="cf-form-wrapper">

    <h1 class="cf-page-title">{$form.header.ftitle}</h1>

    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.name.html}
                    <label class="cf-label-float">{$form.name.label}</label>
                    <img class="helpTooltip" name="tip_template_name">
                </div>
                <div class="cf-field">
                    {$form.vertical_label.html}
                    <label class="cf-label-float">{$form.vertical_label.label}</label>
                    <img class="helpTooltip" name="tip_vertical_label">
                </div>
            </div>

            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.width.html}&nbsp;px
                    <label class="cf-label-float">{$form.width.label}</label>
                    <img class="helpTooltip" name="tip_width">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.height.html}&nbsp;px
                    <label class="cf-label-float">{$form.height.label}</label>
                    <img class="helpTooltip" name="tip_height">
                </div>
            </div>

            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.lower_limit.html}
                    <label class="cf-label-float">{$form.lower_limit.label}</label>
                    <img class="helpTooltip" name="tip_lower_limit">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.upper_limit.html}
                    <label class="cf-label-float">{$form.upper_limit.label}</label>
                    <img class="helpTooltip" name="tip_upper_limit">
                </div>
                <div class="cf-field">
                    {$form.size_to_max.html}
                    <label class="cf-label-float">{$form.size_to_max.label}</label>
                </div>
            </div>

            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.base.html}
                    <label class="cf-label-float">{$form.base.label}</label>
                    <img class="helpTooltip" name="tip_base">
                </div>
                <div class="cf-field">
                    {$form.scaled.html}
                    <label class="cf-label-float">{$form.scaled.label}</label>
                    <img class="helpTooltip" name="tip_scale_graph_values">
                </div>
                <div class="cf-field">
                    {$form.default_tpl1.html}
                    <label class="cf-label-float">{$form.default_tpl1.label}</label>
                    <img class="helpTooltip" name="tip_default_centreon_graph_template">
                </div>
            </div>

            <div class="cf-row">
                <div class="cf-field">
                    {$form.comment.html}
                    <label class="cf-label-float">{$form.comment.label}</label>
                    <img class="helpTooltip" name="tip_comments">
                </div>
            </div>

            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small>{if isset($form.required)}{$form.required._note}{/if}</small></div>
            {/if}
        </div>
    </div>

    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}{$form.submitC.html}{/if}
            {$form.submitA.html}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();

    function cfMakeToggle(name) {
        var input = document.querySelector('input[name="' + name + '"]');
        if (!input) return;
        var field = input.closest('.cf-field');
        if (!field) return;
        var lbl = field.querySelector('.cf-label-float');
        var text = lbl ? lbl.textContent.trim() : '';
        var help = field.querySelector('.helpTooltip');
        var toggle = document.createElement('label');
        toggle.className = 'cl-toggle';
        toggle.appendChild(input);
        var slider = document.createElement('span');
        slider.className = 'cl-toggle-slider';
        toggle.appendChild(slider);
        field.innerHTML = '';
        field.classList.add('cf-field-toggle');
        field.appendChild(toggle);
        var span = document.createElement('span');
        span.className = 'cf-toggle-label';
        span.textContent = text;
        field.appendChild(span);
        if (help) field.appendChild(help);
    }
    ['size_to_max', 'scaled', 'default_tpl1'].forEach(cfMakeToggle);
});
</script>
{/literal}
