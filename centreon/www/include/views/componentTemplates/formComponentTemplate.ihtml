{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper formTable">

    <h1 class="cf-page-title">{$form.header.ftitle}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-display" onclick="cfScrollTo('cf-sec-display', this); return false;">{$form.header.options}</a>
        <a href="#cf-sec-legend" onclick="cfScrollTo('cf-sec-legend', this); return false;">{$form.header.legend}</a>
    </div>

    <!-- ============================ General information ============================ -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:320px;">
                    {$form.name.html}
                    <label class="cf-label-float">{$form.name.label}</label>
                    <img class="helpTooltip" name="tip_template_name">
                </div>
                <div class="cf-field">
                    {$form.host_service_id.html}
                    <label class="cf-label-float">{$form.host_service_id.label}</label>
                    <img class="helpTooltip" name="tip_host_service_data_source">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small style="color:var(--c-text-secondary,#6b7280);">{$form.hsr_text.label}</small></div>
            {/if}
            <div class="cf-row">
                <div class="cf-field">
                    <div style="display:flex;align-items:center;gap:6px;">
                        {$form.ds_name.html}
                        {if $o == "a" || $o == "c"}
                            <img src="./img/icons/arrow-left.png" class="ico-14" style="cursor:pointer;" onclick="insertValueQuery()"/>
                            <select id="sl_list_metrics" class="metrics" size="1"></select>
                        {/if}
                    </div>
                    <label class="cf-label-float">{$form.ds_name.label}</label>
                    <img class="helpTooltip" name="tip_data_source_name">
                </div>
            </div>
        </div>
    </div>

    <!-- ============================ Display / colors ============================ -->
    <div class="cf-section" id="cf-sec-display">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.options}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.ds_stack.html}
                    <label class="cf-label-float">{$form.ds_stack.label}</label>
                    <img class="helpTooltip" name="tip_stack">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.ds_order.html}
                    <label class="cf-label-float">{$form.ds_order.label}</label>
                    <img class="helpTooltip" name="tip_order">
                </div>
                <div class="cf-field">
                    {$form.ds_invert.html}
                    <label class="cf-label-float">{$form.ds_invert.label}</label>
                    <img class="helpTooltip" name="tip_invert">
                </div>
            </div>

            <div class="cf-subsection">{$form.header.color}</div>
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.ds_tickness.html}&nbsp;px
                    <label class="cf-label-float">{$form.ds_tickness.label}</label>
                    <img class="helpTooltip" name="tip_thickness">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.ds_transparency.html}&nbsp;%
                    <label class="cf-label-float">{$form.ds_transparency.label}</label>
                    <img class="helpTooltip" name="tip_transparency">
                </div>
                <div class="cf-field">
                    {$form.ds_filled.html}
                    <label class="cf-label-float">{$form.ds_filled.label}</label>
                    <img class="helpTooltip" name="tip_filling">
                </div>
            </div>

            <!-- Line color (raw widgets preserved so the colour picker keeps working) -->
            <div class="cf-row">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <img class="helpTooltip" name="tip_line_color">
                    <span style="font-size:13px;font-weight:600;color:var(--list-color,#333);">{$form.ds_color_line.label}</span>
                </div>
                {if $o == "a" || $o == "c"}
                <div>
                    {$form.ds_color_line_mode.html}<br/>
                    <span class="pull-left">{$form.ds_color_line.html}&nbsp;&nbsp;{$form.ds_color_line_color.html}</span>
                    <label>
                        {if isset($form.ds_random_color_line)}
                            <span style="margin-left: 5px" class="pull-left">{$form.ds_random_color_line.html}</span>
                            {$form.ds_random_color_line.label}
                        {/if}
                    </label>
                </div>
                {/if}
                {if $o == "w"}
                <div style="font-size:11px;font-family:'Courier New';">{$form.ds_color_line_read.html}</div>
                {/if}
            </div>

            <!-- Area colors (ok / warning / critical) -->
            <div class="cf-row">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <img class="helpTooltip" name="tip_area_color">
                    <span style="font-size:13px;font-weight:600;color:var(--list-color,#333);">{$form.ds_color_area.label}</span>
                </div>
                {if $o == "a" || $o == "c"}
                <div style="display:flex;gap:16px;flex-wrap:wrap;">
                    <span>{$form.ds_color_area.html}&nbsp;&nbsp;{$form.ds_color_area_color.html}</span>
                    <span>{$form.ds_color_area_warn.html}&nbsp;&nbsp;{$form.ds_color_area_warn_color.html}</span>
                    <span>{$form.ds_color_area_crit.html}&nbsp;&nbsp;{$form.ds_color_area_crit_color.html}</span>
                </div>
                {/if}
                {if $o == "w"}
                <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:11px;font-family:'Courier New';">
                    <span>{$form.ds_color_area_read.html}</span>
                    <span>{$form.ds_color_area_warn_read.html}</span>
                    <span>{$form.ds_color_area_crit_read.html}</span>
                </div>
                {/if}
            </div>
        </div>
    </div>

    <!-- ============================ Legend ============================ -->
    <div class="cf-section" id="cf-sec-legend">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.legend}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.ds_legend.html}
                    <label class="cf-label-float">{$form.ds_legend.label}</label>
                    <img class="helpTooltip" name="tip_legend_name">
                </div>
                <div class="cf-field">
                    {$form.ds_hidecurve.html}
                    <label class="cf-label-float">{$form.ds_hidecurve.label}</label>
                    <img class="helpTooltip" name="tip_display_only_the_legend">
                </div>
                <div class="cf-field">
                    {$form.ds_jumpline.html}
                    <label class="cf-label-float">{$form.ds_jumpline.label}</label>
                    <img class="helpTooltip" name="tip_empty_line_after_this_legend">
                </div>
            </div>

            <div class="cf-subsection">{t}Values printed in the legend{/t}</div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.ds_max.html}
                    <label class="cf-label-float">{$form.ds_max.label}</label>
                    <img class="helpTooltip" name="tip_print_max_value">
                </div>
                <div class="cf-field">
                    {$form.ds_min.html}
                    <label class="cf-label-float">{$form.ds_min.label}</label>
                    <img class="helpTooltip" name="tip_print_min_value">
                </div>
                <div class="cf-field">
                    {$form.ds_minmax_int.html}
                    <label class="cf-label-float">{$form.ds_minmax_int.label}</label>
                    <img class="helpTooltip" name="tip_print_minmax_int">
                </div>
            </div>
            <div class="cf-row-inline">
                <div class="cf-field">
                    {$form.ds_average.html}
                    <label class="cf-label-float">{$form.ds_average.label}</label>
                    <img class="helpTooltip" name="tip_print_average">
                </div>
                <div class="cf-field">
                    {$form.ds_last.html}
                    <label class="cf-label-float">{$form.ds_last.label}</label>
                    <img class="helpTooltip" name="tip_print_last_value">
                </div>
                <div class="cf-field">
                    {$form.ds_total.html}
                    <label class="cf-label-float">{$form.ds_total.label}</label>
                    <img class="helpTooltip" name="tip_print_total_value">
                </div>
            </div>

            <div class="cf-subsection">{t}Misc{/t}</div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.comment.html}
                    <label class="cf-label-float">{$form.comment.label}</label>
                    <img class="helpTooltip" name="tip_comments">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small>{if isset($form.required)}{$form.required.note}{/if}</small></div>
            {/if}
        </div>
    </div>

    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}{$form.submitC.html}{/if}
            {if isset($form.submitA)}{$form.submitA.html}{/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

<script type="text/javascript">
{literal}
function activate_color_selection(e) {
    var $this = jQuery(this);
    if (jQuery('input[name="compo_id"]').attr('value') == '1' && $this.attr('value') == '0') {
        jQuery('input:radio[name*="ds_color_line_mode"]:nth(0)').attr('checked', true);
        return;
    }
    if ($this.attr('value') == '1') {
        jQuery('input[name="ds_color_line"]').attr('disabled', '');
        jQuery('input[name="ds_color_line_color"]').attr('disabled', '');
    } else {
        jQuery('input[name="ds_color_line"]').removeAttr('disabled');
        jQuery('input[name="ds_color_line_color"]').removeAttr('disabled');
    }
}

jQuery(document).ready(function() {
    jQuery('input[name$="_color"]').click(function(e) {
        let name = jQuery(this).attr('name');
        popup_color_picker(name.replace(/_color$/g, ''), name);
    });
    jQuery('input[name$="_color"]').click(activate_color_selection);
    activate_color_selection.apply(jQuery('input[name$="_color"]:checked'));
});
{/literal}
</script>
{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}
