{$form.javascript}

<form {$form.attributes}>
<div class="cf-form-wrapper formTable">

    <h1 class="cf-page-title">{$form.header.ftitle}</h1>

    <div class="cf-tab-nav">
        <a href="#cf-sec-info" class="active" onclick="cfScrollTo('cf-sec-info', this); return false;">{$form.header.information}</a>
        <a href="#cf-sec-fct" onclick="cfScrollTo('cf-sec-fct', this); return false;">{$form.header.function}</a>
        <a href="#cf-sec-options" onclick="cfScrollTo('cf-sec-options', this); return false;">{$form.header.options}</a>
    </div>

    <!-- ============================ General information ============================ -->
    <div class="cf-section" id="cf-sec-info">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.information}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:320px;">
                    {$form.vmetric_name.html}
                    <label class="cf-label-float">{$form.vmetric_name.label}</label>
                    <img class="helpTooltip" name="tip_metric_name">
                </div>
                <div class="cf-field">
                    {$form.host_id.html}
                    <label class="cf-label-float">{$form.host_id.label}</label>
                    <img class="helpTooltip" name="tip_host_service_data_source">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.def_type.html}
                    <label class="cf-label-float">{$form.def_type.label}</label>
                    <img class="helpTooltip" name="tip_def_type">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small style="color:var(--c-text-secondary,#6b7280);">{$form.hsr_text.label}</small></div>
            {/if}
        </div>
    </div>

    <!-- ============================ RPN function ============================ -->
    <div class="cf-section" id="cf-sec-fct">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.function}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    <div style="display:flex;align-items:flex-start;gap:6px;">
                        {$form.rpn_function.html}
                        {if $o == "a" || $o == "c"}
                            <img src="./img/icons/arrow-left.png" class="ico-14" style="cursor:pointer;margin-top:4px;" onclick="insertValueQuery()"/>
                            <select id="sl_list_metrics" size="1"></select>
                        {/if}
                    </div>
                    <label class="cf-label-float">{$form.rpn_function.label}</label>
                    <img class="helpTooltip" name="tip_rpn_function">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small style="color:var(--c-text-secondary,#6b7280);">{$form.rpn_text.label}</small></div>
            {/if}
            <div class="cf-row-inline">
                <div class="cf-field" style="max-width:220px;">
                    {$form.unit_name.html}
                    <label class="cf-label-float">{$form.unit_name.label}</label>
                    <img class="helpTooltip" name="tip_metric_unit">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.warn.html}
                    <label class="cf-label-float">{$form.warn.label}</label>
                    <img class="helpTooltip" name="tip_warning_threshold">
                </div>
                <div class="cf-field" style="max-width:220px;">
                    {$form.crit.html}
                    <label class="cf-label-float">{$form.crit.label}</label>
                    <img class="helpTooltip" name="tip_critical_threshold">
                </div>
            </div>
        </div>
    </div>

    <!-- ============================ Options ============================ -->
    <div class="cf-section" id="cf-sec-options">
        <div class="cf-section-header" onclick="cfToggleSection(this)">
            {$form.header.options}
            <span class="cf-section-chevron">&#9660;</span>
        </div>
        <div class="cf-section-body">
            <div class="cf-row">
                <div class="cf-field">
                    {$form.vhidden.html}
                    <label class="cf-label-float">{$form.vhidden.label}</label>
                    <img class="helpTooltip" name="tip_hidden_graph_and_legend">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-field">
                    {$form.comment.html}
                    <label class="cf-label-float">{$form.comment.label}</label>
                    <img class="helpTooltip" name="tip_comments">
                </div>
            </div>
            {if $o == "a" || $o == "c"}
            <div class="cf-row"><small>{if isset($form.required)}{$form.required.note}{/if}</small></div>
            {/if}
        </div>
    </div>

    <div class="cf-actions">
        {if $o == "a" || $o == "c"}
            {$form.reset.html}
            {if isset($form.submitC)}{$form.submitC.html}{/if}
            {if isset($form.submitA)}{$form.submitA.html}{/if}
        {else if $o == "w"}
            {if isset($form.change)}{$form.change.html}{/if}
        {/if}
    </div>

</div>
{$form.hidden}
</form>
{$helptext}

{literal}
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    CentreonForm.initFormPage();
});
</script>
{/literal}
