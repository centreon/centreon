{include file="file:$centreon_path/www/include/common/templates/clI18n.ihtml"}
<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

<div class="cl-scroll-wrapper">
    <div class="cl-filter-box">
        <div class="cl-filter-bar">
            <span class="cl-filter-label">{t}Object{/t}</span>
            <input type="text" id="clSearchInput" name="searchO" value="" placeholder="{t}Search{/t}" class="cl-search-input">
            <span class="cl-filter-label">{t}User{/t}</span>
            <input type="text" id="clSearchUser" name="searchU" value="" placeholder="{t}Search{/t}" class="cl-search-input">
            <span class="cl-filter-label">{t}Type{/t}</span>
            <select id="clSearchType" class="cl-search-input">
                <option value="">{t}All{/t}</option>
                {foreach key=objectType item=objectTypeLabel from=$objectTypes}
                <option value="{$objectType|escape:'html'}">{$objectTypeLabel|escape:'html'}</option>
                {/foreach}
            </select>
            <button type="button" id="clSearchBtn" class="btc bt_success">{t}Search{/t}</button>
        </div>
    </div>

    <div class="cl-actions-bar">
        <div class="cl-actions-left">&nbsp;</div>
        <div class="cl-pagination" id="clPaginationTop" style="font-size:12px;"></div>
    </div>

    <div class="cl-scroll-area" id="clScrollContainer">
        <table class="cl-listing-table">
            <thead>
                <tr>
                    <th style="width:30px"></th>
                    <th style="width:170px">{t}Date{/t}</th>
                    <th class="cl-col-center" style="width:120px">{t}Modification type{/t}</th>
                    <th style="width:140px">{t}Object Type{/t}</th>
                    <th>{t}Object Name{/t}</th>
                    <th style="width:180px">{t}Author{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="6" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>
    </div>

    <div class="cl-pagination" id="clPaginationBottom" style="font-size:12px;padding:4px 8px;flex-shrink:0;"></div>
</div>

<script type="text/javascript">
    // Page-specific translations: listing.js is a static asset and cannot use
    // {t}...{/t}, so the strings it renders are exposed here (same mechanism as
    // window.clI18n in clI18n.ihtml).
    window.changelogI18n = {ldelim}
        actions: {ldelim}
            a: "{t escape='js'}Added{/t}",
            c: "{t escape='js'}Changed{/t}",
            mc: "{t escape='js'}Mass Change{/t}",
            enable: "{t escape='js'}Enabled{/t}",
            disable: "{t escape='js'}Disabled{/t}",
            d: "{t escape='js'}Deleted{/t}"
        {rdelim},
        objectTypes: {ldelim}
            {foreach key=objectType item=objectTypeLabel from=$objectTypeLabels name=types}
            "{$objectType|escape:'javascript'}": "{$objectTypeLabel|escape:'javascript'}"{if ! $smarty.foreach.types.last},{/if}
            {/foreach}
        {rdelim},
        diff: {ldelim}
            field: "{t escape='js'}Field Name{/t}",
            before: "{t escape='js'}Before{/t}",
            after: "{t escape='js'}After{/t}",
            value: "{t escape='js'}Value{/t}",
            loading: "{t escape='js'}Loading...{/t}",
            empty: "{t escape='js'}No modification was made.{/t}"
        {rdelim},
        author: {ldelim}
            system: "System",
            unknown: "{t escape='js'}unknown{/t}"
        {rdelim}
    {rdelim};
</script>

{literal}
<script type="text/javascript">
(function() {
    var i18n = window.changelogI18n;

    // Action code -> badge colour. Codes come straight from
    // log_action.action_type (ActionLog), the label is translated separately.
    var badgeClass = {
        'a': 'service_ok',
        'c': 'service_warning',
        'mc': 'service_warning',
        'enable': 'service_ok',
        'disable': 'service_critical',
        'd': 'service_critical'
    };

    // Enabling, disabling or deleting an object records no field change, so
    // there is nothing to expand for those.
    var expandableActions = { 'a': true, 'c': true, 'mc': true };

    var detailUrl = './include/Administration/configChangelog/ajaxChangelogDetail.php';

    // Toggle detail row
    function toggleDetail(btn, actionLogId) {
        var tr = jQuery(btn).closest('tr');
        var detailId = 'cl-detail-' + actionLogId;
        var existing = jQuery('#' + detailId);

        if (existing.length) {
            existing.remove();
            jQuery(btn).removeClass('open').text('+');
            return;
        }

        jQuery(btn).addClass('open').text('−');

        // Insert detail row after current row
        var colCount = tr.find('td').length;
        var detailRow = jQuery(
            '<tr id="' + detailId + '" class="cl-detail-row">' +
            '<td colspan="' + colCount + '">' +
            '<div class="cl-diff-container"><div class="cl-diff-loading"></div></div>' +
            '</td></tr>'
        );
        detailRow.find('.cl-diff-loading').text(i18n.diff.loading);
        tr.after(detailRow);

        // Fetch detail
        jQuery.ajax({
            url: detailUrl,
            type: 'GET',
            dataType: 'json',
            data: { action_log_id: actionLogId },
            success: function(data) {
                var container = detailRow.find('.cl-diff-container');
                container.empty();

                if (!data.diff || data.diff.length === 0) {
                    container.append(jQuery('<div class="cl-diff-empty"></div>').text(i18n.diff.empty));
                    return;
                }

                var isCreate = data.action_type === 'a';

                // Header
                var header = '<div class="cl-diff-header">' +
                    '<span>' + clEscape(i18n.diff.field) + '</span>';
                if (!isCreate) {
                    header += '<span>' + clEscape(i18n.diff.before) + '</span>';
                }
                header += '<span>' + clEscape(isCreate ? i18n.diff.value : i18n.diff.after) + '</span></div>';
                container.append(header);

                // Rows
                for (var i = 0; i < data.diff.length; i++) {
                    var d = data.diff[i];
                    var row = '<div class="cl-diff-row">' +
                        '<div class="cl-diff-field">' + clEscape(d.field) + '</div>';
                    if (!isCreate) {
                        row += '<div class="cl-diff-before">' + clEscape(d.before) + '</div>';
                    }
                    row += '<div class="cl-diff-after">' + clEscape(d.after) + '</div>';
                    row += '</div>';
                    container.append(row);
                }
            },
            error: function() {
                detailRow.find('.cl-diff-container').empty().append(
                    jQuery('<div class="cl-diff-empty cl-diff-error"></div>')
                        .text(clListingLabel('loadError', 'Error loading data'))
                );
            }
        });
    }

    // Make toggleDetail available globally for onclick
    window._clToggleDetail = toggleDetail;

    var logListing = new CentreonListing({
        instanceName:  'logListing',
        ajaxListUrl:   './include/Administration/configChangelog/ajaxChangelogListing.php',
        pageId:        '{/literal}{$p}{literal}',
        writeAccess:   false,
        showCheckboxes: false,
        defaultLimit:  {/literal}{$defaultLimit}{literal},
        storageKey:    'changelog_listing',
        infiniteScroll: true,
        scrollContainerId: 'clScrollContainer',
        rowIdField:    'action_log_id',
        extraParams:   function() {
            return {
                searchUser: document.getElementById('clSearchUser').value,
                objectType: document.getElementById('clSearchType').value
            };
        },
        columns: [
            { id:'_expand', render: function(row) {
                if (!expandableActions[row.action_type]) {
                    return '<span class="cl-expand-btn disabled">+</span>';
                }
                return '<span class="cl-expand-btn" onclick="window._clToggleDetail(this,' + row.action_log_id + ')">+</span>';
            }},
            { id:'date', render: function(row) {
                if (!row.date) return '';
                // Rendered by formatDateMoment() (onDataLoaded) so the date
                // follows the user's timezone and locale, not the browser's.
                return '<span class="isTimestamp">' + clEscape(String(row.date)) + '</span>';
            }},
            { id:'action_type', align:'center', render: function(row, l) {
                var cls = badgeClass[row.action_type] || 'service_warning';
                return '<span class="badge ' + cls + '">' +
                    l.escape(i18n.actions[row.action_type] || row.action_type) + '</span>';
            }},
            { id:'object_type', render: function(row, l) {
                return l.escape(i18n.objectTypes[row.object_type] || row.object_type);
            }},
            { id:'object_name', render: function(row, l) {
                var pageId = '{/literal}{$p}{literal}';
                var link = 'main.php?p=' + pageId +
                    '&object_type=' + encodeURIComponent(row.object_type) +
                    '&object_id=' + encodeURIComponent(row.object_id);
                return '<a href="' + clEscapeAttr(link) + '">' + l.escape(row.object_name) + '</a>';
            }},
            { id:'author', render: function(row, l) {
                if (row.author) {
                    return l.escape(row.author);
                }
                // No contact id means the platform itself made the change.
                return l.escape(row.author_id ? i18n.author.unknown : i18n.author.system);
            }}
        ],
        onDataLoaded: function() {
            formatDateMoment();
        }
    });

    // Extra filter fields — their values reach the server through extraParams,
    // so they only need to trigger a refetch.
    jQuery('#clSearchUser').on('keypress', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            logListing.applySearch();
        }
    });
    jQuery('#clSearchType').on('change', function() {
        logListing.applySearch();
    });

    logListing.init();
})();
</script>
{/literal}
