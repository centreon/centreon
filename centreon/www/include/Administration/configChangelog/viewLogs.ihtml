<script type="text/javascript" src="./include/common/javascript/tool.js"></script>

{literal}
<style>
.cl-changelog-wrapper {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 60px);
    overflow: hidden;
}
.cl-changelog-wrapper .cl-filter-box,
.cl-changelog-wrapper .cl-actions-bar {
    flex-shrink: 0;
}
.cl-changelog-scroll {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
}
.cl-changelog-scroll table {
    width: 100%;
}
.cl-changelog-table thead th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--table-header-background, #6b7888);
}
</style>
{/literal}

<div class="cl-changelog-wrapper">
    <div class="cl-filter-box">
        <div class="cl-filter-bar">
            <span class="cl-filter-label">{t}Object{/t}</span>
            <input type="text" id="clSearchInput" name="searchO" value="" placeholder="{t}Object name{/t}" class="cl-search-input" style="max-width:none;width:180px;">
            <span class="cl-filter-label">{t}User{/t}</span>
            <input type="text" id="clSearchUser" name="searchU" value="" placeholder="{t}User name{/t}" class="cl-search-input" style="max-width:none;width:160px;">
            <span class="cl-filter-label">{t}Type{/t}</span>
            <select id="clSearchType" class="cl-search-input" style="min-width:160px;">
                <option value="">{t}All object types{/t}</option>
            </select>
            <button type="button" id="clSearchBtn" class="btc bt_success">{t}Search{/t}</button>
        </div>
    </div>

    <div class="cl-actions-bar">
        <div class="cl-actions-left">&nbsp;</div>
        <div class="cl-pagination" id="clPaginationTop" style="font-size:12px;"></div>
    </div>

    <div class="cl-changelog-scroll" id="clScrollContainer">
        <table class="cl-listing-table cl-changelog-table">
            <thead>
                <tr>
                    <th style="width:170px">{t}Date{/t}</th>
                    <th style="width:120px">{t}Modification type{/t}</th>
                    <th style="width:140px">{t}Object type{/t}</th>
                    <th>{t}Object Name{/t}</th>
                    <th style="width:180px">{t}Author{/t}</th>
                </tr>
            </thead>
            <tbody id="clTableBody">
                <tr><td colspan="5" class="cl-loading">{t}Loading...{/t}</td></tr>
            </tbody>
        </table>
    </div>

    <div class="cl-pagination" id="clPaginationBottom" style="font-size:12px;padding:4px 8px;flex-shrink:0;"></div>
</div>

{literal}
<script type="text/javascript">
(function() {
    // Populate object type dropdown
    var types = [
        'command','timeperiod','contact','contactgroup',
        'host','hostgroup','service','servicegroup',
        'traps','escalation',
        'host dependency','hostgroup dependency','service dependency','servicegroup dependency',
        'poller','engine','broker','resources',
        'meta','access group','menu access','resource access','action access',
        'manufacturer','hostcategories','servicecategories'
    ];
    var sel = document.getElementById('clSearchType');
    types.forEach(function(t) {
        var opt = document.createElement('option');
        opt.value = t;
        opt.textContent = t.charAt(0).toUpperCase() + t.slice(1);
        sel.appendChild(opt);
    });

    // Badge CSS class mapping
    var badgeClass = {
        'ok': 'service_ok',
        'warning': 'service_warning',
        'critical': 'service_critical'
    };

    var logListing = new CentreonListing({
        instanceName:  'logListing',
        ajaxListUrl:   './include/Administration/configChangelog/ajaxChangelogListing.php',
        pageId:        '{/literal}{$p}{literal}',
        writeAccess:   false,
        showCheckboxes: false,
        defaultLimit:  50,
        storageKey:    'changelog_listing',
        emptyMessage:  'No log entries found',
        infiniteScroll: true,
        scrollContainerId: 'clScrollContainer',
        rowIdField:    'action_log_id',
        extraParams:   function() {
            return {
                searchUser: document.getElementById('clSearchUser').value,
                objectType: document.getElementById('clSearchType').value
            };
        },
        columns: [
            { id:'date', render: function(row) {
                if (!row.date) return '';
                var d = new Date(row.date * 1000);
                var pad = function(n) { return n < 10 ? '0'+n : n; };
                return pad(d.getDate())+'/'+pad(d.getMonth()+1)+'/'+d.getFullYear()+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());
            }},
            { id:'action_type', render: function(row) {
                var cls = badgeClass[row.badge] || 'service_warning';
                return '<span class="badge '+cls+'">'+row.action_type+'</span>';
            }},
            { id:'object_type', render: function(row, l) {
                return l.escape(row.object_type);
            }},
            { id:'object_name', render: function(row, l) {
                var pageId = '{/literal}{$p}{literal}';
                var link = 'main.php?p='+pageId+'&object_type='+encodeURIComponent(row.object_type)+'&object_id='+row.object_id;
                return '<a href="'+link+'">'+l.escape(row.object_name)+'</a>';
            }},
            { id:'author', render: function(row, l) {
                return l.escape(row.author);
            }}
        ]
    });

    // Extra search fields: user + type
    var userInput = document.getElementById('clSearchUser');
    var typeSelect = document.getElementById('clSearchType');

    userInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); logListing.resetScroll(); }
    });
    typeSelect.addEventListener('change', function() {
        logListing.resetScroll();
    });

    logListing.init();
})();
</script>
{/literal}
