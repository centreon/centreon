{* Derive the aggregate frozen flag before the render loop below unfreezes the
   elements, otherwise isFrozen() would always report false. *}
{assign var=isFrozen value=0}
{foreach from=$cloneSet item=v}
    {if $v->isFrozen()}
        {assign var=isFrozen value=1}
    {/if}
{/foreach}
<ul id="{$cloneId}" class="clonable no-deco-list">
    <li class="clone_template" id="{$cloneId}_template">
        <div class="clone-cell">
            {if $isFrozen == 0}
            <span class="cf-macro-drag-handle clonehandle">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </span>
            {else}
            <span class="cf-macro-drag-handle cf-macro-action-slot"></span>
            {/if}
            {foreach from=$cloneSet item=v}
                {if $v->isFrozen()}{$v->unfreeze()}{$v->setAttribute('disabled', 'disabled')}{/if}
                {$v->toHtml()}
            {/foreach}
            <span class="cf-macro-actions">
                <span class="cf-macro-action-btn" title="{t}Modify{/t}" onclick="editHostTemplate(this)">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </span>
                {if $isFrozen == 0}
                <a id="{$cloneId}_remove_current" class="cf-macro-action-btn cf-macro-action-btn--danger" title="{t}Delete{/t}">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </a>
                {else}
                <span class="cf-macro-action-btn cf-macro-action-slot"></span>
                {/if}
            </span>
        </div>
        <input type="hidden" name="clone_order_{$cloneId}_#index#" id="clone_order_#index#" />
    </li>
    <li id="{$cloneId}_noforms_template">
        <p class="muted">{t}Nothing here, use the "Add" button{/t}</p>
    </li>
</ul>

{literal}
<script type="text/javascript">

    function editHostTemplate(e) {
        var hostId = jQuery(e).closest('.clone-cell').find('select').val();
        if (hostId != "") {
            var popupStyle = 'toolbar=no,location=no,directories=no,tatus=no,scrollbars=yes,' +
                'esizable=yes,copyhistory=no,width=800,height=600';
            window.open(
                'main.php?p=60103&o=c&host_id=' + hostId + '&min=1',
                '',
                popupStyle
            );
        }
    }

</script>
{/literal}
