<div class="cachediv">
	<form id="datareport">
		<input type="hidden" name="id" value="{$hostgroup_id}"><br />
		<input type="hidden" name="color_UP" value="{$color.UP}">
		<input type="hidden" name="color_DOWN" value="{$color.DOWN}" >
		<input type="hidden" name="color_UNREACHABLE" value="{$color.UNREACHABLE}" >
		<input type="hidden" name="color_UNDETERMINED" value="{$color.UNDETERMINED}" >
	</form>
</div>
<div class="rpt-title-bar">
	<h2 class="rpt-title">{$availabilityReportTitle}</h2>
	<div class="rpt-nav-pills">
		<a href="main.php?p=30701" class="rpt-nav-pill">Go to Host Report</a>
		<a href="main.php?p=30704" class="rpt-nav-pill">Go to Service Group Report</a>
	</div>
</div>
<table style='width:100%; max-width:1400px;' class="ListTable">
	<tr class='ListHeader'>
		<form {$formHostGroup.attributes} style="margin:0px;padding:0px;">
		<td class="ListColHeaderLeft" style='white-space:nowrap;width:1%;border-left-width:0.0px;border-left-style:none;'>
				&nbsp;&nbsp;{$formPeriod.itemElement.html}{$formHostGroup.hidden}
		</td>
		<td style='padding:5px 5px 5px 8px;vertical-align:top;border-left:1px solid rgba(0,0,0,0.15);'>
                {$periodTitle} :
                <span class="rpt-period-group" id="rpt-preset-group">
                    <div class="md-radio-modified md-radio-inline">
                        <input type="radio" id="preset" value="preset" name="period_choice" {if $period_choice == "preset" } checked="checked" {/if}/>
                        <label for="preset"></label>
                    </div>
                    {$formPeriod.period.html}
                </span>
                {$periodORlabel}
                <span class="rpt-period-group" id="rpt-custom-group">
                    <div class="md-radio-modified md-radio-inline">
                        <input type="radio" id="custom" name="period_choice" value="custom" {if $period_choice == "custom" } checked="checked" {/if} />
                        <label for="custom"></label>
                    </div>
                    {$formPeriod.StartDate.label} {$formPeriod.StartDate.html}&nbsp;
                    {$formPeriod.EndDate.label} {$formPeriod.EndDate.html}
                </span>
                {$formPeriod.button.html}{$formPeriod.hidden}
		</td>
		</form>
		<td style="text-align:right;">
			<a href="{$link_csv_url}"><img src="./img/icons/csv.png" class="ico-16" alt="Export CSV" title="{t}Export CSV{/t}" target="_blank"/></a>
		</td>
	</tr>
	{if $date_start != 0}
	<tr class="rpt-date-row">
		<td colspan="3">
			{$period_name} <span class="isTimestamp isDate">{$date_start}</span> {$to} <span class="isTimestamp isDate">{$date_end}</span>
		</td>
	</tr>
	{/if}
	<tr>
		<td colspan="3" style="padding:5px;">
			<table class="ListTable reporting-summary" style="width:100%;">
				<tr class='ListHeader'>
					<td class="FormHeader" colspan="6">&nbsp;<b>{$resumeTitle}</b></td>
				</tr>
				<tr>
					<td style="width:220px; padding:5px 5px 5px 15px; vertical-align:middle;">
						<!-- chart drawing -->
						{if isset($hostgroup_id)}
							<div style="text-align: center; position: relative;">
								<canvas id="chartCanvas" width="260" height="160"></canvas>
							</div>
						{/if}
					</td>
					<td style="padding:0; vertical-align:top; border-left:1px solid var(--list-table-border-color, #ddd);">
						<table style="width:100%; height:100%;">
							<!-- headers -->
							<tr class='rpt-summary-header'>
								<td style="padding:5px;" class="ListColHeaderCenter">{$stateLabel}</td>
								<td style="padding:5px;" class="ListColHeaderCenter">{$totalTimeLabel}</td>
								<td style="padding:5px;" class="ListColHeaderCenter">{$meanTimeLabel}</td>
								<td style="padding:5px;" class="ListColHeaderCenter">{$alertsLabel}</td>
							</tr>
							<!-- Values -->
							<tr class="list_one">
								<td style="padding:5px;"><span class="rpt-dot" style="background:#{$colors.up}"></span> {$upLabel}</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.UP_TP}%</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.UP_MP}%</td>
								<td style="padding:5px;" class='ListColCenter'><span class="rpt-alert-badge rpt-alert-up">{$summary.UP_A}</span></td>
							</tr>
							<tr class="list_two">
								<td style="padding:5px;"><span class="rpt-dot" style="background:#{$colors.down}"></span> {$downLabel}</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.DOWN_TP}%</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.DOWN_MP}%</td>
								<td style="padding:5px;" class='ListColCenter'><span class="rpt-alert-badge rpt-alert-down">{$summary.DOWN_A}</span></td>
							</tr>
							<tr class="list_one">
								<td style="padding:5px;"><span class="rpt-dot" style="background:#{$colors.unreachable}"></span> {$unreachableLabel}</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.UNREACHABLE_TP}%</td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.UNREACHABLE_MP}%</td>
								<td style="padding:5px;" class='ListColCenter'><span class="rpt-alert-badge rpt-alert-unreach">{$summary.UNREACHABLE_A}</span></td>
							</tr>
							<tr class="list_two">
								<td style="padding:5px;"><span class="rpt-dot" style="background:#{$colors.maintenance}"></span> <span class="rpt-tooltip-wrap">{$downtimeLabel}<span class="rpt-tooltip">{$downtimeTooltip}</span></span></td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.MAINTENANCE_TP}%</td>
								<td style="padding:5px;" class='ListColCenter'></td>
								<td style="padding:5px;" class='ListColCenter'></td>
							</tr>
							<tr class="list_one">
								<td style="padding:5px;"><span class="rpt-dot" style="background:#{$colors.undetermined}"></span> <span class="rpt-tooltip-wrap">{$undeterminedLabel}<span class="rpt-tooltip">{$undeterminedTooltip}</span></span></td>
								<td style="padding:5px;" class='ListColCenter'>{$summary.UNDETERMINED_TP}%</td>
								<td style="padding:5px;" class='ListColCenter'></td>
								<td style="padding:5px;" class='ListColCenter'></td>
							</tr>
							<!-- Total -->
							<tr class="rpt-summary-footer">
								<td style="padding:5px;" class="ListColHeaderCenter">{$totalLabel}</td>
								<td style="padding:5px;" class='ListColCenter'></td>
								<td style="padding:5px;" class='ListColCenter'></td>
								<td style="padding:5px;" class='ListColCenter'><span class="rpt-alert-badge rpt-alert-total">{$totalAlert}</span></td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td colspan="3" style=' padding:5px;'>
			<table class="ListTable reporting-modern">
				<tr class='ListHeader'>
					<td class="FormHeader" colspan="8">&nbsp;{$svcTitle}</td>
				</tr>
				<tr class='list_lvl_1'>
					<td class="ListColHeaderCenter">{$hostTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.up}"></span> {$upLabel}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.down}"></span> {$downLabel}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.unreachable}"></span> {$unreachableLabel}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.maintenance}"></span> <span class="rpt-tooltip-wrap">{$downtimeLabel}<span class="rpt-tooltip">{$downtimeTooltip}</span></span></td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.undetermined}"></span> <span class="rpt-tooltip-wrap">{$undeterminedLabel}<span class="rpt-tooltip">{$undeterminedTooltip}</span></span></td>
					<td class="ListColHeaderCenter">{$alertsLabel}</td>
					<td class="ListColHeaderCenter">{$statusLabel}</td>
				</tr>
				<tr class='list_lvl_1'>
					<td class="ListColHeaderCenter"></td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">{$mtTtLabel}</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">{$mtTtLabel}</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">{$mtTtLabel}</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">{$ttLabel}</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">{$ttLabel}</td>
					<td class="ListColHeaderCenter"></td>
					<td class="ListColHeaderCenter"></td>
				</tr>
				{foreach item=tb from=$components}
				<tr class={cycle values="list_two, list_one"}>
					<td class="ListColHeaderLeft"><a href="main.php?p=30701&host={$tb.ID}&period={$get_period}&start={$get_date_start}&end={$get_date_end}">{$tb.NAME}</a></td>
					<td class="ListColCenter rpt-val rpt-bg-up" style="padding:5px;">
						<span class="rpt-mp">{$tb.UP_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.UP_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-down" style="padding:5px;">
						<span class="rpt-mp">{$tb.DOWN_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.DOWN_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-unreachable" style="padding:5px;">
						<span class="rpt-mp">{$tb.UNREACHABLE_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.UNREACHABLE_TP}%</span>
					</td>
					<td class="ListColCenter rpt-bg-maintenance" style="padding:5px;">{$tb.MAINTENANCE_TP}%</td>
					<td class="ListColCenter rpt-bg-undetermined" style="padding:5px;">{$tb.UNDETERMINED_TP}%</td>
					<td class="ListColCenter rpt-alerts" style="padding:5px;">
						{if $tb.DOWN_A > 0}<span class="rpt-alert-badge rpt-alert-crit">{$tb.DOWN_A}</span>{/if}
						{if $tb.UNREACHABLE_A > 0}<span class="rpt-alert-badge rpt-alert-warn">{$tb.UNREACHABLE_A}</span>{/if}
						{if $tb.DOWN_A == 0 && $tb.UNREACHABLE_A == 0}<span class="rpt-alert-badge rpt-alert-none">0</span>{/if}
					</td>
					<td style="padding:2px 5px; min-width:120px;">
						<div class="status-bar" style="display:flex; height:14px; border-radius:3px; overflow:hidden; background:var(--list-lvl-1-background-color, #f0f0f0);" title="Up:{$tb.UP_TP}% Down:{$tb.DOWN_TP}% Unreachable:{$tb.UNREACHABLE_TP}% Maint:{$tb.MAINTENANCE_TP}% Undetermined:{$tb.UNDETERMINED_TP}%">
							<div style="width:{$tb.UP_TP}%; background:#{$colors.up};"></div>
							<div style="width:{$tb.DOWN_TP}%; background:#{$colors.down};"></div>
							<div style="width:{$tb.UNREACHABLE_TP}%; background:#{$colors.unreachable};"></div>
							<div style="width:{$tb.MAINTENANCE_TP}%; background:#{$colors.maintenance};"></div>
							<div style="width:{$tb.UNDETERMINED_TP}%; background:#{$colors.undetermined};"></div>
						</div>
					</td>
				</tr>
				{/foreach}
				<tr class="rpt-avg">
					<td class="ListColHeaderCenter" style="padding:5px;">{$averageTilte}</td>
					<td class="ListColCenter rpt-val rpt-bg-up" style="padding:5px;">
						<span class="rpt-mp">{$components_avg.UP_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$components_avg.UP_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-down" style="padding:5px;">
						<span class="rpt-mp">{$components_avg.DOWN_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$components_avg.DOWN_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-unreachable" style="padding:5px;">
						<span class="rpt-mp">{$components_avg.UNREACHABLE_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$components_avg.UNREACHABLE_TP}%</span>
					</td>
					<td class="ListColCenter rpt-bg-maintenance" style="padding:5px;">{$components_avg.MAINTENANCE_TP}%</td>
					<td class="ListColCenter rpt-bg-undetermined" style="padding:5px;">{$components_avg.UNDETERMINED_TP}%</td>
					<td class="ListColCenter rpt-alerts" style="padding:5px;">
						{if $components_avg.DOWN_A > 0}<span class="rpt-alert-badge rpt-alert-crit">{$components_avg.DOWN_A}</span>{/if}
						{if $components_avg.UNREACHABLE_A > 0}<span class="rpt-alert-badge rpt-alert-warn">{$components_avg.UNREACHABLE_A}</span>{/if}
					</td>
					<td style="padding:2px 5px; min-width:120px;">
						<div class="status-bar" style="display:flex; height:14px; border-radius:3px; overflow:hidden; background:var(--list-lvl-1-background-color, #f0f0f0);" title="Up:{$components_avg.UP_TP}% Down:{$components_avg.DOWN_TP}% Unreachable:{$components_avg.UNREACHABLE_TP}% Maint:{$components_avg.MAINTENANCE_TP}% Undetermined:{$components_avg.UNDETERMINED_TP}%">
							<div style="width:{$components_avg.UP_TP}%; background:#{$colors.up};"></div>
							<div style="width:{$components_avg.DOWN_TP}%; background:#{$colors.down};"></div>
							<div style="width:{$components_avg.UNREACHABLE_TP}%; background:#{$colors.unreachable};"></div>
							<div style="width:{$components_avg.MAINTENANCE_TP}%; background:#{$colors.maintenance};"></div>
							<div style="width:{$components_avg.UNDETERMINED_TP}%; background:#{$colors.undetermined};"></div>
						</div>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td colspan="3" style=' padding:5px;'>
			<div id="availability-heatmap"></div>
			<div id="alerts-heatmap" style="margin-top: 10px;"></div>
		</td>
	</tr>
</table>

{literal}
<script>
    //formatting the tags containing a class isTimestamp
    formatDateMoment();

    /* initializing datepicker and the alternative format field */
    initDatepicker("datepicker", "mm/dd/yy", null);

    jQuery(function () {
        // Availability heatmap calendar
        if (typeof initTimeline === 'function') { initTimeline(); }

        var ctx = document.getElementById('chartCanvas');
        if (ctx) {
            var bodyBg = getComputedStyle(document.body).backgroundColor || '';
            var isDark = bodyBg.indexOf('33, 33, 33') !== -1 || bodyBg.indexOf('21, 21, 21') !== -1;
            var borderCol = isDark ? 'rgba(255,255,255,0.1)' : '#fff';
            var legendColor = isDark ? '#b2aca2' : '#666';

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['{/literal}{$upLabel}{literal}', '{/literal}{$downLabel}{literal}', '{/literal}{$unreachableLabel}{literal}', '{/literal}{$downtimeLabel}{literal}', '{/literal}{$undeterminedLabel}{literal}'],
                    datasets: [{
                        data: [
                            {/literal}{$hostgroup_up|number_format:2:".":""}{literal},
                            {/literal}{$hostgroup_down|number_format:2:".":""}{literal},
                            {/literal}{$hostgroup_unreachable|number_format:2:".":""}{literal},
                            {/literal}{$hostgroup_maintenance|number_format:2:".":""}{literal},
                            {/literal}{$hostgroup_undetermined|number_format:2:".":""}{literal}
                        ],
                        backgroundColor: [
                            '#{/literal}{$colors.up}{literal}',
                            '#{/literal}{$colors.down}{literal}',
                            '#{/literal}{$colors.unreachable}{literal}',
                            '#{/literal}{$colors.maintenance}{literal}',
                            '#{/literal}{$colors.undetermined}{literal}'
                        ],
                        borderWidth: 1,
                        borderColor: borderCol
                    }]
                },
                options: {
                    responsive: false,
                    cutout: '40%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { boxWidth: 12, padding: 8, font: { size: 11 }, color: legendColor }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed.toFixed(2) + '%';
                                }
                            }
                        }
                    }
                }
            });
        }
    });
{/literal}
</script>