<div class="cachediv">
	<form id="datareport">
		<input type="hidden" name="id" value="{$servicegroup_id}"><br/>
		<input type="hidden" name="color_UP" value="{$color.UP}">
		<input type="hidden" name="color_DOWN" value="{$color.DOWN}" >
		<input type="hidden" name="color_UNREACHABLE" value="{$color.UNREACHABLE}" >
		<input type="hidden" name="color_UNDETERMINED" value="{$color.UNDETERMINED}" >
	</form>
</div>
<h2 style="margin:0 0 8px 0; padding:0; font-size:18px; font-weight:600; color:#2d3436;">Availability Report</h2>
<table style='width:100%; max-width:1400px;' class="ListTable">
	<tr class='ListHeader'>
		<!-- servicegroup selection -->
		<form {$serviceGroupForm.attributes} style="margin:0px;padding:0px;">&nbsp;
		<td class="ListColHeaderLeft" style='white-space: nowrap; border-left-width:0.0px;border-left-style:none;'>
				&nbsp;&nbsp;{$formPeriod.itemElement.html}{$serviceGroupForm.hidden}
		</td>
		<td style='padding:5px;vertical-align:top;'>
			{if $date_start != 0}&nbsp;&nbsp;&nbsp;{$period_name}
					<!-- using a span to add a class to format the timestamp -->
					<span class="isTimestamp isDate">{$date_start} </span> {$to}
					<span class="isTimestamp isDate"> {$date_end}</span>
				{/if}
            {$periodTitle} :
            <span class="rpt-period-group" id="rpt-preset-group">
                <div class="md-radio-modified md-radio-inline">
                    <input type="radio" id="preset" value="preset" name="period_choice" {if $period_choice == "preset" } checked="checked" {/if}/>
                    <label for="preset"></label>
                </div>
                {$formPeriod.period.html}
            </span>
            {$periodORlabel}
            <span class="rpt-period-group" id="rpt-custom-group">
                <div class="md-radio-modified md-radio-inline">
                    <input type="radio" id="custom" name="period_choice" value="custom" {if $period_choice == "custom" } checked="checked" {/if} />
                    <label for="custom"></label>
                </div>
                {$formPeriod.StartDate.label} {$formPeriod.StartDate.html}&nbsp;
                {$formPeriod.EndDate.label} {$formPeriod.EndDate.html}
            </span>
            {$formPeriod.button.html}{$formPeriod.hidden}
		</td>
		</form>
		<td>
			<a href="{$link_csv_url}"><img src="./img/icons/csv.png" class="ico-20" alt="Export CSV" title="{t}Export CSV{/t}" target="_blank"/></a>
		</td>
	</tr>
	<tr class='list_lvl_3'>
		<td style='width:300px; padding:5px'>
			<!-- chart drawing -->
			{if isset($servicegroup_id)}
				<div style="text-align: center; max-height: 220px; position: relative;">
					<canvas id="chartCanvas" width="350" height="200"></canvas>
				</div>
			{/if}
		</td>
		<!-- period selection -->
		<!-- services group statistics -->
		<td style='vertical-align:top;padding:5px;' colspan="2">
			<table class="ListTable">
				<tr class='ListHeader'>
					<td colspan=5>&nbsp;<b>{$resumeTitle}</b></td>
				</tr>
				<!-- headers -->
				<tr class='list_lvl_1'>
					<td style="padding:5px;" class="ListColHeaderCenter">{$stateLabel}</td>
					<td style="padding:5px;" class="ListColHeaderCenter">{$totalTimeLabel}</td>
					<td style="padding:5px;" class="ListColHeaderCenter">{$meanTimeLabel}</td>
					<td style="padding:5px;" class="ListColHeaderCenter">{$alertsLabel}</td>
				</tr>
				<!-- Values -->
				<tr class="list_one">
					<td {$style_ok_top}><span {$badge_ok}></span> <b>{$OKTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.OK_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.OK_MP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.OK_A}</td>
				</tr>
				<tr class="list_two">
					<td {$style_warning_top}><span {$badge_warning}></span> <b>{$WarningTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.WARNING_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.WARNING_MP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.WARNING_A}</td>
				</tr>
				<tr class="list_one">
					<td {$style_critical_top}><span {$badge_critical}></span> <b>{$CriticalTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.CRITICAL_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.CRITICAL_MP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.CRITICAL_A}</td>
				</tr>
				<tr class="list_two">
					<td {$style_unknown_top}><span {$badge_unknown}></span> <b>{$UnknownTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.UNKNOWN_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.UNKNOWN_MP}%</td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.UNKNOWN_A}</td>
				</tr>
				<tr class="list_two">
					<td {$style_maintenance_top}><span {$badge_maintenance}></span> <b>{$MaintenanceTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.MAINTENANCE_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'></td>
					<td style="padding:5px;" class='ListColCenter'></td>
				</tr>
				<tr class="list_two">
					<td {$style_pending_top}><span {$badge_pending}></span> <b>{$PendingTitle}</b></td>
					<td style="padding:5px;" class='ListColCenter'>{$summary.UNDETERMINED_TP}%</td>
					<td style="padding:5px;" class='ListColCenter'></td>
					<td style="padding:5px;" class='ListColCenter'></td>
				</tr>
				<!-- Total -->
				<tr class='list_lvl_2'>
					<td style="padding:5px;" class="ListColHeaderCenter">{$totalLabel}</td>
					<td style="padding:5px;" class='ListColCenter'></td>
					<td style="padding:5px;" class='ListColCenter'></td>
					<td style="padding:5px;" class='ListColCenter'>{$totalAlert}</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td colspan="3" style=' padding:5px;'>
			<table class="ListTable reporting-modern">
				<tr class='ListHeader'>
					<td class="FormHeader" colspan="10">&nbsp;{$svcTitle}</td>
				</tr>
				<tr class='list_lvl_1'>
					<td class="ListColHeaderCenter">{$hostTitle}</td>
					<td class="ListColHeaderCenter">{$serviceTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.ok}"></span> {$OKTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.warning}"></span> {$WarningTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.critical}"></span> {$CriticalTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.unknown}"></span> {$UnknownTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.maintenance}"></span> {$MaintenanceTitle}</td>
					<td class="ListColHeaderCenter"><span class="rpt-dot" style="background:#{$colors.undetermined}"></span> {$PendingTitle}</td>
					<td class="ListColHeaderCenter">{$alertsLabel}</td>
				</tr>
				<tr class='list_lvl_1'>
					<td class="ListColHeaderCenter"></td>
					<td class="ListColHeaderCenter"></td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">MT / TT</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">MT / TT</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">MT / TT</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">MT / TT</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">TT</td>
					<td class="ListColHeaderCenter" style="font-size:10px;font-weight:normal;">TT</td>
					<td class="ListColHeaderCenter"></td>
				</tr>
				{foreach item=tb from=$components}
				<tr class={cycle values="list_two, list_one"}>
					<td class="ListColHeaderLeft">
						<a href="main.php?p=30701&host={$tb.HOST_ID}&period={$get_period}&start={$get_date_start}&end={$get_date_end}">{$tb.HOST_NAME}</a></td>
					<td class="ListColHeaderLeft">
						{if isset($tb.SVC_ICON)}{$tb.SVC_ICON}{/if}<a href="main.php?p=30702&host_id={$tb.HOST_ID}&item={$tb.SERVICE_ID}&period={$get_period}&start={$get_date_start}&end={$get_date_end}">{$tb.SERVICE_DESC}</a></td>
					<td class="ListColCenter rpt-val rpt-bg-ok" style="padding:5px;">
						<span class="rpt-mp">{$tb.OK_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.OK_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-warning" style="padding:5px;">
						<span class="rpt-mp">{$tb.WARNING_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.WARNING_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-critical" style="padding:5px;">
						<span class="rpt-mp">{$tb.CRITICAL_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.CRITICAL_TP}%</span>
					</td>
					<td class="ListColCenter rpt-val rpt-bg-unknown" style="padding:5px;">
						<span class="rpt-mp">{$tb.UNKNOWN_MP}%</span><span class="rpt-sep">/</span><span class="rpt-tp">{$tb.UNKNOWN_TP}%</span>
					</td>
					<td class="ListColCenter rpt-bg-maintenance" style="padding:5px;">{$tb.MAINTENANCE_TP}%</td>
					<td class="ListColCenter rpt-bg-undetermined" style="padding:5px;">{$tb.UNDETERMINED_TP}%</td>
					<td class="ListColCenter rpt-alerts" style="padding:5px;">
						{if $tb.WARNING_A > 0}<span class="rpt-alert-badge rpt-alert-warn">{$tb.WARNING_A}</span>{/if}
						{if $tb.CRITICAL_A > 0}<span class="rpt-alert-badge rpt-alert-crit">{$tb.CRITICAL_A}</span>{/if}
						{if $tb.UNKNOWN_A > 0}<span class="rpt-alert-badge rpt-alert-unk">{$tb.UNKNOWN_A}</span>{/if}
						{if $tb.WARNING_A == 0 && $tb.CRITICAL_A == 0 && $tb.UNKNOWN_A == 0}<span class="rpt-alert-badge rpt-alert-none">0</span>{/if}
					</td>
				</tr>
				{/foreach}
			</table>
		</td>
	</tr>
	<tr>
		<td colspan="3" style=' padding:5px;'>
			<div id="availability-heatmap"></div>
			<div id="alerts-heatmap" style="margin-top: 10px;"></div>
		</td>
	</tr>
</table>

{literal}
<style>
.reporting-modern .rpt-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle; }
.reporting-modern .rpt-val { white-space:nowrap; }
.reporting-modern .rpt-val .rpt-mp { font-weight:600; color:#24292f; }
.reporting-modern .rpt-val .rpt-sep { color:#bbb; margin:0 2px; }
.reporting-modern .rpt-val .rpt-tp { font-size:11px; color:#999; }
.reporting-modern .rpt-alerts { white-space:nowrap; }
.reporting-modern .rpt-alert-badge { display:inline-block; padding:1px 6px; border-radius:10px; font-size:11px; font-weight:600; margin:0 1px; }
.reporting-modern .rpt-alert-warn { background:#fff3e0; color:#e65100; }
.reporting-modern .rpt-alert-crit { background:#fce4ec; color:#c62828; }
.reporting-modern .rpt-alert-unk { background:#f3e5f5; color:#6a1b9a; }
.reporting-modern .rpt-alert-none { background:#e8f5e9; color:#2e7d32; }
.reporting-modern .rpt-bg-ok { background: rgba({/literal}{$colors_rgb.ok}{literal}, 0.05) !important; }
.reporting-modern .rpt-bg-warning { background: rgba({/literal}{$colors_rgb.warning}{literal}, 0.05) !important; }
.reporting-modern .rpt-bg-critical { background: rgba({/literal}{$colors_rgb.critical}{literal}, 0.05) !important; }
.reporting-modern .rpt-bg-unknown { background: rgba({/literal}{$colors_rgb.unknown}{literal}, 0.05) !important; }
.reporting-modern .rpt-bg-maintenance { background: rgba({/literal}{$colors_rgb.maintenance}{literal}, 0.05) !important; }
.reporting-modern .rpt-bg-undetermined { background: rgba({/literal}{$colors_rgb.undetermined}{literal}, 0.05) !important; }
/* Header rows — neutral warm gray */
.reporting-modern tr.list_lvl_1 {
    background: #f5f5f0 !important;
}
.reporting-modern tr.list_lvl_1 td {
    color: #333 !important;
    font-weight: 600;
}
</style>
<script>
    //formatting the tags containing a class isTimestamp
    formatDateMoment();

    /* initializing datepicker and the alternative format field */
    initDatepicker("datepicker", "mm/dd/yy", null);


    jQuery(function () {
        // Availability heatmap calendar
        if (typeof initTimeline === 'function') { initTimeline(); }

        var ctx = document.getElementById('chartCanvas');
        if (ctx) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Ok', 'Warning', 'Critical', 'Unknown', 'Downtime', 'Undetermined'],
                    datasets: [{
                        data: [
                            {/literal}{$servicegroup_ok|number_format:2:".":""}{literal},
                            {/literal}{$servicegroup_warning|number_format:2:".":""}{literal},
                            {/literal}{$servicegroup_critical|number_format:2:".":""}{literal},
                            {/literal}{$servicegroup_unknown|number_format:2:".":""}{literal},
                            {/literal}{$servicegroup_maintenance|number_format:2:".":""}{literal},
                            {/literal}{$servicegroup_undetermined|number_format:2:".":""}{literal}
                        ],
                        backgroundColor: [
                            '#{/literal}{$colors.ok}{literal}',
                            '#{/literal}{$colors.warning}{literal}',
                            '#{/literal}{$colors.critical}{literal}',
                            '#{/literal}{$colors.unknown}{literal}',
                            '#{/literal}{$colors.maintenance}{literal}',
                            '#{/literal}{$colors.undetermined}{literal}'
                        ],
                        borderWidth: 1,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: false,
                    cutout: '40%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { boxWidth: 12, padding: 8, font: { size: 11 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed.toFixed(2) + '%';
                                }
                            }
                        }
                    }
                }
            });
        }
    });
{/literal}
</script>
