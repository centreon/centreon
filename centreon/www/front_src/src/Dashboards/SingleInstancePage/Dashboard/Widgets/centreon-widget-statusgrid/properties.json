{
  "canExpand": true,
  "data": {
    "resources": {
      "allowEmptyResources": true,
      "allowRegexOnResourceTypes": ["service"],
      "defaultValue": [],
      "excludedResourceTypes": ["meta-service"],
      "required": false,
      "type": "resources",
      "useAdditionalResources": true
    }
  },
  "description": "Displays a status overview for selected resources, grouped by hosts or by services.",
  "icon": "<rect x=\"6.51\" y=\"6\" width=\"22\" height=\"22\" rx=\"4\" ry=\"4\"></rect><rect x=\"6.51\" y=\"32\" width=\"22\" height=\"22\" rx=\"4\" ry=\"4\"></rect><rect x=\"32.51\" y=\"32\" width=\"22\" height=\"22\" rx=\"4\" ry=\"4\"></rect><rect x=\"32.51\" y=\"6\" width=\"22\" height=\"22\" rx=\"4\" ry=\"4\"></rect>",
  "moduleName": "centreon-widget-statusgrid",
  "options": {
    "refreshInterval": {
      "defaultValue": "default",
      "label": "Interval",
      "type": "refresh-interval"
    },
    "resourceType": {
      "defaultValue": "host",
      "hiddenCondition": {
        "matches": ["business-view", "business-activity"],
        "method": "includes",
        "property": "resourceType",
        "target": "data",
        "when": "data.resources"
      },
      "label": "Display resources with this type",
      "options": [
        {
          "id": "host",
          "name": "Host"
        },
        {
          "id": "service",
          "name": "Service"
        }
      ],
      "type": "radio"
    },
    "sortBy": {
      "defaultValue": "status_severity_code",
      "hiddenCondition": {
        "matches": "condensed",
        "method": "equals",
        "target": "options",
        "when": "options.viewMode"
      },
      "label": "Sort by",
      "options": [
        {
          "id": "status_severity_code",
          "name": "Status"
        },
        {
          "id": "name",
          "name": "Name"
        }
      ],
      "type": "radio"
    },
    "states": {
      "defaultValue": ["unhandled_problems"],
      "hiddenCondition": {
        "matches": "condensed",
        "method": "equals",
        "target": "options",
        "when": "options.viewMode"
      },
      "label": "Display resources with this state",
      "options": [
        {
          "id": "unhandled_problems",
          "name": "Unhandled"
        },
        {
          "id": "acknowledged",
          "name": "Acknowledged"
        },
        {
          "id": "in_downtime",
          "name": "In downtime"
        },
        {
          "id": "in_flapping",
          "name": "Flapping"
        }
      ],
      "type": "checkbox"
    },
    "statuses": {
      "defaultValue": ["warning", "problem"],
      "label": "Display resources with this status",
      "options": [
        {
          "id": "problem",
          "name": "Problem (Down/Critical)"
        },
        {
          "id": "warning",
          "name": "Warning"
        },
        {
          "id": "pending",
          "name": "Pending"
        },
        {
          "id": "success",
          "name": "Success (OK/Up)"
        },
        {
          "id": "undefined",
          "name": "Undefined (Unreachable/Unknown)"
        }
      ],
      "type": "checkbox"
    },
    "tiles": {
      "defaultValue": 100,
      "hiddenCondition": {
        "matches": "condensed",
        "method": "equals",
        "target": "options",
        "when": "options.viewMode"
      },
      "type": "tiles"
    },
    "viewMode": {
      "defaultValue": "standard",
      "label": "Display with this view",
      "options": [
        {
          "id": "standard",
          "name": "Standard"
        },
        {
          "id": "condensed",
          "name": "Condensed"
        }
      ],
      "type": "radio"
    }
  },
  "title": "Status grid",
  "widgetType": "realtime"
}
