{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "types": ["react", "jest"]
  },
  "exclude": [
    "./node_modules",
    "./dist",
    "../../node_modules",
    "./src/**/*.stories.tsx",
    "./src/**/*.stories.ts",
    "./src/**/*.cypress.spec.tsx",
    "./src/**/*.cy.tsx"
  ]
}
