  aria-label="graph"
  height="n"
  width="n%"
>
  <title>
    chart
  </title>
  <g
    class="visx-group"
    transform="translate(n, n)"
  >
    <g />
    <g>
      <text
        font-family="Roboto, sans-serif"
        font-size="10"
        x="n"
        y="n"
      >
        s
      </text>
      <text
        font-family="Roboto, sans-serif"
        font-size="10"
        x="n"
        y="n"
      >
        %
      </text>
    </g>
    <g>
      <g>
        <path
          class="visx-linepath"
          d="ML"
          data-metric="13536"
          fill="transparent"
          opacity="1"
          stroke="rgb(102, 153, 204)"
          stroke-linecap="round"
          stroke-width="2"
          unit="s"
        />
      </g>
      <g>
        <path
          class="visx-linepath"
          d="ML"
          data-metric="13534"
          fill="transparent"
          opacity="1"
          stroke="rgb(204, 153, 153)"
          stroke-linecap="round"
          stroke-width="2"
          unit="%"
        />
      </g>
      <g>
        <path
          class="visx-linepath"
          d="ML"
          data-metric="13535"
          fill="transparent"
          opacity="1"
          stroke="rgb(0, 255, 204)"
          stroke-linecap="round"
          stroke-width="2"
          unit="s"
        />
      </g>
    </g>
    <g>
      <g>
        <rect
          class="visx-bar"
          fill="rgba(19, 29, 90, 0.2)"
          height="n"
          stroke="rgba(19, 29, 90, 0.5)"
          width="n"
          x="n"
          y="n"
        />
      </g>
      <rect
        class="visx-bar css-1guwivu-translationZone"
        fill="transparent"
        height="n"
        width="n"
        x="n"
        y="n"
      />
      <rect
        class="visx-bar css-1guwivu-translationZone"
