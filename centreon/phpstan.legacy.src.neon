includes:
    - ../php-tools/phpstan/config/common.neon
    - phpstan.legacy.src.baseline.neon

parameters:

    level: 4

    bootstrapFiles:
        - config/centreon.config.php.template

    scanFiles:
        - config/centreon.config.php.template
        - tests/phpstan_stubs/bootstrap.stub
        - tests/phpstan_stubs/legacy.stub

    excludePaths:
        analyseAndScan:
            - src/App
            - src/Core
            - src/Adaptation

    paths:
        - src

