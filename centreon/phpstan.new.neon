includes:
    - ../php-tools/phpstan/config/common.neon
    - phpstan.new.baseline.neon

parameters:

    level: max

    treatPhpDocTypesAsCertain: false

    scanFiles:
        - .php-cs-fixer.conf.php
        - .php-cs-fixer.core.php
        - .php-cs-fixer.diff.php
        - .php-cs-fixer.legacy.php
        - .php-cs-fixer.new.php
        - castor.php
        - rector.conf.php
        - rector.core.php
        - rector.diff.php
        - rector.legacy.php
        - rector.new.php

    paths:
        - config.new
        - src/Adaptation
        - src/App

rules:
    - Tools\PhpStan\CustomRules\ArchitectureRules\EnumAreSuffixedRule
    - Tools\PhpStan\CustomRules\MiscRules\CommandHandlerCannotUseCommandBus

services:
    - class: Tools\PhpStan\CustomRules\ArchitectureRules\MarkedClassesAreFinalRule
      arguments:
          attributes:
              - App\Shared\Application\Command\AsCommandHandler
              - App\Shared\Domain\Event\AsEventHandler
              - ApiPlatform\Metadata\ApiResource
          classes:
              - ApiPlatform\State\ProcessorInterface
              - App\Shared\Infrastructure\TransformerInterface
              - Symfony\Component\Security\Core\Authorization\Voter\Voter
      tags: [phpstan.rules.rule]

    - class: Tools\PhpStan\CustomRules\MiscRules\MarkedClassesHaveTestRule
      arguments:
          attributes:
              - App\Shared\Application\Command\AsCommandHandler
              - App\Shared\Domain\Event\AsEventHandler
          classes:
              - ApiPlatform\State\ProcessorInterface
              - App\Shared\Infrastructure\Dbal\DbalRepository
          # The Domain must be unit-tested: aggregate roots and their value objects (identified
          # by living under Domain/Aggregate or Domain/ValueObject, with no shared attribute/base).
          # A trivial <Agg>Id (bare AggregateRootId subclass) is exempted by suffix.
          # Criteria and transformers are intentionally NOT required here — they may be covered by
          # the repository/provider integration test instead (team decision, meeting CR).
          namespaceSegments:
              - \Domain\Aggregate\
              - \Domain\ValueObject\
          excludeSuffixes:
              - Id
      tags: [phpstan.rules.rule]

    - class: Tools\PhpStan\CustomRules\ArchitectureRules\MarkedClassesAreOnlyInvokableRule
      arguments:
          attributes:
              - App\Shared\Application\Command\AsCommandHandler
              - App\Shared\Domain\Event\AsEventHandler
      tags: [phpstan.rules.rule]
