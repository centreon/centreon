# === Image tags ===
# Use floating "develop" tag for latest develop build.
# For a specific version use e.g. develop-26.07 or 26.07 (stable release).
TAG=develop

# Per-service tags, default to TAG (must not be empty). Not resolved with a
# nested ${ENGINE_TAG:-${TAG}} in docker-compose.yaml: podman-compose leaves it
# unexpanded.
ENGINE_TAG=${TAG}
GORGONE_TAG=${TAG}
SNMPTRAPD_TAG=${TAG}
CENTREONTRAPD_TAG=${TAG}
VMWARE_TAG=

# === Runtime ===
TZ=Europe/Paris
DEBUG=false

# === Poller identity ===
NAME=my-poller
# Poller UID from Central (required)
GORGONE_UID=
# Gorgone token from Central (required)
GORGONE_TOKEN=

# === Central connection ===
# IP or hostname of Central (required)
CENTRAL_HOST=
CENTRAL_PORT=443
GORGONE_SSL=true

# === Encryption ===
# Retrieve from Central API (admin auth required):
#   GET https://<central>/api/latest/administration/engine/secrets
APP_SECRET=
SALT=
