        <span id="test-error" class="error_message" style="display: none; color: red;"></span>
        <span id="test-ok" class="okay_message" style="display: none; color: green;"></span>
    </td>
</tr>
<tr class="list_one">
    <td class="FormRowField">
        {$form.mappingTicketLabel.label}
    </td>
    <td class="FormRowValue">
        {include file="file:$centreon_open_tickets_path/providers/Abstract/templates/clone.ihtml" cloneId="mappingTicket" cloneSet=$form.mappingTicket}
    </td>
</tr>

<script>
  var webServiceUrl = '{$webServiceUrl}'
</script>
{literal}
<script>
  jQuery('#test-matrix42').on('click', function (e) {
    e.preventDefault();
    jQuery('.error_message, .okay_message').hide();

    let fields = ['address', 'api_path', 'protocol', 'api_token'];
    let inError = false;

    fields.forEach(function (field) {
      if (jQuery('input[name="' + field + '"]').val().trim() === '') {
        jQuery('#test-error').text('A required field is empty.').show();
        inError = true;
      }
    });

    if (inError) {
      return;
    }

    jQuery.ajax({
      url: webServiceUrl + '?object=centreon_openticket&action=testProvider',
      type: 'POST',
      contentType: 'application/json',
      dataType: 'json',
      data: JSON.stringify({
        service: 'Matrix42', // must match the provider name used in register.php
        address: jQuery('input[name="address"]').val(),
        api_path: jQuery('input[name="api_path"]').val(),
        protocol: jQuery('input[name="protocol"]').val(),
        api_token: jQuery('input[name="api_token"]').val(),
        timeout: jQuery('input[name="timeout"]').val(),
        peer_verify: jQuery('input[name="peer_verify"]').is(":checked"),
        ca_cert_path: jQuery('input[name="ca_cert_path"]').val(),
        proxy_address: jQuery('input[name="proxy_address"]').val(),
        proxy_port: jQuery('input[name="proxy_port"]').val(),
        proxy_username: jQuery('input[name="proxy_username"]').val(),
        proxy_password: jQuery('input[name="proxy_password"]').val()
      }),
      success: function () {
        jQuery('#test-ok').text('Connection is ok').show();
      },
      error: function (error) {
        jQuery('#test-error').text(error.responseJSON ? error.responseJSON : error.responseText).show();
      }
    });
  });
</script>
{/literal}
