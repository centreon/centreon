<tr class="list_lvl_1">
    <td class="ListColLvl1_name" colspan="2">
        <h4>{$header.common}</h4>
    </td>
</tr>
<tr class="list_one">
    <td class="FormRowField">
        {$form.url.label}
    </td>
    <td class="FormRowValue">
        {$form.url.html}
    </td>
</tr>
<tr class="list_two">
    <td class="FormRowField">
        {$form.message_confirm.label}
    </td>
    <td class="FormRowValue">
        {$form.message_confirm.html}
    </td>
</tr>
<tr class="list_one">
    <td class="FormRowField">
        {$form.ack.label}
    </td>
    <td class="FormRowValue">
        {$form.ack.html}
    </td>
</tr>
<tr class="list_two">
    <td class="FormRowField">
        {$form.schedule_check.label}
    </td>
    <td class="FormRowValue">
        {$form.schedule_check.html}
    </td>
</tr>
<tr class="list_one">
  <td class="FormRowField">
    {$form.peer_verify.label}
  </td>
  <td class="FormRowValue">
    {$form.peer_verify.html}
  </td>
</tr>
<tr id="row-ca-cert" class="list_two">
  <td class="FormRowField">
    <!-- <img class="helpTooltip" name="ca_cert_path">-->
    {$form.ca_cert_path.label}
  </td>
  <td class="FormRowValue">
    {$form.ca_cert_path.html}
  </td>
</tr>
<tr class="list_two">
    <td class="FormRowField">
        {$form.grouplist.label}
    </td>
    <td class="FormRowValue">
        {include file="file:$centreon_open_tickets_path/providers/Abstract/templates/clone.ihtml" cloneId="groupList" cloneSet=$form.groupList}
    </td>
</tr>
<tr class="list_two">
    <td class="FormRowField">
        {$form.customlist.label}
    </td>
    <td class="FormRowValue">
        {include file="file:$centreon_open_tickets_path/providers/Abstract/templates/clone.ihtml" cloneId="customList" cloneSet=$form.customList}
    </td>
</tr>
<tr class="list_one">
    <td class="FormRowField">
        {$form.bodylist.label}
    </td>
    <td class="FormRowValue">
        {include file="file:$centreon_open_tickets_path/providers/Abstract/templates/clone.ihtml" cloneId="bodyList" cloneSet=$form.bodyList}
    </td>
</tr>
{if $form.close_ticket_enable.enable}
<tr class="list_lvl_1">
    <td class="ListColLvl1_name" colspan="2">
        <h4>{$header.close_ticket}</h4>
    </td>
</tr>
<tr class="list_one">
    <td class="FormRowField">
        {$form.close_ticket_enable.label}
    </td>
    <td class="FormRowValue">
        {$form.close_ticket_enable.html}
    </td>
</tr>
<tr class="list_two">
    <td class="FormRowField">
        {$form.error_close_centreon.label}
    </td>
    <td class="FormRowValue">
        {$form.error_close_centreon.html}
    </td>
</tr>
{/if}
<tr style="display:none">
<td colspan="2">
{$helptext}
</td>
</tr>
{literal}
<script>
    jQuery(function () {
        const peerVerifyCheckbox = jQuery('input[name="peer_verify"]');
        const caCertRow = jQuery('#row-ca-cert');

        function toggleCaCertRow() {
            if (peerVerifyCheckbox.is(':checked')) {
                caCertRow.show();
            } else {
                caCertRow.find('input[name="ca_cert_path"]').val("")
                caCertRow.hide();
            }
        }

        // Run on page load
        toggleCaCertRow();

        // Run when checkbox is toggled
        peerVerifyCheckbox.on('change', toggleCaCertRow);
        if (typeof centreonTooltip !== "undefined") {
            centreonTooltip.render();
        }
    });
</script>
{/literal}
