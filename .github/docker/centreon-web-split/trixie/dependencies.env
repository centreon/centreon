# Cross-repository inputs of the split central images, read by
# .github/workflows/docker-central.yml (KEY=value only, no shell expansion,
# values limited to [A-Za-z0-9._-], except AUTODISCO_DIGEST).
#
# - COLLECT_REF: centreon-collect ref checked out as the `perl-libs` named
#   build context (perl-libs/lib), same convention as centreon-trapd.
# - *_TAG: tags of images published on the internal registry by the
#   centreon-collect (gorgone, broker, engine) and centreon-modules
#   (autodisco) CI. AUTODISCO_TAG and ENGINE_TAG feed the AUTODISCO_IMAGE and
#   ENGINE_IMAGE build-args; GORGONE_TAG, BROKER_TAG and ENGINE_TAG pick the
#   images of the compose smoke test.
# - AUTODISCO_DIGEST (optional, sha256:<64 hex>): pins the autodiscovery
#   image to tag@digest.
#
# A PR that depends on an unmerged change of another repository points the
# matching value at that change's branch tag (sanitized branch name).
COLLECT_REF=MON-213839-broker-rrd-tcp-logger
GORGONE_TAG=MON-214478-gorgone-legacycmd-fast-result-relay
BROKER_TAG=MON-214281-gorgone-pullwss-retry-backoff
ENGINE_TAG=MON-214281-gorgone-pullwss-retry-backoff
AUTODISCO_TAG=MON-216208-poc-autodiscovery-without-gorgone-on-the-light-central
AUTODISCO_DIGEST=sha256:5f21fcb92a9a14f8c90d68817d165e4c16d15813954571fcd407e47c362f67fa
