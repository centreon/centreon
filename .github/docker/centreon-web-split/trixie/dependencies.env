# Cross-repository inputs of the split central images, read by
# .github/workflows/docker-central.yml (KEY=value only, no shell expansion,
# values limited to [A-Za-z0-9._-]).
#
# - COLLECT_REF: centreon-collect ref checked out as the `perl-libs` named
#   build context (perl-libs/lib), same convention as centreon-trapd.
# - *_TAG: tags of images published on the internal registry by the
#   centreon-collect (gorgone, broker, engine), centreon-modules (autodisco)
#   and centreon (trapd) CI. AUTODISCO_TAG feeds the AUTODISCO_IMAGE build-arg;
#   the others are only used by the compose smoke test.
#
# A PR that depends on an unmerged change of another repository points the
# matching value at that change's branch tag (sanitized branch name).
COLLECT_REF=MON-213839-broker-rrd-tcp-logger
GORGONE_TAG=MON-213839-broker-rrd-tcp-logger
BROKER_TAG=MON-213839-broker-rrd-tcp-logger
ENGINE_TAG=MON-213839-broker-rrd-tcp-logger
AUTODISCO_TAG=MON-213817-autodisco-save-worker
TRAPD_TAG=develop
