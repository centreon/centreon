MYSQL_IMAGE=bitnamilegacy/mariadb:10.11
OPENID_IMAGE=docker.centreon.com/centreon/keycloak:24.07
SAML_IMAGE=docker.centreon.com/centreon/keycloak:24.07

MYSQL_ROOT_PASSWORD=centreon
MYSQL_USER=centreon
MYSQL_PASSWORD=centreon
MYSQL_EXTRA_FLAGS="--skip-name-resolve --innodb-flush-method=nosync --innodb-log-file-size=32M --secure-file-priv="

MARIADB_ROOT_PASSWORD=centreon
MARIADB_USER=centreon
MARIADB_PASSWORD=centreon
MARIADB_EXTRA_FLAGS="--skip-name-resolve --innodb-flush-method=nosync --innodb-log-file-size=32M --secure-file-priv="

# HTTP / HTTPS mode (see README.md). Default is HTTP. To enable HTTPS (web TLS only), load the
# overlay alongside the base file — either with -f flags or by setting COMPOSE_FILE.
# COMPOSE_FILE=.github/docker/docker-compose.yml:.github/docker/docker-compose.tls.yml
# CERTGEN_IMAGE=centreon-certgen:local

# CENTREON_WEB_OS picks which OS-specific entrypoint scripts to bind-mount
# (must match WEB_IMAGE's OS). Valid: alma9 (default), alma8, bookworm.
# CENTREON_WEB_OS=alma9
