# HTTP / HTTPS mode (see README.md). Default is HTTP. To enable HTTPS, load the
# overlay alongside the base file — either with -f flags or by setting COMPOSE_FILE.
# COMPOSE_FILE=.github/docker/docker-compose.yml:.github/docker/docker-compose.tls.yml
# CERTGEN_IMAGE=centreon-certgen:local

# CENTREON_WEB_OS picks which OS-specific entrypoint scripts to bind-mount
# (must match WEB_IMAGE's OS). Valid: alma9 (default), alma10, trixie.
# CENTREON_WEB_OS=alma9
