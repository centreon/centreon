# Image pins of the gorgone-less PoC stack (MON-215451). KEY=value only,
# read by gls-e2e.sh and the gls-poc-e2e workflow. REGISTRY is overridden by
# the workflow (vars.DOCKER_INTERNAL_REGISTRY_URL).
#
# Step 0: the Containerized Central PoC tags (no gorgone-less code yet).
# Swap ENGINE_TAG/BROKER_TAG to the collect-protocol branch tag and WEB_TAG to
# the web-sender branch tag once their images are built.
REGISTRY=docker.centreon.com/centreon
WEB_TAG=MON-214629-process-hosts-in-batches-to-bound-php-memory
ENGINE_TAG=MON-214281-gorgone-pullwss-retry-backoff
BROKER_TAG=MON-214281-gorgone-pullwss-retry-backoff
# Criteria steps gate the workflow only when true (report-only until the gls images exist).
GATE_CRITERIA=false
