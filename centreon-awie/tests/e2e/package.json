{
    "name": "centreon-awie",
    "version": "24.10.0",
    "description": "Cypress end-to-end tests for centreon-awie",
    "scripts": {
      "update:deps": "pnpx npm-check-updates -i --format group",
      "cypress:run": "cross-env TESTCONTAINERS_RYUK_DISABLED=true cypress run --env tags='not @ignore' --config-file cypress.config.ts --browser=electron --e2e",
      "cypress:open": "cross-env TESTCONTAINERS_RYUK_DISABLED=true cypress open --config-file cypress.dev.config.ts --browser=electron --e2e",
      "cypress:ci": "cross-env TESTCONTAINERS_RYUK_DISABLED=true cypress run --e2e --browser=electron",
      "cypress:install": "cypress install",
      "lint": "biome check ./features",
      "lint:fix": "pnpm lint --fix",
      "lint:ci": "biome ci ./features --error-on-warnings",
      "gherkinlint": "pnpm gherkin-lint -c ../../../.github/actions/gherkin-lint/.gherkin-lintrc ./features/"
    },
    "devDependencies": {
      "@badeball/cypress-cucumber-preprocessor": "^20.1.0",
      "@bahmutov/cypress-esbuild-preprocessor": "^2.2.1",
      "@biomejs/biome": "1.9.4",
      "@centreon/js-config": "24.12.1",
      "@cypress/webpack-preprocessor": "^6.0.2",
      "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
      "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
      "@swc/core": "^1.6.5",
      "@types/cypress": "^1.1.3",
      "@types/cypress-cucumber-preprocessor": "^4.0.5",
      "@types/dockerode": "^3.3.29",
      "@types/node": "^20.14.9",
      "cross-env": "^7.0.3",
      "cypress": "~13.12.0",
      "cypress-cucumber-preprocessor": "^4.3.1",
      "cypress-multi-reporters": "^1.6.4",
      "cypress-on-fix": "^1.0.3",
      "cypress-real-events": "^1.13.0",
      "cypress-terminal-report": "^6.1.0",
      "cypress-wait-until": "^3.0.1",
      "dotenv": "^16.4.5",
      "gherkin-lint": "^4.2.4",
      "mochawesome": "^7.1.3",
      "mysql2": "^3.10.1",
      "path": "^0.12.7",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "shell-exec": "^1.1.2",
      "swc-loader": "^0.2.6",
      "tar-fs": "^3.0.5",
      "testcontainers": "^10.10.0",
      "typescript": "^5.5.2",
      "webpack": "^5.92.1"
    },
    "cypress-cucumber-preprocessor": {
      "filterSpecs": false,
      "nonGlobalStepDefinitions": true,
      "omitFiltered": true,
      "json": {
        "enabled": true,
        "output": "results/cucumber-logs/report.json"
      },
      "pretty": {
        "enabled": true
      }
    }
  }
