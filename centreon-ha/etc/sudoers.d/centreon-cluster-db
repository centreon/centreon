## BEGIN: CENTREON SUDO

User_Alias      MYSQL=%mysql
Defaults:MYSQL !requiretty

## BEGIN HA SPECIFIC HACK
## Mysql user stop and start cmd for clustering

MYSQL   ALL = NOPASSWD: /usr/bin/systemctl start mariadb
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl restart mariadb
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl stop mariadb
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl start mysqld
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl restart mysqld
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl stop mysqld
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl start mysql
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl restart mysql
MYSQL   ALL = NOPASSWD: /usr/bin/systemctl stop mysql

## END: CENTREON SUDO
